



@model GSTSMSLibrary.AccountManager.AccountManager

@{
    ViewBag.Title = "Update Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<link href="~/Content/modules/fontawesome/css/fontawesome.min.css" rel="stylesheet" />


<link href="~/Content/css/ProfileUpdate.css" rel="stylesheet" />


<link href="~/Content/modules/izitoast/css/iziToast.min.css" rel="stylesheet" />


<div class="profile-cardbody">
    <div class="profile-card scroll-hidden">

        @{
            var profilePic = Session["ProfilePhoto"] != null && !string.IsNullOrEmpty(Session["ProfilePhoto"].ToString())
                ? Url.Content(Session["ProfilePhoto"].ToString())
                : Url.Content("~/Content/img/avatar/avatar-3.png");
        }
        <div class="cover-image">
            <div class="profile-pic">
                <img src="@profilePic" alt="Profile Picture" id="profileImage" />
            </div>
        </div>

        <div class="avatar-menu">
            <label for="photoFile">
                <i class="fa fa-upload"></i> Upload Photo
            </label>
            <button type="button" onclick="openAvatarSelection()">
                <i class="fa fa-user-circle"></i> Choose Avatar
            </button>
            <button type="button" onclick="removePhoto()">
                <i class="fa fa-trash"></i> Remove Photo
            </button>

            <!-- name आणि id एकसारखे -->
            <input type="file" id="photoFile" name="photoFile" style="display: none;" />
        </div>


        <div class="form-section">

            <!-- Profile Photo Update Form -->
            @using (Html.BeginForm("UpdateProfilePhoto", "AccountManager", FormMethod.Post, new { enctype = "multipart/form-data", id = "profileForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="stylish-line"></div>

                <div class="form-group">
                    <i class="fa fa-user input-icon" style="color: #023047;"></i>
                    @Html.TextBoxFor(m => m.StaffName, new { @class = "form-control", placeholder = "Full Name", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    <i class="fa fa-envelope input-icon" style="color: #023047;"></i>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email Address", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    <i class="fa fa-lock input-icon" style="color: #023047;"></i>
                    <input type="password"
                           id="CurrentPassword"
                           class="form-control"
                           name="CurrentPassword"
                           value="@Session["Password"]"
                           readonly="readonly" />
                    <i class="fa fa-eye toggle-password" style="color: #023047;" onclick="togglePassword()"></i>
                </div>

                <div class="stylish-line1" style="color: gray; height: 1px; background: linear-gradient(#4a4e69,#bfc0c0); margin:50px;"></div>
                <div class="btn-row" style="margin-top:20px;">
                    <button type="button" class="btn-primary-custom" onclick="updateProfileWithPhoto()">
                        <i class="fa fa-save"></i> Update Profile
                    </button>
                    <button type="button" onclick="sendPasswordChange()" class="btn-secondary-custom">
                        <i class="fa fa-key"></i> Send Password Change Request
                    </button>
                </div>
            }
        </div>
    </div>


    <div id="avatarModal" style="display:none;">
        <div style="
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;">

            <div style="
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);">

                <h3 style="text-align:center; margin-bottom: 15px;">Select an Avatar</h3>

                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;">
                    @for (int i = 1; i <= 8; i++)
                    {
                        <img src="@Url.Content($"~/Content/img/ProfileImagesDOC/avatar-{i}.png")"
                             alt="Avatar @i"
                             style="width: 80px; height: 80px; border-radius: 50%; cursor: pointer; border: 2px solid transparent;"
                             onclick="selectAvatar('@Url.Content($"~/Content/img/ProfileImagesDOC/avatar-{i}.png")')" />

                    }
                </div>


                <div style="text-align:center; margin-top: 15px;">
                    <button onclick="closeAvatarSelection()" style="
                    padding: 8px 16px;
                    background: #ccc;
                    border: none;
                    border-radius: 6px;
                    cursor: pointer;">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
    </div>
    <script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/modules/fontawesome/js/fontawesome.min.js"></script>

    <script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>

    <script>
    // Global variable for selected avatar
    var selectedAvatar = null;

    // Show/Hide Password
    function togglePassword() {
        const passwordField = document.getElementById("CurrentPassword");
        const icon = document.querySelector(".toggle-password");

        if (passwordField.type === "password") {
            passwordField.type = "text";
            icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
            passwordField.type = "password";
            icon.classList.replace("fa-eye-slash", "fa-eye");
        }
        passwordField.setAttribute("readonly", "readonly");
    }

    // Profile Image Preview (for uploaded file) with size validation
    document.getElementById('photoFile').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            if (file.size > 5 * 1024 * 1024) { // 5 MB check
                iziToast.error({
                    title: 'Error',
                    message: 'File size must be less than 5 MB.',
                    position: 'topRight'
                });
                e.target.value = ""; // reset file input
                return;
            }

            const reader = new FileReader();
            reader.onload = function (event) {
                document.getElementById('profileImage').src = event.target.result;
                selectedAvatar = null; // जर file निवडलं तर avatar reset कर
            }
            reader.readAsDataURL(file);
        }
    });

    // Profile Photo Upload via AJAX (file OR avatar)
    function updateProfileWithPhoto() {
        var fileInput = document.getElementById("photoFile");
        var formData = new FormData();

        // File निवडला असेल तर
        if (fileInput.files.length > 0) {
            formData.append("photoFile", fileInput.files[0]);
        }
        // Avatar निवडला असेल तर
        else if (selectedAvatar) {
            formData.append("avatarPath", selectedAvatar);
        }
        else {
            swal({
                title: "Error",
                text: "Please select a photo or choose an avatar.",
                icon: "error"
            });
            return;
        }

        // AntiForgeryToken
        var token = $('input[name="__RequestVerificationToken"]').val();
        formData.append("__RequestVerificationToken", token);

        $.ajax({
            url: '@Url.Action("UpdateProfilePhoto", "AccountManager")',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function () {
                swal({
                    title: "Profile Update!",
                    text: "Profile updated successfully!",
                    icon: "success",
                    timer: 3000,
                    buttons: false
                });
                setTimeout(function () {
                    window.location.href = '@Url.Action("Dashboard", "AccountManager")';
                }, 3000);
            },
            error: function (xhr) {
                swal({
                    title: "Error!",
                    text: "Something went wrong: " + xhr.responseText,
                    icon: "error"
                });
            }
        });
    }

    // Send Password Change Request
    function sendPasswordChange() {
        var token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            type: 'POST',
            url: '@Url.Action("ChangePassword", "AccountManager")',
            data: { __RequestVerificationToken: token },
            success: function () {
                swal({
                    title: "Password Change Request Sent!",
                    text: "Your request was submitted successfully.",
                    icon: "success",
                    timer: 3000,
                    buttons: false
                });
                setTimeout(function () {
                    window.location.href = '@Url.Action("Dashboard", "AccountManager")';
                }, 3000);
            },
            error: function () {
                swal({
                    title: "Error!",
                    text: "Something went wrong while sending request.",
                    icon: "error",
                    timer: 3000,
                    buttons: false
                });
            }
        });
    }

    // Remove Photo (reset to default avatar)
 // Remove Photo (reset to default avatar)
function removePhoto() {
    // Default avatar path
    var defaultAvatarPath = '@Url.Content("~/Content/img/avatar/avatar-3.png")';

    // Update preview
    document.getElementById('profileImage').src = defaultAvatarPath;

    // Clear file input
    document.getElementById("photoFile").value = "";

    // Set selected avatar as default
    selectedAvatar = defaultAvatarPath;

    // Trigger update (optional – only if you want to save immediately after remove)
    updateProfileWithPhoto();
}

    // Avatar selection
    function openAvatarSelection() {
        document.getElementById('avatarModal').style.display = 'block';
    }
    function closeAvatarSelection() {
        document.getElementById('avatarModal').style.display = 'none';
    }
    function selectAvatar(imagePath) {
        document.getElementById('profileImage').src = imagePath;
        selectedAvatar = imagePath;
        document.getElementById("photoFile").value = ""; // file reset
        closeAvatarSelection();
    }
    </script>

