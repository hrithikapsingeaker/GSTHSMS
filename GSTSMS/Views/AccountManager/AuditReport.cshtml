@{
    ViewBag.Title = "Audit Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/AuditReport.css" rel="stylesheet" />
<!-- 🔹 Required CSS -->
<link href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" rel="stylesheet" />
<!-- CSS Files -->
<link rel="stylesheet" href="~/Content/modules/fontawesome/css/all.min.css">

<!-- Bootstrap Datepicker CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css" rel="stylesheet" />


<div class="maincontaint ">

    <div class="loader-overlay" id="listLoader">
        <div class="loader"></div>
    </div>

    @*<div class="section-header d-flex justify-content-center align-items-center" style="height: 100px; margin-top: 0 !important;">
            <h1 class="h3 h2-md text-center">Audit Report</h1>
        </div>*@

    <div class="section-body">
        <!-- 🔹 Summary Cards -->
        <div class="row">
            <!-- 🔹 Total Members -->
            <div class="col-12 col-sm-6 col-md-6 col-lg-4 mb-4">
                <div class="custom-card-stat" onclick="loadAllMembers()" ondblclick="return false;">
                    <div class="icon-box gradient-blue">
                        <i class="fas fa-users fa-1x"></i>
                    </div>
                    <div class="text-box">
                        <h4>Total Members</h4>
                        <p>@ViewBag.TotalMembers</p>
                    </div>
                </div>
            </div>

            <!-- 🔹 Total Workers -->
            <div class="col-12 col-sm-6 col-md-6 col-lg-4 mb-4">
                <div class="custom-card-stat" onclick="loadAllWorkers()" ondblclick="return false;">
                    <div class="icon-box gradient-cyan">
                        <i class="fas fa-user-cog fa-1x"></i>
                    </div>
                    <div class="text-box">
                        <h4>Total Workers</h4>
                        <p>@ViewBag.TotalWorkers</p>
                    </div>
                </div>
            </div>

            <!-- 🔹 Total Vendors -->
            <div class="col-12 col-sm-6 col-md-6 col-lg-4 mb-4">
                <div class="custom-card-stat" onclick="loadAllVendors()" ondblclick="return false;">
                    <div class="icon-box gradient-orange">
                        <i class="fas fa-toolbox fa-1x"></i>
                    </div>
                    <div class="text-box">
                        <h4>Total Vendors</h4>
                        <p>@ViewBag.TotalVendor</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔹 Charts Section -->
        <div class="row">
            <!-- 🔹 Income vs Expense -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header  text-white d-flex justify-content-between align-items-center py-2 px-3" ondblclick="return false;" style="background-color: #6c757d;">
                        <h5 class="mb-0">Income vs Expense (Monthly)</h5>
                        <div>
                            <button class="btn btn-dark btn-sm" id="prevYear"><i class="fas fa-arrow-left"></i></button>
                            <span class="mx-2 font-weight-bold" id="yearDisplay"></span>
                            <button class="btn btn-dark btn-sm" id="nextYear"><i class="fas fa-arrow-right"></i></button>
                            <button class="btn btn-info btn-sm no-over" id="viewAllIncomeExpenseDetails">
                                See Details
                            </button>
                        </div>
                    </div>
                    <div class="card-body px-3 py-2">
                        <div id="lineChart" style="height: 300px;"></div>
                    </div>
                </div>
            </div>

            <!-- 🔹 Worker Salary Chart -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header  text-white d-flex justify-content-between align-items-center py-2 px-3" ondblclick="return false;" style="background-color: #6c757d;">
                        <h5 class="mb-0">Total Worker Salary </h5>
                        <div>
                            <button class="btn btn-dark btn-sm" id="prevWorkerYear"><i class="fas fa-arrow-left"></i></button>
                            <span class="mx-2 font-weight-bold" id="workerYearDisplay"></span>
                            <button class="btn btn-dark btn-sm" id="nextWorkerYear"><i class="fas fa-arrow-right"></i></button>
                            <button class="btn btn-info btn-sm no-over " onclick="loadWorkerSalaryListFull()">See Details</button>
                        </div>
                    </div>
                    <div class="card-body px-3 py-2">
                        <div id="workerMonthlyChart" style="height: 300px;"></div>
                    </div>
                </div>
            </div>



            <!-- 🔹 Monthly Expense Chart -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card h-100 flex-fill">
                    <div class="card-header  text-white d-flex justify-content-between align-items-center py-2 px-3" ondblclick="return false;" style="background-color: #6c757d;">
                        <h5 class="mb-0">Monthly Direct vs Indirect Expense</h5>
                        <div class="d-flex align-items-center flex-nowrap w-100" style="gap: 0.25rem;">
                            <div id="marseedetailstwo" class="d-flex align-items-center flex-nowrap w-100" style="gap: 0.25rem;">
                                <label class="text-white mb-0 mr-1">Select Month:</label>
                                <input type="text" id="monthPicker" class="form-control form-control-sm mr-1" style="max-width: 90px;" placeholder="MM/YYYY" readonly />
                            </div>
                            <button class="btn btn-info btn-sm no-over custom-radius ml-auto" onclick="openAllExpenseModal()">See Details</button>
                        </div>
                    </div>
                    <div class="card-body px-3 py-2">
                        <div id="expenseChart" style="height: 300px;"></div>
                    </div>
                </div>
            </div>



            <div class="modal fade" id="maintenanceModal" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="maintenanceModalTitle"></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="height:30px">Member Name</th>
                                        <th style="height:30px">Flat No</th>
                                        <th style="height:30px">Amount</th>
                                        <th style="height:30px">Payment Status</th>
                                    </tr>
                                </thead>
                                <tbody id="maintenanceTableBody"></tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-end mt-3">
                            <div id="maintenancePaginationControls" class="d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>
                </div>
            </div>





            <!-- 🔹 Expanded Event Budget Chart (Full Width) -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header  text-white d-flex justify-content-between align-items-center py-2 px-3" ondblclick="return false;" style="background-color: #6c757d;">
                        <h5 class="mb-0">Event Budget vs Actual (Monthly)</h5>
                        <div class="d-flex align-items-center flex-nowrap" style="gap: 0.25rem;">
                            <div id="marseedetails" class="d-flex align-items-center flex-nowrap" style="gap: 0.25rem;">
                                <label class="text-white mb-0 mr-1" id="selectmonth">Select Month:</label>
                                <input type="text" id="budgetMonthPicker" class="form-control form-control-sm mr-2" style="max-width: 100px;" placeholder="MM/YYYY" readonly />
                            </div>
                            <button class="btn btn-info btn-sm no-over" id="viewAllBudgetDetails">See Details</button>
                        </div>
                    </div>
                    <div class="card-body px-3 py-2">
                        <div id="container" style="height: 300px;"></div>
                    </div>
                </div>
            </div>






        </div>
    </div>
</div>

<!-- 🔹 All Modals -->
<div class="modal fade" id="memberModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" id="memberModalContent"></div>
    </div>
</div>

<div class="modal fade" id="workerModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" id="workerModalContent"></div>
    </div>
</div>

<div class="modal fade" id="vendorModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" id="vendorModalContent"></div>
    </div>
</div>

<div class="modal fade" id="workerSalaryModal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" id="workerSalaryModalContent"></div>
    </div>
</div>

<div class="modal fade" id="expenseDetailsModal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-2"></div>
        </div>
    </div>
</div>

<!-- All Expense Modal -->
<div class="modal fade" id="expenceAllListModal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" id="expenceAllListModalContent">
            <!-- इथे Partial View load होईल -->
        </div>
    </div>
</div>

<!-- Income vs Expense Modal -->
<div class="modal fade" id="incomeExpenseDetailsModal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <!-- Modal Header with Close Button -->
            <div class="modal-header bg-light text-dark p-2" style="text-align:center!important">
                <h5 class="modal-title">Income-Expense Details</h5>
                <button type="button" class="btn btn-danger btn-sm ifsc-close-btn" style="line-height: 18px;" onclick="closeIncomeExpenseModal()">
                    <i class="fa fa-times text-white"></i>
                </button>
            </div>
            <div class="modal-body" id="incomeExpenseModalContent">
                <div class="text-center"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Event Budget Modal -->
<div class="modal fade" id="budgetDetailsModal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <!-- Modal Header with Close Button -->
            <div class="modal-header bg-light text-dark p-2" style="text-align:center!important">
                <h5 class="modal-title">Event Budget Details</h5>
                <button type="button" class="btn btn-danger btn-sm ifsc-close-btn" style="line-height: 18px;" onclick="closeBudgetModal()">
                    <i class="fa fa-times text-white"></i>
                </button>
            </div>
            <div class="modal-body" id="budgetModalContent">
                <div class="text-center"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
            </div>
        </div>
    </div>
</div>




<style>
    #marseedetails {
        margin-left: 100px;
    }

    #marseedetailstwo {
        margin-left: 100px;
    }

    .card {
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
    }

    .form-select-sm {
        border: 1px solid #ced4da;
    }

    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7); /* Semi-transparent background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader {
        width: 50px;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 8px solid;
        border-color: white transparent; /* White spinner */
        animation: spin 1s infinite linear;
    }

    @@keyframes spin {
        to {
            transform: rotate(0.5turn);
        }
    }
</style>


<!--<script src="~/Scripts/jquery-3.7.0.min.js"></script>-->
<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>





<script src="~/Content/modules/popper.js"></script>
<!-- Bootstrap JS -->

<script src="~/Content/modules/bootstrap/js/bootstrap.bundle.min.js"></script>
<!-- Bootstrap Datepicker JS -->

<script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
<!-- Highcharts Core -->
<script src="https://code.highcharts.com/highcharts.js"></script>

<!-- Highcharts Exporting -->
<script src="https://code.highcharts.com/modules/exporting.js"></script>

<!-- Highcharts Accessibility (optional – warning टाळण्यासाठी) -->
<script src="https://code.highcharts.com/modules/accessibility.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// Global variables for charts
let workerSalaryYear = new Date().getFullYear();
let currentMonth = new Date().getMonth() + 1;
let currentYear = new Date().getFullYear();
let incomeExpenseYear = new Date().getFullYear();
    const defaultMonth = new Date().getMonth() + 1; // current month (1–12)
    const defaultYear = new Date().getFullYear();   // current year

// Member, Worker, Vendor Functions
    function loadAllMembers() {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("MemberListNK", "AccountManager")',
        type: 'GET',
        success: function (html) {
            hideLoader(); // 🔹 Hide loader on success

            $('#memberModalContent').html(html);
            $("#memberModal").modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
            $('#memberModal').off('click.dismiss.bs.modal');
        }
    });
}

    function loadAllWorkers() {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("WorkerListNK", "AccountManager")',
        type: 'GET',
        success: function (html) {
            hideLoader(); // 🔹 Hide loader on success

            $('#workerModalContent').html(html);
            $('#workerModal').modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
            $('#workerModal').off('click.dismiss.bs.modal');
        }
    });
}

    function loadAllVendors() {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("VendorListNK", "AccountManager")',
        type: 'GET',
        success: function (html) {
            hideLoader(); // 🔹 Hide loader on success

            $('#vendorModalContent').html(html);
            $('#vendorModal').modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
            $('#vendorModal').off('click.dismiss.bs.modal');
        }
    });
}

// Chart and Expense Functions
function getMonthName(monthNumber) {
    const months = ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"];
    return months[parseInt(monthNumber) - 1];
}

    function loadExpenseChart(month, year) {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("ShowPieChartForExpenceNK", "AccountManager")',
        type: 'POST',
        data: { month: month, year: year },
        success: function (data) {
            hideLoader(); // 🔹 Hide loader on success

            if (!data || data.length === 0) {
                $('#expenseChart').html('<div class="text-danger text-center mt-3">No expense data found for selected month.</div>');
                return;
            }

            Highcharts.chart('expenseChart', {
                chart: { type: 'pie' },
                title: { text: 'Expense Distribution - ' + getMonthName(month) + ' ' + year },
                tooltip: {
                    pointFormat: '<b>{point.name}</b>: {point.y:.2f} ({point.percentage:.1f}%)'
                },
plotOptions: {
    bar: {
        dataLabels: {
            enabled: false   // 🔴 turn off values on bars
        },
        point: {
            events: {
                click: function () {
                    showLoader();
                    $.ajax({
                        url: '@Url.Action("DistributionEventDetails", "AccountManager")',
                        type: 'GET',
                        success: function (html) {
                            hideLoader();
                            $('#budgetModalContent').html(html);
                            $('#budgetDetailsModal').modal('show');
                        },
                        error: function (xhr, status, error) {
                            console.error("Error loading distribution event details:", status, error);
                            $('#budgetModalContent').html(
                                '<div class="p-3 text-center">' +
                                '<i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>' +
                                '<h4>Unable to Load Distribution Details</h4>' +
                                '<p>The requested content could not be found (404 Error).</p>' +
                                '</div>'
                            );
                            $('#budgetDetailsModal').modal('show');
                        }
                    });
                }
            }
        }
    }
},
                exporting: { enabled: false },
                credits: { enabled: false },
                series: [{
                    name: 'Expense',
                    colorByPoint: true,
                    data: data
                }]
            });
        },
        error: function() {
            $('#expenseChart').html('<div class="text-danger text-center mt-3">Failed to load chart data.</div>');
        }
    });
}

    function onPieSliceClick(expenseTypeName, month, year) {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        type: "POST",
        url: '@Url.Action("GetExpenseDetailsByTypeNK", "AccountManager")',
        data: {
            expenseTypeName: expenseTypeName,
            month: month,
            year: year
        },
        success: function (response) {
            hideLoader(); // 🔹 Hide loader on success

            $('#expenseDetailsModal .modal-body').html(response);
            $('#expenseDetailsModal').modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
            $('#expenseDetailsModal').off('click.dismiss.bs.modal');
        },
        error: function(xhr, status, error) {
            alert("Error loading details: " + xhr.responseText);
        }
    });
}

// Worker Salary Chart
function loadWorkerSalaryChart(year) {
    $('#workerYearDisplay').text(year);
    showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("GetWorkerSalaryTotalPerMonthNK", "AccountManager")',
        type: 'GET',
        data: { year: year },
        success: function (data) {
            hideLoader(); // 🔹 Hide loader on success

            const allMonthsShort = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const allMonthsFull = ["January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"];

            if (!data || data.length === 0) {
                Highcharts.chart('workerMonthlyChart', {
                    chart: { type: 'column' },
                    title: { text: 'Total Worker Salary Paid in ' + year },
                    xAxis: { categories: allMonthsShort },
                    yAxis: {
                        type: 'linear',
                        min: 0,
                        title: { text: 'Total Amount (₹)' },
                        tickInterval: 10000,
                        labels: {
                            formatter: function() {
                                return '₹' + (this.value / 1000) + 'K';
                            }
                        }
                    },
                    series: [{ name: 'Total Salary', data: Array(12).fill(0) }],
                    subtitle: { text: 'No data available for this year.', style: { color: '#ff0000', fontWeight: 'bold' } },
                    credits: { enabled: false },
                    exporting: { enabled: false }
                });
                return;
            }

            const dataMap = {};
            data.forEach(item => {
                dataMap[item.Month] = item.Amount;
            });

            const amounts = allMonthsFull.map(month => dataMap[month] || 0);
            const maxValue = Math.max(...amounts);

            Highcharts.chart('workerMonthlyChart', {
                chart: { type: 'column' },
                title: { text: 'Total Worker Salary in ' + year },
                xAxis: { categories: allMonthsShort },
                yAxis: {
                    type: 'linear',
                    min: 0,
                    max: Math.ceil(maxValue / 10000) * 10000,
                    tickInterval: 10000,
                    title: { text: ' Amount (₹)' },
                    labels: {
                        formatter: function() {
                            return '₹' + (this.value / 1000) + 'K';
                        }
                    }
                },
                tooltip: {
                    pointFormat: '<b>₹{point.y}</b>'
                    // ✅ Hover वर actual value दिसेल
                },
                plotOptions: {
                    series: {
                        dataLabels: {
                            enabled: false // ✅ Column वर काही value दिसणार नाही
                        }
                    }
                },
                credits: { enabled: false },
                exporting: { enabled: false },
                series: [{
                    name: 'Salary',
                    data: amounts,
                    point: {
                        events: {
                            click: function() {
                                const monthMap = {
                                    "Jan": 1, "Feb": 2, "Mar": 3, "Apr": 4,
                                    "May": 5, "Jun": 6, "Jul": 7, "Aug": 8,
                                    "Sep": 9, "Oct": 10, "Nov": 11, "Dec": 12
                                };
                                let monthNumber = monthMap[this.category];
                                showLoader();

                                $.ajax({
                                    url: '@Url.Action("GetWorkerSalaryListByMonthNK", "AccountManager")',
                                    type: 'POST',
                                    data: { month: monthNumber, year: year },
                                    success: function (html) {
                                        hideLoader();
                                        $('#workerSalaryModalContent').html(html);
                                        $('#workerSalaryModal').modal({ backdrop: 'static', keyboard: false }).modal('show');
                                    }
                                });
                            }
                        }
                    }
                }]
            });
        }
    });
}

// Worker Salary List Full
    function loadWorkerSalaryListFull() {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("ShowWorkerSalaryListALLNK", "AccountManager")',
        type: 'GET',
        data: { year: incomeExpenseYear },
        success: function (html) {
            hideLoader(); // 🔹 Hide loader on success

            $('#workerSalaryModalContent').html(html);
            $('#workerSalaryModal').modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
            $('#workerSalaryModal').off('click.dismiss.bs.modal');
        },
        error: function() {
            alert("Could not load full worker salary list.");
        }
    });
}

// All Expense Modal
    function openAllExpenseModal() {
        showLoader(); // 🔹 Show loader before request

    $.ajax({
        url: '@Url.Action("AllExpenseListNK", "AccountManager")',
        type: 'GET',
        success: function (result) {
            hideLoader(); // 🔹 Hide loader on success

            $('#expenceAllListModalContent').html(result);
            $('#expenceAllListModal').modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
            $('#expenceAllListModal').off('click.dismiss.bs.modal');
        },
        error: function() {
            $('#expenceAllListModalContent').html('<div class="p-3 text-danger">Error loading expense list.</div>');
        }
    });
}

// Budget vs Actual Chart
    function loadBudgetChart(month, year) {
        showLoader(); // 🔹 Show loader before request

    $.get('@Url.Action("GetBudgetVsActualChartDataVD", "AccountManager")' + '?month=' + month + '&year=' + year)
        .done(function (group) {
            hideLoader(); // 🔹 Hide loader on success

            const categories = group.Events.map(e => e.EventName);
            const allocated = group.Events.map(e => e.AllocatedBudget);
            const actual = group.Events.map(e => e.ActualCost);

            Highcharts.chart('container', {
                chart: { type: 'bar' },
                title: { text: 'Budget vs Actual - ' + group.MonthLabel },
                xAxis: { categories: categories },
                yAxis: {
                    title: { text: 'Amount (₹)' },
                    labels: {
                        formatter: function() {
                            return '₹' + (this.value / 1000) + 'k';
                        }
                    }
                },
                tooltip: { pointFormat: '{series.name}: <b>₹{point.y}</b>' },
                plotOptions: {
                    bar: {
                        dataLabels: { enabled: false }, // ✅ Set to false to hide values on bars
                        point: {
                            events: {
                                click: function () {
                                    showLoader(); // 🔹 Show loader before request

                                    $.ajax({
                                        url: '@Url.Action("DistributionEventDetails", "AccountManager")',
                                        type: 'GET',
                                        success: function (html) {
                                            hideLoader(); // 🔹 Hide loader on success

                                            $('#budgetModalContent').html(html);
                                            $('#budgetDetailsModal').modal('show');
                                        },
                                        error: function(xhr, status, error) {
                                            console.error("Error loading distribution event details:", status, error);
                                            $('#budgetModalContent').html(
                                                '<div class="p-3 text-center">' +
                                                '<i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>' +
                                                '<h4>Unable to Load Distribution Details</h4>' +
                                                '<p>The requested content could not be found (404 Error).</p>' +
                                                '</div>'
                                            );
                                            $('#budgetDetailsModal').modal('show');
                                        }
                                    });
                                }
                            }
                        }
                    }
                },
                legend: { enabled: true },
                credits: { enabled: false },
                exporting: { enabled: false },
                series: [
                    { name: 'Allocated Budget', data: allocated },
                    { name: 'Actual Cost', data: actual }
                ]
            });
        })
        .fail(function() {
            alert("Error loading budget chart data.");
        });
}

// Income vs Expense Chart
function loadIncomeExpenseChart(year) {
    $('#yearDisplay').text(year);
    showLoader(); // 🔹 Show loader before request


    $.get('@Url.Action("GetMonthlyIncomeExpenseChartDataVD", "AccountManager")' + '?year=' + year, function (response) {
        hideLoader(); // 🔹 Hide loader on success

        if (response.error) {
            alert(response.message);
            return;
        }

        const data = response.data;
        const income = Array(12).fill(0);
        const expense = Array(12).fill(0);
        const categories = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
            'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        data.forEach(item => {
            income[item.MonthNumber - 1] = item.TotalIncome;
            expense[item.MonthNumber - 1] = item.TotalExpense;
        });

        Highcharts.chart('lineChart', {
            chart: { type: 'line' },
            title: { text: 'Monthly Income vs Expense - ' + year },
            xAxis: { categories: categories },
            yAxis: { title: { text: 'Amount (₹)' } },
            tooltip: { shared: true },
            credits: { enabled: false },
            exporting: { enabled: false },
plotOptions: {
    series: {
        cursor: 'pointer',
        point: {
            events: {
                click: function() {
                    const selectedMonth = this.index + 1;
                    const selectedYear = incomeExpenseYear;

                    showLoader();

                    // Build the URL with proper parameters
                    const url = '@Url.Action("IncomeExpenseDetailsVD", "AccountManager")' +
                               '?month=' + selectedMonth +
                               '&year=' + selectedYear +
                               '&allData=false';

                    $.get(url)
                        .done(function(html) {
                            hideLoader();
                            $('#incomeExpenseModalContent').html(html);
                            $('#incomeExpenseDetailsModal').modal('show');

                            // Update modal title
                            setTimeout(function() {
                                const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                                                   'July', 'August', 'September', 'October', 'November', 'December'];
                                $('#incomeExpenseDetailsModal .modal-title').text(
                                    'Income-Expense Details - ' + monthNames[selectedMonth - 1] + ' ' + selectedYear
                                );

                                // Hide date picker for specific month view
                                $('.daterange-btn').closest('div').hide();
                            }, 100);
                        })
                        .fail(function(xhr, status, error) {
                            hideLoader();
                            console.error("Error loading details:", error);
                            alert("Failed to load income/expense details.");
                        });
                }
            }
        }
    }
},            series: [
                { name: 'Income', data: income },
                { name: 'Expense', data: expense }
            ]
        });
    });
}

