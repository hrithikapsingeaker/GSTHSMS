// Initialize everything when document is ready
$(document).ready(function() {
    // Initialize datepickers
    $('#monthPicker').datepicker({
        format: "mm/yyyy",
        startView: "months",
        minViewMode: "months",
        autoclose: true
    }).on('changeDate', function(e) {
        const [month, year] = e.format('mm/yyyy').split('/');
        loadExpenseChart(month, year);
    });

    $('#budgetMonthPicker').datepicker({
        format: "mm/yyyy",
        startView: "months",
        minViewMode: "months",
        autoclose: true
    }).on('changeDate', function(e) {
        const [month, year] = e.format('mm/yyyy').split('/');
        loadBudgetChart(month, year);
    });

    // Set initial values for datepickers
    $('#monthPicker').datepicker('update', defaultMonth + '/' + defaultYear);
    $('#budgetMonthPicker').datepicker('update', currentMonth + '/' + currentYear);

    // Initialize modals with static behavior
    $('#budgetDetailsModal, #incomeExpenseDetailsModal').modal({
        backdrop: 'static',
        keyboard: false
    });

    // Initialize all charts
    loadExpenseChart(defaultMonth, defaultYear);
    loadWorkerSalaryChart(workerSalaryYear);
    loadBudgetChart(currentMonth, currentYear);
    loadIncomeExpenseChart(incomeExpenseYear);
    updateMonthDisplay();

    // Arrow button click events for Worker Salary
    $('#nextWorkerYear').click(() => {
        workerSalaryYear++;
        loadWorkerSalaryChart(workerSalaryYear);
    });

    $('#prevWorkerYear').click(() => {
        workerSalaryYear--;
        loadWorkerSalaryChart(workerSalaryYear);
    });

    // Navigation Controls for Income vs Expense
    // Navigation Controls for Income vs Expense - FIXED (with event handler cleanup)
    $('#nextYear').off('click').click(() => {
        incomeExpenseYear++;
        loadIncomeExpenseChart(incomeExpenseYear);
    });

    $('#prevYear').off('click').click(() => {
        // Prevent going below 2024
        if (incomeExpenseYear > 2024) {
            incomeExpenseYear--;
            loadIncomeExpenseChart(incomeExpenseYear);
        }
    });
    // Navigation Controls for Budget vs Actual
    $('#nextMonth').click(function() {
        currentMonth++;
        if (currentMonth > 12) {
            currentMonth = 1;
            currentYear++;
        }
        updateMonthDisplay();
        loadBudgetChart(currentMonth, currentYear);
        $('#budgetMonthPicker').datepicker('update', currentMonth + '/' + currentYear);
    });

    $('#prevMonth').click(function() {
        currentMonth--;
        if (currentMonth < 1) {
            currentMonth = 12;
            currentYear--;
        }
        updateMonthDisplay();
        loadBudgetChart(currentMonth, currentYear);
        $('#budgetMonthPicker').datepicker('update', currentMonth + '/' + currentYear);
    });

    // View All Details
$('#viewAllBudgetDetails').click(function () {
