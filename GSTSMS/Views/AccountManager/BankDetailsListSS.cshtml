                            $(win.document.head).append(style);
                        },

                        action: function (e, dt, button, config) {
                            const selectedCount = dt.rows(function (idx, data, node) {
                                const isChecked = $(node).find('input.row-checkbox').prop('checked');
                                const isActive = !$(node).hasClass('inactive-bank');
                                return isChecked && isActive;
                            }, { search: 'applied', page: 'all' }).count();

                            if (selectedCount === 0) {
                                iziToast.warning({
                                    title: 'Warning',
                                    message: 'Please select at least one active bank row to print.',
                                    position: 'topCenter'
                                });
                                return;
                            }

                            $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);
                            // ✅ After print, clear selections
