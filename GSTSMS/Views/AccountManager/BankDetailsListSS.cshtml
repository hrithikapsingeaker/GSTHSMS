                        },

                        customize: function (win) {
                            $(win.document.body).css('font-size', '10pt');

                            // ✅ Custom date format: DD-MM-YYYY hh:mm AM/PM
                            const now = new Date();
                            const day = now.getDate().toString().padStart(2, '0');
                            const month = (now.getMonth() + 1).toString().padStart(2, '0');
                            const year = now.getFullYear();
                            const hours = now.getHours() % 12 || 12;
                            const minutes = now.getMinutes().toString().padStart(2, '0');
                            const ampm = now.getHours() >= 12 ? 'PM' : 'AM';
                            const dateString = `${day}-${month}-${year}`;
                            const timeString = `${hours.toString().padStart(2, '0')}:${minutes} ${ampm}`;

                            // ✅ Add custom heading and timestamp
                            $(win.document.body).prepend(
                                '<div style="text-align:center; margin-bottom:10px;">' +
                                '<h6>GREEN VALLEY SOCIETY : Bank List</h6>' +
                                '<p>Generated on: ' + dateString + ' ' + timeString + '</p>' +
                                '</div>'
                            );

                            // ✅ Style the table
                            $(win.document.body).find('table')
                                .addClass('compact print-table')
                                .css({ fontSize: 'inherit', textAlign: 'center', margin: '0 auto', borderCollapse: 'collapse' });

                            $(win.document.body).find('th, td')
                                .css({ border: '1px solid black', padding: '5px' });

                            // ✅ Remove any duplicate "Bank List" heading from the table (e.g., caption or heading row)
                            $(win.document.body).find('caption').remove(); // If using <caption>
                            $(win.document.body).find('tr.print-hide').remove(); // If using extra heading row with class

                            // ✅ Additional print styling
                            const style = document.createElement('style');
                            style.type = 'text/css';
                            style.innerHTML = `
@@page { margin: 0; }
@@media print {
  caption, .print-hide {
    display: none !important;
  }
  html, body {
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
