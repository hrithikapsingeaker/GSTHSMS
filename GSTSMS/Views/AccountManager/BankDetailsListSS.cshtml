                    {
                        text: '<img src="/Content/img/icons8-refresh-50.png" alt="Refresh" style="height:28px;" title="Refresh Table" />',
                        className: 'export-buttons icon-only-btn',
                        action: function (e, dt, node, config) {
                            // ✅ Add rotation to refresh icon
                            const refreshIcon = $(node).find('img');
                            refreshIcon.addClass('rotate-refresh');
                            setTimeout(() => refreshIcon.removeClass('rotate-refresh'), 600);

                            // ✅ Preserve status toggle states
                            let toggleStates = {};
                            $('.status-toggle').each(function () {
                                let id = $(this).data('id');
                                toggleStates[id] = $(this).prop('checked');
                            });

                            // ✅ Clear search
                            dt.search('').columns().search('');

                            // ✅ Reset date filter
                            enableDateFilter = false;
                            $('#fromDate1').val('');
                            $('#toDate1').val('');
                            $('.daterange-btn').find('span').html('Choose Date');

                            // ✅ Clear selectAll checkbox
                            $('#selectAll').prop('checked', false);

                            // ✅ Clear all row-checkbox on current page
                            dt.rows().every(function () {
                                $(this.node()).find('.row-checkbox').prop('checked', false);
                            });

                            // ✅ Restore toggle switches
                            $('.status-toggle').each(function () {
                                let id = $(this).data('id');
                                if (toggleStates.hasOwnProperty(id)) {
                                    $(this).prop('checked', toggleStates[id]);
                                }
                            });

                            // ✅ Redraw table
                            dt.draw(false); // Stay on current page

                            // ❌ Removed toast message
                        }




