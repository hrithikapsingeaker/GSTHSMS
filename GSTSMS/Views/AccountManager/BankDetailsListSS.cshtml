                ],




                pageLength: 10,
                drawCallback: function () {
                    var api = this.api();
                    var pageInfo = api.page.info();

                    api.rows({ page: 'current' }).every(function (rowIdx, tableLoop, rowLoop) {
                        // Calculate serial number based on page number and row index
                        var srNo = pageInfo.start + rowLoop + 1;
                        $(this.node()).find('td:eq(1)').html(srNo);
                    });
                }
            });


            // Move search bar to custom wrapper (right side)
            $('#bankTable_filter').appendTo('#customSearchWrapper');

            // Move export buttons to exportButtons wrapper (left side)
            table.buttons().container().appendTo('#exportButtons');

            // ✅ Select All - Only active (not disabled) checkboxes
            $('#selectAll').on('change', function () {
                var checked = this.checked;
                $('.row-checkbox:not(:disabled)').prop('checked', checked);
            });

            // ✅ Single checkbox toggle - skip disabled rows in total
            $('#bankTable').on('change', '.row-checkbox', function () {
                var total = $('.row-checkbox:not(:disabled)').length;
                var checked = $('.row-checkbox:checked:not(:disabled)').length;
                $('#selectAll').prop('checked', total === checked);
            });

            // Tooltip
            $('[data-toggle="tooltip"]').tooltip();
        });


        function clearAllSelectionsAfterExport(dt) {
            // ✅ 1. Clear all row checkboxes (on current page)
            dt.rows().every(function () {
                $(this.node()).find('.row-checkbox').prop('checked', false);
            });

            // ✅ 2. Uncheck "Select All"
            $('#selectAll').prop('checked', false);
        }
        $(function () {
            $('.status-toggle').change(function () {
                var checkbox = $(this);
                var row = checkbox.closest('tr');
                var id = checkbox.data('id');
                var isActive = checkbox.prop('checked');

                $.ajax({
                    url: '/AccountManager/ToggleBankStatus',
                    type: 'POST',
                    data: { bankId: id, isActive: isActive },
                    success: function (response) {
                        if (response.success) {
                            swal({
                                icon: "success",
                                title: isActive ? 'Activated!' : 'Deactivated!',
                                text: isActive ? 'Bank marked as Active.' : 'Bank marked as Inactive.',
                                timer: 2000,
                                buttons: false

                            });


                            if (isActive) {
                                row.removeClass('bank-inactive').addClass('active-bank');

                                const wasPreviouslyChecked = row.find('input.row-checkbox').data('wasChecked');

                                row.find('input.row-checkbox')
                                    .prop('disabled', false);

                                if (wasPreviouslyChecked) {
                                    setTimeout(() => {
                                        row.find('input.row-checkbox')
                                            .prop('checked', true)
                                            .trigger('change'); // ✅ So DataTables detects change
                                    }, 10);
                                }

                                row.find('.receipt-link').removeClass('disabled-link');
                            } else {
                                const isCheckedNow = row.find('input.row-checkbox').prop('checked');

                                row.find('input.row-checkbox')
                                    .data('wasChecked', isCheckedNow) // 🧠 Remember
                                    .prop('disabled', true)
                                    .prop('checked', false); // ❌ Uncheck

                                row.removeClass('active-bank').addClass('bank-inactive');
                                row.find('.receipt-link').addClass('disabled-link');
                            }


                        } else {
                            swal({
                                toast: true,
                                icon: 'error',
                                title: 'Something went wrong while updating status',
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2500,
                                timerProgressBar: true
                            });

                        }
                    },
                    error: function () {
                        swal({
                            icon: 'error',
                            title: 'Server Error',
                            text: 'Failed to connect to server.',
                            position: 'top' // or 'center'
                        });

                    }
                });
            });
        });



