@model IEnumerable<GSTSMSLibrary.AccountManager.AccountManager>

@{
    ViewBag.Title = "Complaint List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var exportTimestamp = DateTime.Now.ToString("dd-MM-yyyy hh:mm tt");
    var today = DateTime.Now;
    var startOfMonth = new DateTime(today.Year, today.Month, 1);


    // Get unique status and assign by values for filters
    var statusValues = Model.Select(c => c.StatusName).Distinct().Where(s => !string.IsNullOrEmpty(s)).OrderBy(s => s).ToList();
    var assignByValues = Model.Select(c => c.AssignBy).Distinct().Where(a => !string.IsNullOrEmpty(a)).OrderBy(a => a).ToList();
    var wingValues = Model
     .Where(x => !string.IsNullOrWhiteSpace(x.Wing))
     .Select(c =>
     {
         var w = c.Wing.Trim().ToUpper();

         // If value is only A/B/C → convert to Wing A/B/C
         return (w.Length == 1) ? ("Wing " + w) : w;
     })
     .Distinct()
     .OrderBy(w => w)
     .ToList();



    var hasData = Model.Any();

}


@section Styles {
    <!-- 📊 DataTables Styles -->
    <link href="~/Content/modules/datatables/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/modules/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css" rel="stylesheet" />

    <!-- 📅 Date Range Picker -->
    <link rel="stylesheet" href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" />

    <!-- 🔔 iziToast Notification Styles (keep only minified version) -->
    <link href="~/Content/modules/izitoast/css/iziToast.min.css" rel="stylesheet" />

    <!-- 📝 Page-Specific & Custom Styles -->
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/css/components.css" />


    <link href="~/Content/css/ComplaintListSB.css" rel="stylesheet" />

}
<style>
    #selectAll {
        width: 14px;
        height: 14px;
        accent-color: #1E90FF;
    }

    .spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    .row-checkbox {
        width: 14px;
        height: 14px;
        accent-color: #1E90FF;
    }

    .filter-container {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap; /* Prevents wrapping to new line */
        flex-wrap: nowrap; /* Prevents wrapping */
    }

    .form-group.mb-3.d-flex.justify-content-between.align-items-center {
        margin-bottom: 1rem !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        padding: 8px 12px;
        flex-wrap: nowrap; /* Prevents wrapping */
        overflow-x: auto; /* Allows horizontal scrolling if needed */
    }

    /* Ensure all elements stay in one line */
    .d-flex.align-items-center {
        flex-shrink: 0; /* Prevents shrinking */
        white-space: nowrap;
    }
</style>

@*<div class="card">*@
<div class="card-body">


    <div class="loader-overlay" id="listLoader">
        <div class="loader"></div>
    </div>
    <div class="section-header text-center">
        <h1 class="complaint-header">Complaint List</h1>
    </div>

    @if (TempData["Message"] != null)
    {
        <script>
                swal({
                    icon: 'success',
                    title: 'Operation Successful 🎉',
                    text: '@TempData["Message"]',
                    confirmButtonColor: '#3085d6'
                });
        </script>
    }

    <div class="form-group mb-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon">
                <i class="fas fa-calendar"></i> <span>Select Date</span>
            </a>
            <input type="hidden" id="fromDate1" />
            <input type="hidden" id="toDate1" />
        </div>

        <div class="filter-container">
            <label for="statusFilter" class="mb-0" style="font-weight: bold; margin-right: 8px; color: black;">Status:</label>
            <select id="statusFilter" class="form-control @(!hasData ? "disabled-filter" : "")">
                <option value="">All Status</option>
                @if (hasData)
                {
                    foreach (var status in statusValues)
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>

            <label for="assignByFilter" class="mb-0" style="font-weight: bold; margin-right: 8px; margin-left: 12px; color: black;">Assign By:</label>
            <select id="assignByFilter" class="form-control @(!hasData ? "disabled-filter" : "")">
                <option value="">All Assigners</option>
                @if (hasData)
                {
                    foreach (var assignBy in assignByValues)
                    {
                        <option value="@assignBy">@assignBy</option>
                    }
                }
            </select>
            <label for="wingFilter" class="mb-0" style="font-weight: bold; margin-right: 8px; margin-left: 12px; color: black;">Wing:</label>
            <select id="wingFilter" class="form-control @(!hasData ? "disabled-filter" : "")">
                <option value="">All Wings</option>
                @if (hasData)
                {
                    foreach (var wing in wingValues)
                    {
                        // displayText = if already contains 'Wing' then keep else prefix
                        var displayText = wing.StartsWith("Wing", StringComparison.OrdinalIgnoreCase)
                                          ? wing
                                          : "Wing " + wing;
                        <option value="@wing">@displayText</option>
                    }
                }
            </select>


        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered" id="complaintTable">
            <thead>
                <tr class="py-3">
                    <th class="text-center"><input type="checkbox" id="selectAll" /></th>
                    <th class="text-center">Sr. No</th>
                    <th class="text-center">Complaint Type</th>
                    <th class="text-center">Description</th>
                    <th class="text-center">Complaint Date</th>
                    <!-- 🔹 Wing column (Complaint Date नंतर) -->
                    <th class="text-center">Wing</th>
                    <th class="text-center">Raised By</th>
                    <th class="text-center">Assign By</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr class="no-data-row py-3">
                        <td colspan="10" class="text-center text-danger font-weight-bold">
                            No complaints found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Select((value, index) => new { value, index }))
                    {
                        var complaintDate = item.value.ComplaintDate != DateTime.MinValue ? item.value.ComplaintDate.ToString("yyyy-MM-dd") : "";
                        var rowId = "checkbox-" + (item.index + 1);


                        <tr data-complaintdate="@complaintDate" data-status="@item.value.StatusName" data-assignby="@item.value.AssignBy" data-wing="@item.value.Wing" class="py-3">
                            <td class="text-center">
                                <input type="checkbox" class="row-checkbox" id="@rowId" data-id="@item.value.ComplaintId" />
                            </td>
                            <td class="text-center">@(item.index + 1)</td>

                            <td class="text-center" title="@item.value.ComplaintType">
                                @(string.IsNullOrWhiteSpace(item.value.ComplaintType) ? "N/A" : item.value.ComplaintType)
                            </td>

                            <td class="text-center" title="@item.value.Description">
                                @(string.IsNullOrWhiteSpace(item.value.Description) ? "N/A" : item.value.Description)
                            </td>

                            <td class="text-center" title="@item.value.ComplaintDate">
                                @(item.value.ComplaintDate != DateTime.MinValue
                        ? item.value.ComplaintDate.ToString("dd-MM-yyyy")
                        : "N/A")
                            </td>

                            <!-- NEW: Wing value after ComplaintDate -->
                            <!-- existing tr has data-wing="@item.value.Wing" -->
                            <td class="text-center wing-cell" title="Wing: @item.value.Wing" data-toggle="tooltip" data-placement="top">
                                @{
                                    var w = item.value.Wing?.Trim().ToUpper();
                                    var displayWing = string.IsNullOrWhiteSpace(w)
                                        ? "N/A"
                                        : (w.Length == 1 ? "Wing " + w : w);
                                }
                                @displayWing
                            </td>

                            <td class="text-center" title="@item.value.RaisedBy">
                                @(string.IsNullOrWhiteSpace(item.value.RaisedBy) ? "N/A" : item.value.RaisedBy)
                            </td>

                            <td class="text-center" title="@item.value.AssignBy">
                                @(string.IsNullOrWhiteSpace(item.value.AssignBy) ? "N/A" : item.value.AssignBy)
                            </td>

                            <td class="text-center" title="@item.value.StatusName">
                                <span class="status-@(string.IsNullOrWhiteSpace(item.value.StatusName) ? "na" : item.value.StatusName.ToLower())">
                                    @(string.IsNullOrWhiteSpace(item.value.StatusName) ? "N/A" : item.value.StatusName)
                                </span>
                            </td>

                            <td class="text-center">
                                @{
                                    var statusLower = (item.value.StatusName ?? "").ToLower();
                                    bool isResolved = statusLower.Contains("solve") || statusLower.Contains("closed");
                                }
                                @if (!isResolved)
                                {
                                    <button type="button"
                                            class="btn btn-success btn-sm resolve-complaint"
                                            data-id="@item.value.ComplaintId"
                                            title="Mark as Solved">
                                        Solve
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled title="Solve">
                                        Solve
                                    </button>
                                }

                                <a href="javascript:void(0);" class="btn btn-info btn-sm view-details"
                                   data-id="@item.value.ComplaintId" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>

        <div class="modal " id="complaintModal">
            <div class="modal-dialog modal-dialog-centered modal-custom-width">
                <div class="modal-content rounded-4 shadow" id="complaintModalContent">
                    <!-- Ajax partial view will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .section,
    .main-content {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    .section-header {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }
</style>

@section Scripts {
    <script src="~/Content/modules/jquery.min.js"></script>

    <!-- 2. Bootstrap JS (bundle) -->
    <script src="~/Content/modules/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- 3. DataTables core -->
    <script src="~/Content/modules/datatables/datatables.min.js"></script>
    <!-- 4. DataTables extension/buttons (if separate) -->
    <script src="~/Content/modules/datatables/datatables.js"></script>
    <!-- 5. Moment.js -->
    <script src="~/Content/modules/moment.min.js"></script>
    <!-- 6. Date Range Picker -->
    <script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
    <!-- 7. iziToast -->
    <script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
    <script src="~/Content/modules/izitoast/js/iziToast.js"></script>
    <!-- 8. SweetAlert -->
    <script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
    <!-- 9. Your custom scripts (after all dependencies) -->

    <script>
        // Show loader when page is loading
        $(window).on('load', function () {
            $('#listLoader').fadeOut(300);
        });

        // Optional: Also hide loader when table is fully drawn
        $(document).ready(function () {
            $('#complaintTable').on('draw.dt', function () {
                $('#listLoader').fadeOut(300);
            });
        });
        function hasAnyRowSelected() {
            return $('.row-checkbox:checked').length > 0;
        }

        function showToastWarning() {
            iziToast.warning({
                title: 'Warning!',
                message: 'Please select at least one complaint to export.',
                position: 'topCenter'
            });
        }
        $(document).ready(function () {
            var displayFormat = 'DD-MM-YYYY';

            $('.daterange-btn').daterangepicker({
                opens: 'right',
                autoUpdateInput: false,
                locale: { format: displayFormat },
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                },
                // Default start = start of month, default end = today (not endOf month)
                startDate: moment().startOf('month'),
                endDate: moment()
            }, function (start, end) {
                $('.daterange-btn span').html(start.format(displayFormat) + ' - ' + end.format(displayFormat));
                $('#fromDate1').val(start.format('YYYY-MM-DD'));
                $('#toDate1').val(end.format('YYYY-MM-DD'));
                $('#complaintTable').DataTable().draw();
            });

            // Set default values: start of month -> today
            var defaultStart = moment().startOf('month');
            var defaultEnd = moment(); // <-- changed from endOf('month') to today
            $('.daterange-btn span').html(defaultStart.format(displayFormat) + ' - ' + defaultEnd.format(displayFormat));
            $('#fromDate1').val(defaultStart.format('YYYY-MM-DD'));
            $('#toDate1').val(defaultEnd.format('YYYY-MM-DD'));
            $('#complaintTable').DataTable().draw();
        });

        // Custom date filter (inclusive)
        $.fn.dataTable.ext.search.push(function (settings, data) {
            var min = $('#fromDate1').val();  // YYYY-MM-DD
            var max = $('#toDate1').val();    // YYYY-MM-DD
            // Adjust the column index and input format if your table date column differs.
            var rowDate = moment(data[4], 'DD-MM-YYYY'); // data[4] -> your date column (DD-MM-YYYY)
            if (!rowDate.isValid()) return true;

            if (min) {
                var minMoment = moment(min, 'YYYY-MM-DD');
                // if rowDate < min => exclude
                if (rowDate.isBefore(minMoment, 'day')) return false;
            }
            if (max) {
                var maxMoment = moment(max, 'YYYY-MM-DD');
                // if rowDate > max => exclude
                if (rowDate.isAfter(maxMoment, 'day')) return false;
            }
            return true;
        });

            // Initialize DataTable with export buttons
            let table = $('#complaintTable').DataTable({
                dom: "<'row d-flex justify-content-between align-items-center mb-2'<'d-flex align-items-center'B><'ml-auto'f>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row'<'col-md-5'i><'col-md-7'p>>",


                ordering: false,
                pageLength: 10,
                columnDefs: [
                    { targets: 2, visible: false } // Complaint Type hide from UI
                ],
                language: {
                    infoFiltered: ""
                },
                buttons: [

                    {
                        extend: 'csvHtml5',
                        text: '<img src="/Content/img/icons8-csv-64.png" alt="CSV" style="height:32px;" title="Export CSV" />',
                        className: 'export-buttons icon-only-btn',
                        title: null,
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('input.row-checkbox').is(':checked');
                            },
                            columns: ':visible:not(:first-child):not(:last-child)'
                        },
                        customize: function (csv) {
                            const now = new Date();
                            const society = "Green Valley Society - Complaint List";
                            const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour: '2-digit', minute: '2-digit', hour12: true
                            })}`;

                            let lines = csv.split('\n').filter(line => line.trim() !== '');
                            const header = lines[0].split(',');
                            header[0] = 'Sr. No';
                            lines[0] = header.join(',');

                            for (let i = 1; i < lines.length; i++) {
                                let cols = lines[i].split(',');
                                cols[0] = i.toString();
                                for (let j = 0; j < cols.length; j++) {
                                    let cleanText = cols[j].replace(/['"]+/g, '').trim();
                                    if (cleanText.includes(',')) {
                                        cleanText = "${cleanText}";
                                    }
                                    cols[j] = cleanText;
                                }
                                lines[i] = cols.join(',');
                            }

                            const spacingRow = new Array(header.length).fill('').join(',');
                            const centerText = (text) => {
                                const totalCols = header.length;
                                const centerIndex = Math.floor(totalCols / 2);
                                const row = new Array(totalCols).fill('');
                                row[centerIndex] = text;
                                return row.join(',');
                            };

                            return `${centerText(society)} \n${centerText(timestamp)} \n${spacingRow} \n${lines.join('\n')}`;
                        },
                        filename: function () {
                            const now = new Date();
                            return 'ComplaintList_' + now.toLocaleDateString('en-GB').replace(/\//g, '-') + '_' +
                                now.getHours().toString().padStart(2, '0') + now.getMinutes().toString().padStart(2, '0');
                        },
                        action: function (e, dt, button, config) {
                            if (!hasAnyRowSelected()) return showToastWarning();
                            $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);
                            swal({
                                icon: 'success',
                                title: 'CSV Exported!',
                                text: 'Complaint list is downloading.',
                                buttons: false,
                                timer: 2000
                            });
                            clearAllSelectionsAfterExport(dt);
                        }
                    },
                    {
                        extend: 'excelHtml5',
                        text: '<img src="/Content/img/icons8-xls-64.png" style="height:32px;" title="Export Excel" />',
                        className: 'export-buttons icon-only-btn',
                        title: null, // ⛔ Remove default title
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('input.row-checkbox').is(':checked');
                            },
                            columns: ':visible:not(:first-child):not(:last-child)'
                        },
                        customizeData: function (data) {
                            let sr = 1;
                            data.body.forEach(function (row) {
                                row[0] = sr++;
                            });

                            const now = new Date();
                            const society = "Green Valley Society - Complaint List";
                            const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour: '2-digit', minute: '2-digit', hour12: true
                            })}`;

                            const totalCols = data.header.length;
                            const getCenteredRow = (text) => {
                                const row = new Array(totalCols).fill('');
                                row[Math.floor(totalCols / 2)] = text;
                                return row;
                            };

                            data.body.unshift(data.header); // move original header to body
                            data.header = getCenteredRow(society); // custom header
                            data.body.unshift(getCenteredRow(timestamp)); // timestamp above header
                        },
                        customize: function (xlsx) {
                            const sheet = xlsx.xl.worksheets['sheet1.xml'];

                            // Center align all cells in the worksheet
                            $('row c', sheet).attr('s', '51');  // 51 is usually the center style, may vary
                        },
                        filename: function () {
                            const now = new Date();
                            return 'ComplaintList_' + now.toLocaleDateString('en-GB').replace(/\//g, '-') + '_' +
                                now.getHours().toString().padStart(2, '0') + now.getMinutes().toString().padStart(2, '0');
                        },
                        action: function (e, dt, button, config) {
                            if (!hasAnyRowSelected()) return showToastWarning();
                            $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);


                            swal({
                                icon: 'success',
                                title: 'Excel Exported!',
                                text: 'Complaint list is downloading.',
                                buttons: false,
                                timer: 2000
                            });
                            clearAllSelectionsAfterExport(dt);
                        }
                    },


                    {
                        extend: 'pdfHtml5',
                        text: '<img src="/Content/img/icons8-pdf-64.png" alt="PDF" style="height:32px;" title="Export PDF" />',
                        className: 'export-buttons icon-only-btn',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('input.row-checkbox').is(':checked');
                            },
                            columns: ':visible:not(:first-child):not(:last-child)'
                        },
                        customize: function (doc) {
                            const now = new Date();
                            const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour: '2-digit', minute: '2-digit', hour12: true
                            })}`;

                            // Remove default title
                            doc.content.splice(0, 1);

                            // Add custom title and timestamp with spacing
                            doc.content.unshift(
                                {
                                    text: 'Green Valley Society - Complaint List',
                                    fontSize: 16,
                                    bold: true,
                                    alignment: 'center',
                                    margin: [0, 10, 0, 5]
                                },
                                {
                                    text: timestamp,
                                    fontSize: 10,
                                    italics: true,
                                    alignment: 'center',
                                    margin: [0, 0, 0, 10] // 10px gap before table
                                }
                            );

                            // Get table object and apply layout
                            const table = doc.content.find(x => x.table);
                            if (table) {
                                // Adjusted widths (auto distributed) — keep flexible for added Wing column
                                table.table.widths = Array(table.table.body[0].length).fill('*');
                                table.alignment = 'center';
                                // Layout styling
                                table.layout = {
                                    hLineWidth: () => 0.5,
                                    vLineWidth: () => 0.5,
                                    hLineColor: () => '#aaa',
                                    vLineColor: () => '#aaa',
                                    paddingLeft: () => 4,
                                    paddingRight: () => 4,
                                    paddingTop: () => 5,
                                    paddingBottom: () => 5
                                };
                                // 🔢 Auto-increment Sr. No (first column)
                                let srNo = 1;
                                table.table.body.forEach((row, index) => {
                                    if (index === 0) return; // skip header row
                                    row[0].text = srNo++;   // replace Sr. No cell text
                                });

                                // ✅ Center table on page
                                table.alignment = 'center';
                            }

                            // Table header style
                            doc.styles.tableHeader = {
                                bold: true,
                                fontSize: 11,
                                color: 'white',
                                fillColor: '#615677',
                                alignment: 'center'
                            };

                            // Global default style
                            doc.defaultStyle = {
                                fontSize: 10,
                                alignment: 'center'
                            };
                        },
                        filename: function () {
                            const now = new Date();
                            return 'ComplaintList_' +
                                now.toLocaleDateString('en-GB').replace(/\//g, '-') + '_' +
                                now.getHours().toString().padStart(2, '0') +
                                now.getMinutes().toString().padStart(2, '0');
                        },
                        action: function (e, dt, node, config) {
                            if (!hasAnyRowSelected()) return showToastWarning();
                            $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, node, config);
                            swal({
                                icon: 'success',
                                title: 'PDF Exported!',
                                text: 'Complaint list is downloading.',
                                buttons: false,
                                timer: 2000
                            });
                            clearAllSelectionsAfterExport(dt);
                        }
                    },

                    {
                      extend: 'print',
                      title: '',
                        text: '<img src="/Content/img/icons8-print-100.png" alt="Print" style="height:32px;" title="Print" />',
                        titleAttr: 'Print',
                        className: 'export-buttons icon-only-btn',
                exportOptions: {
                    // Exclude the first and last column from the print output.
                     // This is based on the columns specified in the CSV export code.
        columns: ':visible:not(:first-child):not(:last-child)',
        modifier: { search: 'applied', order: 'applied', page: 'all' },
        // Only include rows where the checkbox is checked.
        rows: function (idx, data, node) {
            return $(node).find('input.row-checkbox').prop('checked');
        }
    },
    customize: function (win) {
        // Get the current date and time for the header.
        const now = new Date();
        const society = "Green Valley Society - Complaint List";
        const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
            day: '2-digit', month: '2-digit', year: 'numeric',
            hour: '2-digit', minute: '2-digit', hour12: true
        })}`;

        // Add the custom header to the print view.
        $(win.document.body)
            .css('font-size', '10pt')
            .prepend(
                '<div style="text-align:center; margin:0 0 10px 0;">' +
                '<h2>' + society + '</h2>' +
                '<p>' + timestamp + '</p>' +
                '</div>'
            );

        // Style the table for better print output.
        $(win.document.body).find('table')
            .addClass('compact')
            .css({ fontSize: 'inherit', textAlign: 'left', margin: '0 auto', borderCollapse: 'collapse', width: '100%' });

        // Style table cells and headers.
        $(win.document.body).find('th, td')
            .css({ border: '1px solid black', padding: '5px' });

        $(win.document.body).find('th').css('text-align', 'center');

        // Add a serial number column to the print output.
        const headerCells = $(win.document.body).find('thead tr th');
        if (headerCells.length > 0 && $(headerCells[0]).text().trim() !== 'Sr. No') {
            $(headerCells[0]).text('Sr. No');
        }

        const bodyRows = $(win.document.body).find('tbody tr');
        bodyRows.each(function (index) {
            const firstCell = $(this).find('td').eq(0);
            if (firstCell.length) {
                firstCell.text(index + 1);
            }
        });

        // Add custom print CSS for better formatting.
        const style = document.createElement('style');
        style.type = 'text/css';
        style.innerHTML = `
            @@page { margin: 0; }
            @@media print {
                html, body { height: auto !important; min-height: 0 !important; margin: 0 !important; padding: 20px !important; }
                .dt-print-view { overflow: visible !important; position: static !important; }
                table { width: 100%; border-collapse: collapse; }
                thead { display: table-header-group; }
                tfoot { display: table-footer-group; }
                tr, td, th { page-break-inside: avoid; }
            }
        `;
        $(win.document.head).append(style);

        $(win.document.body).find('table').addClass('print-table');
    },
    action: function (e, dt, button, config) {
