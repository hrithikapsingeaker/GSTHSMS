       $(document).on('click', '.resolve-complaint', function (e) {
    e.preventDefault(); // ✅ ADD: page reload stop

    var $btn = $(this);
    var complaintId = $btn.data('id');

    // ✅ ADD: Are you sure confirmation
    swal({
        title: "Are you sure?",
        text: "Do you really want to solve this complaint?",
        icon: "warning",
        buttons: ["Cancel", "Yes, Continue"],
    }).then(function (confirm) {

        if (!confirm) return;

        // ⬇️ तुझा ORIGINAL swal जसाच्य तसा
        swal({
            title: "Solve Complaint",
            text: "Enter reason for solving this complaint:",
            content: {
                element: "input",
                attributes: {
                    placeholder: "Enter solve reason...",
                    type: "text",
                    id: "solveReasonInput"
                }
            },
            buttons: ["Cancel", "Submit"],
        }).then(function (reason) {

            if (!reason) return;

            $btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("ResolveComplaintSB", "AccountManager")',
                type: 'POST',
                data: {
                    complaintId: complaintId,
                    reason: reason
                },
                success: function (res) {
                    reason = (reason || "").toString().trim();
                    if (!reason) {
                        iziToast.warning({
                            title: "Reason Required",
                            message: "Please enter solve reason!",
                            position: "topCenter"
                        });
                        $btn.prop('disabled', false);
                        return;
                    }

                    iziToast.success({
                        title: 'Success',
                        message: res.message || 'Complaint marked solve.',
                        position: 'topCenter'
                    });

                    var table = $('#complaintTable').DataTable();
                    var $row = $btn.closest('tr');

                    var statusHtml = '<span class="status-solved">Solve</span>';

                    var $viewBtn = $row.find('.view-details').first();
                    var viewHtml = $viewBtn.length ? $viewBtn.prop('outerHTML') : '';

                    var disabledSolveBtnHtml =
                        '<button class="btn btn-sm btn-secondary" disabled title="Solved">Solve</button>';

                    var newActionHtml = disabledSolveBtnHtml + ' ' + viewHtml;

                    $row.find('td').eq(7).html(statusHtml);
                    $row.find('td').last().html(newActionHtml);
                    $row.find('.row-checkbox').prop('checked', false);

                    try {
                        table.cell($row, 7).data(statusHtml);
                        var lastColIdx = table.columns().nodes().to$().length - 1;
                        table.cell($row, lastColIdx).data(newActionHtml);
                        table.row($row).invalidate().draw(false);
                    } catch (err) {
                        table.row($row).invalidate().draw(false);
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                    iziToast.error({
                        title: 'Error',
                        message: 'Server error. Try again.',
                        position: 'topCenter'
                    });
                    $btn.prop('disabled', false);
                }
            });
        });
    });
});


