            iziToast.warning({ title: 'No Rows Selected', message: 'Please select at least one row to print.', position: 'topCenter' });
            return;
        }

        // Call the original DataTables print action.
        $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);
        clearAllSelectionsAfterExport(dt);
    }
