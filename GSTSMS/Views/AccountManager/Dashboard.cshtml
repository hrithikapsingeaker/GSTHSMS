    <script>
    // Month names array
    const monthNames = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ];

    let currentWorkerMonth = new Date().getMonth() + 1;
    let workerChart = null;

    // Update month display function
    function updateWorkerMonthDisplay(month) {
        document.getElementById('workerMonthDisplay').textContent = monthNames[month - 1];
        document.getElementById('workerMonthSelector').value = month;
        fetchWorkerChart(month);
    }

    // Previous month button
    document.getElementById('prevWorkerMonth').addEventListener('click', () => {
        currentWorkerMonth--;
        if (currentWorkerMonth < 1) currentWorkerMonth = 12;
        updateWorkerMonthDisplay(currentWorkerMonth);
    });

    // Next month button
    document.getElementById('nextWorkerMonth').addEventListener('click', () => {
        currentWorkerMonth++;
        if (currentWorkerMonth > 12) currentWorkerMonth = 1;
        updateWorkerMonthDisplay(currentWorkerMonth);
    });

    // Month selector change
    document.getElementById('workerMonthSelector').addEventListener('change', function () {
        currentWorkerMonth = parseInt(this.value);
        updateWorkerMonthDisplay(currentWorkerMonth);
    });

    // View All Workers button
    $("#btnViewAllWorkers").click(function () {
        $("#modalAllWorkersBody").html('<div class="text-center p-3">Loading...</div>');
        var modal = new bootstrap.Modal(document.getElementById("modalAllWorkers"));
        modal.show();

        var url_AllWorkers = '@Url.Action("WorkerPaymentListPartial_All", "AccountManager")';
        $("#modalAllWorkersBody").load(url_AllWorkers);
    });

    // Update center text in chart
    function updateChartCenterText(completed, pending) {
        const centerTextElement = document.getElementById('chartCenterText');
        if (centerTextElement) {
            centerTextElement.textContent = `${completed} / ${pending}`;
        }
    }

    // Fetch and render chart
    async function fetchWorkerChart(month) {
        try {
            console.log("Fetching chart data for month:", month);

            // Fetch data from server
            const response = await fetch(`/AccountManager/GetWorkerPaymentChart?month=${month}`);

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            console.log("Chart data received:", data);

            const completed = data.Completed || 0;
            const pending = data.Pending || 0;

            // Update center text
            updateChartCenterText(completed, pending);

            // Prepare chart data
            const chartData = {
                labels: ["Completed", "Pending"],
                datasets: [{
                    data: [completed, pending],
                    backgroundColor: ['#5A56E9', '#D3D3F3'],
                    borderWidth: 0,
                    cutout: '70%',
                }]
            };

            // Chart options
            const chartOptions = {
                rotation: -90,
                circumference: 180,
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `${context.label}: ${context.raw}`;
                            }
                        }
                    }
                },
                onClick: function(evt, elements) {
                    if (elements.length > 0) {
                        console.log("Chart clicked, opening modal...");
                        const selectedMonth = document.getElementById("workerMonthSelector").value;
                        const modalEl = document.getElementById("workerPaymentModal");
                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();

                        // Load modal content via AJAX
                        $("#workerPaymentModalBody").html('<div class="text-center p-3">Loading...</div>');
                        const partialUrl = '@Url.Action("WorkerPaymentListPartial", "AccountManager")';
                        $("#workerPaymentModalBody").load(partialUrl + "?month=" + selectedMonth, function(response, status) {
                            if (status === "error") {
                                $("#workerPaymentModalBody").html("<div class='alert alert-danger'>Failed to load data.</div>");
                                return;
                            }
                            console.log("Partial view loaded successfully");
                            if (typeof initWorkerPaymentTable === "function") {
                                initWorkerPaymentTable();
                            }
                        });
                    }
                }
            };

            // Get canvas context
            const ctx = document.getElementById('workerPaymentChart');
            if (!ctx) {
                console.error("Canvas element not found!");
                return;
            }

            // Destroy existing chart if exists
            if (workerChart) {
                workerChart.destroy();
            }

            // Create new chart
            workerChart = new Chart(ctx.getContext('2d'), {
                type: 'doughnut',
                data: chartData,
                options: chartOptions
            });

            console.log("Chart created successfully");

        } catch (error) {
            console.error("Error loading chart:", error);

            // Show error in chart area
            const chartContainer = document.querySelector('#workerPaymentChart').parentElement;
            if (chartContainer) {
                chartContainer.innerHTML = `
                    <div class="alert alert-warning text-center p-3">
                        <p>Unable to load chart data</p>
                        <button onclick="fetchWorkerChart(${month})" class="btn btn-sm btn-primary mt-2">Retry</button>
                    </div>
                `;
            }

            // Update center text with zeros
            updateChartCenterText(0, 0);
        }
    }

