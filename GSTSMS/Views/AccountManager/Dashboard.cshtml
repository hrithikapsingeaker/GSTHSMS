    // ================== EVENT EXPENSES (HIGCHART + DATERANGE) ==================
    $(document).ready(function () {
        const format = "YYYY-MM-DD";

        function initializeEventDateRangePicker() {
            $('.event-daterange-btn').daterangepicker({
                locale: { format: format },
                autoUpdateInput: false,
                opens: "right",
                drops: "down",
                linkedCalendars: false,
                ranges: {
                    "Today": [moment(), moment()],
                    "Last 7 Days": [moment().subtract(6, "days"), moment()],
                    "This Month": [moment().startOf("month"), moment().endOf("month")],
                    "Last Month": [moment().subtract(1, "month").startOf("month"), moment().subtract(1, "month").endOf("month")]
                }
            }, function (start, end) {
                $('#fromDate1').val(start.format(format));
                $('#toDate1').val(end.format(format));
                $('.event-daterange-btn span').html(start.format('DD MMM YYYY') + " - " + end.format('DD MMM YYYY'));
                loadEventExpensesByDate(start.format(format), end.format(format));
            });

            $('.event-daterange-btn span').html(
                moment($('#fromDate1').val()).format('DD MMM YYYY') + ' - ' +
                moment($('#toDate1').val()).format('DD MMM YYYY')
            );
        }

        function openEventModal(eventCode, eventName) {
            $("#eventDetailsModal .modal-title").text("Event Details - " + eventName);
            $("#eventDetailsBody").html('<p class="text-center text-muted">Loading...</p>');

            var eventModal = new bootstrap.Modal(document.getElementById('eventDetailsModal'));
            eventModal.show();

            $.get('@Url.Action("EventDetails", "AccountManager")', { eventCode: eventCode })
                .done(function (data) {
                    $("#eventDetailsBody").html(data);
                })
                .fail(function () {
                    $("#eventDetailsBody").html('<p class="text-danger text-center">Failed to load event details.</p>');
                });
        }

        function loadEventExpensesByDate(fromDate, toDate) {
            $.get('@Url.Action("GetEventExpensesByDate", "AccountManager")', { fromDate, toDate })
                .done(function (data) {
                    if (!data || data.length === 0) {
                        $('#eventExpensesChart').html('<p class="text-danger text-center">No data found.</p>');
                        return;
                    }

                    Highcharts.chart('eventExpensesChart', {
                        chart: { type: 'column' },
                        title: { text: null },
                        credits: { enabled: false },
                        tooltip: {
                            pointFormat: '<b>₹{point.y:.2f}</b>'
                        },
                        xAxis: { categories: data.map(x => x.EventName), crosshair: true },
                        yAxis: { min: 0, title: { text: 'Amount (₹)' } },
                        plotOptions: {
                            column: { pointPadding: 0.1, groupPadding: 0.1, pointWidth: 30 },
                            series: {
                                cursor: 'pointer',
                                point: {
                                    events: {
                                        click: function () {
                                            openEventModal(this.options.custom.eventCode, this.options.custom.eventName);
                                        }
                                    }
                                }
                            }
                        },
                        series: [
                            {
                                name: 'Allocated Budget',
                                data: data.map(x => ({
                                    y: x.Allocated,
                                    custom: { eventCode: x.EventCode, eventName: x.EventName }
                                }))
                            },
                            {
                                name: 'Actual Cost',
                                data: data.map(x => ({
                                    y: x.Actual,
                                    custom: { eventCode: x.EventCode, eventName: x.EventName }
                                }))
                            }
                        ]
                    });
                })
                .fail(function () {
                    $('#eventExpensesChart').html('<p class="text-danger text-center">Failed to load chart.</p>');
                });
        }

        let start = $('#fromDate1').val();
        let end = $('#toDate1').val();
        initializeEventDateRangePicker();
        loadEventExpensesByDate(start, end);
    });






