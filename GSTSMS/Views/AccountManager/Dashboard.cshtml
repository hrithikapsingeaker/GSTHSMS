    // ================== DASHBOARD TRANSACTION SUMMARY (DATE RANGE + BANK) ==================
    $(document).ready(function () {

        const dbFormat = "YYYY-MM-DD";     // backend format
        const uiFormat = "DD MMM YYYY";    // UI display format

        // Default (current month)
        let start = moment().startOf("month");
        let end = moment().endOf("month");

        $("#fromDate").val(start.format(dbFormat));
        $("#toDate").val(end.format(dbFormat));

        $(".daterange-btn span").html(`${start.format(uiFormat)} - ${end.format(uiFormat)}`);

        loadBankList(start.format(dbFormat), end.format(dbFormat));

        // ============================ NEW UPDATED RANGE PICKER ===============================
        $('.daterange-btn').daterangepicker({

            locale: { format: dbFormat },
            autoUpdateInput: false,
            opens: "left",
            drops: "down",
            linkedCalendars: false,

            ranges: {
                "Today": [moment(), moment()],
                "Last 7 Days": [moment().subtract(6, "days"), moment()],
                "This Month": [moment().startOf("month"), moment().endOf("month")],
                "Last Month": [
                    moment().subtract(1, "month").startOf("month"),
                    moment().subtract(1, "month").endOf("month")
                ]
            }

        }, function (start, end, label) {

            // If user chooses only one date
            if (label === "Today") end = start;

            $("#fromDate").val(start.format(dbFormat));
            $("#toDate").val(end.format(dbFormat));

            $(".daterange-btn span").html(
                `${start.format(uiFormat)} - ${end.format(uiFormat)}`
            );

            // Load summary
            loadDashboardSummary(start.format(dbFormat), end.format(dbFormat));
        });
    });


    function loadBankList(fromDate, toDate) {

        $.ajax({
            url: "/AccountManager/GetBankCodes",
            type: "GET",
            success: function (res) {

                let ddl = $("#bankSelector");
                ddl.empty();

                $.each(res.data, function (i, bank) {
                    ddl.append(
                        `<option value="${bank.BankId}">${bank.BankShortCode}</option>`
                    );
                });

                // Auto-select first bank
                let firstBank = $("#bankSelector option:first").val();
                $("#bankSelector").val(firstBank);

                // Load graph
                loadDashboardSummary(fromDate, toDate);
            }
        });
    }


    function loadDashboardSummary(fromDate, toDate) {

        let bankId = $("#bankSelector").val();
        if (!bankId) return;

        $.ajax({
            url: "/AccountManager/GetBankTransactionSummary",
            type: "GET",
            data: { fromDate, toDate, bankId },

            success: function (res) {

                if (res.status === "success") {

                    let d = res.data;

                    $("#creditedAmount").text("₹ " + Number(d.Credited).toLocaleString('en-IN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }));

                    $("#debitedAmount").text("₹ " + Number(d.Debited).toLocaleString('en-IN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }));


                    let total = d.Credited + d.Debited;
                    let creditPercent = total === 0 ? 0 : (d.Credited / total) * 100;
                    let debitPercent = total === 0 ? 0 : (d.Debited / total) * 100;

                    $("#creditedBar").css("width", creditPercent + "%");
                    $("#debitedBar").css("width", debitPercent + "%");
                }
            }
        });
    }


    $("#bankSelector").on("change", function () {
        loadDashboardSummary($("#fromDate").val(), $("#toDate").val());
    });








    // ================== TRANSACTION MODAL (CLICK ON BARS) ==================
    // ================== TRANSACTION MODAL (CLICK ON BARS) ==================
    $(document).on("click", "#creditedBar, #debitedBar", function () {

        let isCredit = $(this).attr("id") === "creditedBar";
        let transactionType = isCredit ? 26 : 27;
        let bankId = $("#bankSelector").val();

        // ⭐ NEW: Selected Bank Text
        let bankName = $("#bankSelector option:selected").text();
        let title = isCredit ? "Credit Transactions" : "Debit Transactions";
        let mode = isCredit ? "credit" : "debit";
        let fromDate = $("#fromDate").val();
        let toDate = $("#toDate").val();


        let totalAmount = isCredit
            ? $("#creditedAmount").text()
            : $("#debitedAmount").text();

        const uiFormat = "DD MMM YYYY";

        let range = $(".daterange-btn span").text().trim();
        let startDateText = range.includes("-")
            ? range.split(" - ")[0].trim()
            : $("#fromDate").val();

        let parsedDate = moment(startDateText, uiFormat);
        let month = parsedDate.month() + 1;

        // ⭐ NEW: bankName added to URL

        let url = `/AccountManager/TransactionListPartial?transactionType=${transactionType}&month=${month}&bankId=${bankId}&total=${encodeURIComponent(totalAmount)}&bankName=${encodeURIComponent(bankName)}&title=${encodeURIComponent(title)}&mode=${mode}&fromDate=${fromDate}&toDate=${toDate}`;

        $("#transactionModalTitle").text(
            isCredit ? "Credit Transactions" : "Debit Transactions"
        );

        let modal = new bootstrap.Modal(document.getElementById("transactionModal"));
        modal.show();

        $("#transactionTableContainer").load(url);
    });









