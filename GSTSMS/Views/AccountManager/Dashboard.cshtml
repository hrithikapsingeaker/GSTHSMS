@model GSTSMSLibrary.AccountManager.AccountManager
@using Newtonsoft.Json
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}





<!-- External Libraries -->
<script src="https://code.highcharts.com/highcharts.js"></script>

<link href="~/Content/css/AuditReport.css" rel="stylesheet" />

<script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
<script src="~/Content/modules/datatables/datatables.min.js"></script>

<script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
<script src="~/Content/modules/moment.min.js"></script>

<link rel="stylesheet" href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" />
<script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="~/Content/css/Dashboard.css" rel="stylesheet" />





<!-- MAIN CONTENT START -->
<!-- TOP CARDS -->
<!-- MAIN CONTENT START -->
<!-- TOP CARDS -->
<div class="row row-flex text-white mb-4" style="gap: 20px; margin-top: 0 !important; padding-top: 0.5rem !important; ">
    <div class="loader-overlay" id="listLoader">
        <div class="loader"></div>
    </div>

    <!-- Maintenance Due Card -->
    <div class="col p-3 rounded maintenance-card text-white text-center"
         style="width: 250px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; cursor: pointer; background: linear-gradient(145deg, #6698C3, #5A8BC1); box-shadow: 8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1); transition: all 0.4s ease; "
         data-url='@Url.Action("MaintenanceDueListYP", "AccountManager")'
         onmouseover="this.style.transform='translateY(-8px) rotateX(4deg) rotateY(-2deg)'; this.style.boxShadow='12px 12px 25px rgba(0,0,0,0.35), -6px -6px 15px rgba(255,255,255,0.15)';"
         onmouseout="this.style.transform='translateY(0) rotateX(0) rotateY(0)'; this.style.boxShadow='8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1)';">
        <div style="width: 55px; height: 55px;
             background: rgba(255,255,255,0.2);
             border-radius: 50%;
             display: flex;
             justify-content: center;
             align-items: center;
             margin: 0 auto 12px;
             box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3),
                         inset -2px -2px 6px rgba(255,255,255,0.2);">
            <i class="fas fa-file-invoice fa-lg"></i>
        </div>
        <h6 class="mb-2 text-uppercase fw-bold" style="letter-spacing: 1px;">Maintenance Due</h6>
        <h3 class="mb-0 fw-bold">₹ @((ViewBag.MaintenanceDue ?? 0).ToString("N2"))</h3>
    </div>

    <!-- Maintenance Due Modal -->
    <div class="modal fade" id="maintenanceDueModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-light py-2">
                    <h5 class="modal-title text-center w-100 text-dark">Pending Maintenance List</h5>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="modal-body p-0">
                    <div id="maintenanceDueModalBodyy" class="p-3"
                         style="max-height: 80vh; overflow-y: auto; display: inline-block; width: 100%;">
                        <!-- Partial View Will Load Here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cash in Hand -->
    <div class="col p-3 rounded bank-card text-white text-center"
         style="width: 250px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; cursor: default; background: linear-gradient(145deg, #81c784, #66bb6a); box-shadow: 8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1); transition: all 0.4s ease;"
         onmouseover="this.style.transform='translateY(-8px) rotateX(4deg) rotateY(-2deg)'; this.style.boxShadow='12px 12px 25px rgba(0,0,0,0.35), -6px -6px 15px rgba(255,255,255,0.15)';"
         onmouseout="this.style.transform='translateY(0) rotateX(0) rotateY(0)'; this.style.boxShadow='8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1)';">
        <div style="width: 55px; height: 55px;
                background: rgba(255,255,255,0.2);
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 auto 12px;
                box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3),
                            inset -2px -2px 6px rgba(255,255,255,0.2);">
            <i class="fas fa-wallet fa-lg"></i>
        </div>
        <h6 class="mb-2 text-uppercase fw-bold" style="letter-spacing: 1px;">Cash in Hand</h6>
        <h3 class="mb-0 fw-bold">₹ @((ViewBag.CashInHand ?? 0).ToString("N2"))</h3>
    </div>

    <!-- Bank Balance Card -->
    <div class="col p-3 rounded bank-card text-white text-center"
         style="width: 250px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; cursor: pointer; background: linear-gradient(145deg, #b39ddb, #9575cd); box-shadow: 8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1); transition: all 0.4s ease;"
         onmouseover="this.style.transform='translateY(-8px) rotateX(4deg) rotateY(-2deg)'; this.style.boxShadow='12px 12px 25px rgba(0,0,0,0.35), -6px -6px 15px rgba(255,255,255,0.15)';"
         onmouseout="this.style.transform='translateY(0) rotateX(0) rotateY(0)'; this.style.boxShadow='8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1)';">
        <div style="width: 55px; height: 55px;
                background: rgba(255,255,255,0.2);
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 auto 12px;
                box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3),
                            inset -2px -2px 6px rgba(255,255,255,0.2);">
            <i class="fas fa-university fa-lg"></i>
        </div>
        <h6 class="mb-2 text-uppercase fw-bold" style="letter-spacing: 1px;">Bank Balance</h6>
        <h3 class="text-center mb-2 fw-bold">View...</h3>
        <div class="bank-details w-100">
            <ul id="bankBalanceList" class="mb-0 text-center"
                style="list-style: none; padding-left: 0; font-size: 15px; line-height: 1.6; color:white;">
            </ul>
        </div>
    </div>

    <!-- Complaints Card -->
    <div class="col p-3 rounded bank-card text-white text-center"
         style="width: 250px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; cursor: pointer; background: linear-gradient(145deg, #A3AB87, #8F9573); box-shadow: 8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1); transition: all 0.4s ease;"
         data-bs-toggle="modal"
         data-bs-target="#complaintModal"
         onmouseover="this.style.transform='translateY(-8px) rotateX(4deg) rotateY(-2deg)'; this.style.boxShadow='12px 12px 25px rgba(0,0,0,0.35), -6px -6px 15px rgba(255,255,255,0.15)';"
         onmouseout="this.style.transform='translateY(0) rotateX(0) rotateY(0)'; this.style.boxShadow='8px 8px 18px rgba(0,0,0,0.25), -5px -5px 15px rgba(255,255,255,0.1)';">
        <div style="width: 55px; height: 55px;
                    background: rgba(255,255,255,0.2);
                    border-radius: 50%;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    margin: 0 auto 12px;
                    box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3),
                                inset -2px -2px 6px rgba(255,255,255,0.2);">
            <i class="fas fa-comments fa-lg"></i>
        </div>
        <h6 class="mb-2 text-uppercase fw-bold" style="letter-spacing: 1px;">Complaints</h6>
        <h3 class="text-center mb-0 fw-bold">@ViewBag.TotalComplaints</h3>
    </div>
</div>

<div id="complaints-container">
    <p>Loading complaints...</p>
</div>

<!-- EVENT & TRANSACTION ROW -->
<div class="container">
    <div class="row gx-4 gy-4">
        <div class="container-fluid px-0">
            <div class="row g-0 align-items-stretch">
                <!-- Event Expenses Card -->
                <div class="col-lg-6 col-md-6 col-sm-12 d-flex">
                    <div class="card shadow-sm flex-fill" style="border-radius: 10px; width: 100%; margin:0;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-title text-center mb-0" style="color:black;">Event Expenses</h6>
                                <div class="form-group mb-0 d-flex align-items-center">
                                    <a href="javascript:;" class="btn btn-primary event-daterange-btn icon-left btn-icon">
                                        <i class="fas fa-calendar"></i> <span>Choose Date</span>
                                    </a>
                                    <input type="hidden" id="fromDate1" value="@ViewBag.StartOfMonth" />
                                    <input type="hidden" id="toDate1" value="@ViewBag.EndOfMonth" />
                                </div>
                            </div>
                            <div id="eventExpensesChart" style="height:400px;"></div>
                        </div>
                    </div>
                </div>

                <!-- Total Transactions Card -->
                <div class="col-lg-6 col-md-6 col-sm-12 d-flex">
                    <div class="card shadow-sm flex-fill" style="border-radius: 10px; width: 100%;">
                        <div class="card-body d-flex flex-column">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="card-title mb-0" style="color:black;"><b>Total Transactions</b></h6>
                                <br />
                                <br />
                                <!-- Date Picker -->
                                <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon">
                                    <i class="fas fa-calendar"></i>
                                    <span>Select Date</span>
                                </a>
                                <br />

                            </div>
                            <!-- Bank Dropdown -->
                            <select id="bankSelector"
                                    class="form-select form-select-sm"
                                    style="width: 150px; color: black; font-weight: bold;">
                            </select>
                            <br />
                            <!-- Bars -->
                            <div class="text-center">
                                <h6><b>Credited</b></h6>
                                <div class="progress mb-3 credit-bar" style="height:25px;">
                                    <div id="creditedBar"
                                         class="progress-bar"
                                         style="width:0%; background:linear-gradient(90deg,#38ef7d,#11998e)">
                                        <span id="creditedAmount">₹ 0.00</span>
                                    </div>
                                </div>

                                <h6><b>Debited</b></h6>
                                <div class="progress debit-bar" style="height:25px;">
                                    <div id="debitedBar"
                                         class="progress-bar"
                                         style="width:0%; background:linear-gradient(90deg,#ff6a00,#ee0979)">
                                        <span id="debitedAmount">₹ 0.00</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" id="fromDate" />
    <input type="hidden" id="toDate" />
</div>



<style>
    /* .modalevent {
        max-width: 121% !important;
    }
    .modal.show .modal-content {
        max-width: 121% !important;
    }*/








</style>



<!-- Event Details Modal -->
<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-hidden="true" style="width: 1800px !important;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modalevent" style="margin-top: 0px !important; max-width: 1200px!important; margin-left: 122px !important;">
            <div class="modal-header">
                <h5 class="modal-title" style="color:black">Event Details</h5>
                <button type="button" class="btn" onclick="closeModal()"
                        style="border: none; color: white; background-color: red; outline: none; border-radius: 4px;
                            box-shadow: none; font-size: 20px; cursor: pointer; width: 28px; height: 28px;
                            display: flex; align-items: center; justify-content:center;">
                    ×
                </button>
            </div>
            <div class="modal-body" id="eventDetailsBody">
                <!-- Event details will load here -->
            </div>
        </div>
    </div>
</div>









<!-- Transaction List Modal -->
<div class="modal fade"
     id="transactionModal"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 6px;">
            <!-- Header -->
            <div class="modal-header bg-white d-flex justify-content-between align-items-center" style="height: 50px;">
                <!-- Title centered -->
                <h5 class="modal-title flex-grow-1 text-center m-0"
                    id="transactionModalTitle"
                    style="color: #333; font-size: 18px; font-weight: bold;">
                </h5>
                <!-- Custom Close Button -->
                <button type="button" class="d-flex align-items-center justify-content-center"
                        data-bs-dismiss="modal" aria-label="Close"
                        style="margin-left: auto; width: 32px; height: 32px; background-color: #dc3545; color: #fff; font-size: 1.2rem; line-height: 1; padding: 0; border: none; transition: background 0.2s; margin-bottom: 25px;">
                    &times;
                </button>
            </div>
            <!-- Body -->
            <div class="modal-body">
                <!-- Transactions Table -->
                <div id="transactionTableContainer">
                    <!-- Partial will load here -->
                </div>
                <!-- Pagination -->
                <div class="d-flex justify-content-end mt-3">
                    <div id="transactionPaginationControls" class="d-flex flex-wrap gap-2"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <!-- Worker Payment Card - Left Side -->
        <div class="col-md-5" style=" padding: 10px;">
            <div class="card shadow-sm h-100" style="width: 100%;">
                <div class="card-body" style="height: 497px;">
                    <h5 class="mb-0" style="color:black"><b>Worker Payment Status</b></h5>
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <button id="btnViewAllWorkers" class="btn btn-primary btn-sm">View All Data</button>
                        <div class="worker-month-nav d-flex align-items-center">
                            <button id="prevWorkerMonth" class="btn btn-sm btn-outline-secondary me-1">←</button>
                            <span id="workerMonthDisplay" class="mx-2">January</span>
                            <button id="nextWorkerMonth" class="btn btn-sm btn-outline-secondary me-2">→</button>
                            <select id="workerMonthSelector" class="form-control form-control-sm"
                                    style="width: 120px; height: 30px; padding: 2px 8px;">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <!-- Chart Container -->
                    <div style="position: relative; height: 300px; width: 100%;">
                        <canvas id="workerPaymentChart"></canvas>
                        <!-- Center Text Div -->
                        <div id="chartCenterText" style="position: absolute; top: 60%; left: 50%; transform: translate(-50%, -50%); text-align: center; font-weight: bold; font-size: 16px;">
                            0 / 0
                        </div>
                    </div>
                    <div class="text-center mt-3" style="color:black">
                        <span class="dot bg-primary"></span> Completed &nbsp;&nbsp;
                        <span class="dot bg-light border border-dark"></span> Pending
                    </div>
                </div>
            </div>
        </div>

        <style>
            /* =======================
            ✅ MAINTENANCE MAIN CARD
            ======================= */
            .maintenance-card-wrapper {
                border-radius: 18px;
                background-color: #ffffff;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
                padding: 14px;
            }

                /* =======================
            ✅ FORCE ALL TEXT BOLD & BLACK
            ======================= */
                .maintenance-card-wrapper * {
                    font-weight: 700;
                    color: #000000;
                }

            /* ✅ Penalty amount RED ठेवायचा असेल तर */
            .amount-row.text-danger {
                color: #dc2626 !important;
                font-weight: 800;
            }

            /* =======================
            ✅ FILTERS — BLACK BORDER
            ======================= */
            .maintenance-filter {
                width: 140px;
                height: 38px;
                padding: 6px 10px;
                font-weight: 700;
                color: #000000;
                background-color: #f3f4f6;
                border: 2px solid #000000;
                border-radius: 12px;
            }

                .maintenance-filter:focus {
                    outline: none;
                    box-shadow: none;
                    border-color: #000000;
                }

            /* =======================
            ✅ BOTH DONUTS SAME SIZE
            ======================= */
            .chart-box {
                background-color: #f9fafb;
                border-radius: 16px;
                padding: 14px;
                width: 260px;
                height: 260px;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

                .chart-box canvas {
                    width: 220px !important;
                    height: 220px !important;
                    max-width: 220px !important;
                    max-height: 220px !important;
                }

            /* =======================
            ✅ LEGENDS TEXT BLACK
            ======================= */
            .chart-legend,
            .paid-legend,
            .pending-legend,
            .penalty-legend {
                position: absolute;
                top: -30px;
                left: 50%;
                transform: translateX(-50%);
                font-size: 12px;
                font-weight: 700;
                color: #000000;
                white-space: nowrap;
            }

            /* =======================
            ✅ AMOUNT SECTION
            ======================= */
            .amount-section {
                margin-top: 10px;
                font-size: 14px;
                color: #000000;
            }

            .amount-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 6px 0;
                border-bottom: 1px dashed #d1d5db;
                color: #000000;
            }

                .amount-row:last-child {
                    border-bottom: none;
                }

            /* =======================
            ✅ TITLES & HEADINGS
            ======================= */
            .maintenance-title-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-bottom: 6px;
            }

            .maintenance-title {
                font-size: 18px;
                font-weight: 800;
                color: #000000;
            }

            .maintenance-subtitle {
                font-size: 15px;
                font-weight: 700;
                margin-bottom: 6px;
                text-align: center;
                color: #000000;
            }

            /* =======================
            ✅ RESPONSIVE MOBILE FIX
            ======================= */
            @@media (max-width: 768px) {

                .chart-box {
                    width: 230px;
                    height: 230px;
                    background-color: #f9fafb;
                }

                    .chart-box canvas {
                        width: 200px !important;
                        height: 200px !important;
                    }

                .maintenance-filter {
                    width: 100%;
                    background-color: #f3f4f6;
                    color: #000000;
                    border: 2px solid #000000;
                }
            }
        </style>

        <!-- ✅ Maintenance Status Section -->
        <div class="col-md-7">
            <div class="card maintenance-card-wrapper h-100">

                <!-- ✅ HEADER -->
                <div class="maintenance-title-row px-2 pt-2">
                    <div class="maintenance-title">Maintenance Status</div>

                    <div class="d-flex gap-2">
                        <select id="wingSelect" class="maintenance-filter"></select>

                        <input type="text" id="maintenanceMonthPicker"
                               class="maintenance-filter"
                               placeholder="MM/YYYY" readonly />
                    </div>
                </div>

                <!-- ✅ DONUT ROW -->
                <div class="row mt-2">

                    <!-- ✅ Monthly -->
                    <div class="col-md-6 text-center">

                        <div class="maintenance-subtitle">Monthly Maintenance</div>

                        <div class="chart-box" style="font-weight:bold;color:black;">
                            <canvas id="monthlyMaintenanceChart"></canvas>
                        </div>

                        <div class="amount-section">
                            <div class="amount-row">
                                <span>Total Amount</span>
                                <b>₹ <span id="monthlyTotalAmount">--</span></b>
                            </div>

                            <div class="amount-row">
                                <span>Pending Amount</span>
                                <b>₹ <span id="monthlyPendingAmount">--</span></b>
                            </div>

                            <div class="amount-row text-danger">
                                <span>Penalty Amount</span>
                                <b>₹ <span id="monthlyPenaltyAmount">--</span></b>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ Occasional -->
                    <div class="col-md-6 text-center">

                        <div class="maintenance-subtitle">Occasional Maintenance</div>

                        <div class="chart-box">
                            <canvas id="occasionalMaintenanceChart"></canvas>
                        </div>

                        <div class="amount-section">
                            <div class="amount-row">
                                <span>Total Amount</span>
                                <b>₹ <span id="occasionalTotalAmount">--</span></b>
                            </div>

                            <div class="amount-row">
                                <span>Pending Amount</span>
                                <b>₹ <span id="occasionalPendingAmount">--</span></b>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>



        <style>
            .modal.show .modal-content {
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                margin-top: 40px;
            }

            .dot {
                height: 10px;
                width: 10px;
                border-radius: 50%;
                display: inline-block;
            }

            .worker-month-nav {
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .worker-month-btn {
                background: none;
                border: 1px solid #ccc;
                border-radius: 3px;
                padding: 2px 8px;
                cursor: pointer;
            }

            /* Ensure both cards have same height */
            .card {
                min-height: 497px;
            }
        </style>

        <!-- Modals -->
        <div class="modal fade" id="maintenanceModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header bg-light py-2">
                        <h5 class="modal-title text-center w-100" id="maintenanceModalTitle" style="color:black"></h5>

                        <!-- ✅ ✅ BOOTSTRAP 4 FIXED CLOSE BUTTON -->
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-dismiss="modal"
                                aria-label="Close">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>

                    <div class="modal-body p-3">
                        <!-- ⬇ THIS IS WHERE PARTIAL VIEW LOADS -->
                        <div id="maintenanceModalContent">
                            <!-- Loading spinner will show here first -->
                            <div class="text-center p-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                                <p class="mt-2">Loading members...</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>



        <style>
            .modal.show .modal-content {
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                margin-top: 40px;
            }

            .dot {
                height: 10px;
                width: 10px;
                border-radius: 50%;
                display: inline-block;
            }

            .worker-month-nav {
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .worker-month-btn {
