    <script>

        let monthlyMaintenanceChart;
        let occasionalMaintenanceChart;
        let selectedChartMonth = null;
        let selectedChartYear = null;

        $(document).ready(function () {

            /* ===========================
               ✅ FLATPICKR MONTH PICKER
            ============================ */
            flatpickr("#maintenanceMonthPicker", {
                plugins: [
                    new monthSelectPlugin({
                        shorthand: true,
                        dateFormat: "m/Y",
                        altFormat: "F Y"
                    })
                ],
                defaultDate: new Date(),

                onChange: function (selectedDates) {
                    let selected = selectedDates[0];
                    selectedChartMonth = selected.getMonth() + 1;
                    selectedChartYear = selected.getFullYear();

                    loadMaintenanceChartData(selectedChartMonth, selectedChartYear);
                }
            });

            /* ===========================
               ✅ FIRST AUTO LOAD (CURRENT MONTH)
            ============================ */
            let now = new Date();
            selectedChartMonth = now.getMonth() + 1;
            selectedChartYear = now.getFullYear();

            loadMaintenanceChartData(selectedChartMonth, selectedChartYear);

            /* ===========================
               ✅ WING DROPDOWN CHANGE
            ============================ */
            $("#wingSelect").change(function () {
                updateChartsFromDropdown();
            });
        });


        /* ===========================
               ✅ LOAD CHART DATA (AJAX)
        ============================ */
        function loadMaintenanceChartData(month, year) {

            $.ajax({
                url: '/AccountManager/MaintenanceStatusChart',
                type: 'GET',
                data: { month: month, year: year },

                success: function (data) {

                    if (data && data.length > 0) {

                        let wingDropdown = $("#wingSelect");
                        wingDropdown.empty();

                        $.each(data, function (i, item) {
                            wingDropdown.append(
                                $("<option>", { value: item.WingId, text: item.WingName })
                            );
                        });

                        let allWings = data.find(x => x.WingId == 4 || x.WingName === 'ALL WINGS');

                        if (allWings) {
                            $("#wingSelect").val(allWings.WingId);
                            updateCharts(allWings);
                        } else {
                            $("#wingSelect").val(data[0].WingId);
                            updateCharts(data[0]);
                        }

                        $("#wingSelect").data("chartData", data);
                    }
                }
            });
        }


        /* ===========================
               ✅ WING CHANGE HANDLER
        ============================ */
        function updateChartsFromDropdown() {

            let selectedWingId = $("#wingSelect").val();
            let data = $("#wingSelect").data("chartData");

            if (!data) return;

            let selectedData = data.find(x => x.WingId == selectedWingId);
            updateCharts(selectedData);
        }


        /* ===========================
               ✅ FINAL CHART DRAW + CLICK EVENTS
        ============================ */
        function updateCharts(item) {

            /* =============================
               ✅ MONTHLY DONUT
            ============================== */

            $("#monthlyTotalAmount").text(Number(item.TotalMonthlyMaintenanceAmount || 0).toFixed(2));
            $("#monthlyPendingAmount").text(Number(item.MonthlyPendingAmount || 0).toFixed(2));
            $("#monthlyPenaltyAmount").text(Number(item.TotalMonthlyPenaltyAmount || 0).toFixed(2));

            if (monthlyMaintenanceChart) monthlyMaintenanceChart.destroy();

            monthlyMaintenanceChart = new Chart(
                document.getElementById('monthlyMaintenanceChart'),
                {
                    type: 'doughnut',
                    data: {
                        labels: ['Paid Amount', 'Pending Amount', 'Penalty Amount'],
                        datasets: [{
                            data: [
                                Number(item.MonthlyPaidAmount || 0),
                                Number(item.MonthlyPendingAmount || 0),
                                Number(item.TotalMonthlyPenaltyAmount || 0)
                            ],
                            backgroundColor: ['#03045e', '#0077b6', '#d00000'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: false,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        animation: false,
                        plugins: {
                            legend: {
                                labels: {
                                    color: "#000000",
                                    font: {
                                        size: 10,
                                        weight: "bold"
                                    }
                                }
                            }
                        },

                        onClick: function (evt, elements) {
                            if (elements.length > 0) {
                                let index = elements[0].index;
                                let status = index === 0 ? "paid" : index === 1 ? "pending" : "penalty";

                                let wingId = $("#wingSelect").val();

                                loadMemberList(
                                    status,
                                    wingId,
                                    selectedChartMonth,
                                    selectedChartYear,
                                    "monthly"
                                );
                            }
                        }
                    }
                }
            );


            /* =============================
               ✅ OCCASIONAL DONUT
            ============================== */

            $("#occasionalTotalAmount").text(Number(item.TotalOccasionalMaintenanceAmount || 0).toFixed(2));
            $("#occasionalPendingAmount").text(Number(item.OccasionalPendingAmount || 0).toFixed(2));

            if (occasionalMaintenanceChart) occasionalMaintenanceChart.destroy();

            let occPaid = Number(item.OccasionalPaidAmount || 0);
            let occPending = Number(item.OccasionalPendingAmount || 0);

            if (occPaid > 0 || occPending > 0) {

                occasionalMaintenanceChart = new Chart(
                    document.getElementById('occasionalMaintenanceChart'),
                    {
                        type: 'doughnut',
                        data: {
                            labels: ['Paid Amount', 'Pending Amount'],
                            datasets: [{
                                data: [occPaid, occPending],
                                backgroundColor: ['#03045e', '#0077b6'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: false,
                            maintainAspectRatio: false,
                            cutout: '65%',
                            animation: false,
                            plugins: {
                                legend: {
                                    labels: {
                                        color: "#000000",
                                        font: {
                                            size: 10,
                                            weight: "bold"
                                        }
                                    }
                                }
                            },

                            onClick: function (evt, elements) {
                                if (elements.length > 0) {

                                    let index = elements[0].index;
                                    let status = index === 0 ? "paid" : "pending";

                                    let wingId = $("#wingSelect").val();

                                    loadMemberList(
                                        status,
                                        wingId,
                                        selectedChartMonth,
                                        selectedChartYear,
                                        "occasional"
                                    );
                                }
                            }
                        }
                    }
                );
            }
        }


        /* ===========================
               ✅ MODAL OPEN WITH CORRECT MONTH DATE
        ============================ */
        function loadMemberList(type, wingId, month, year, maintenanceType) {

            let maintenanceTypeId = maintenanceType === "monthly" ? 59 : 58;

            $("#maintenanceModalTitle").text(
                maintenanceType.toUpperCase() + " " + type.toUpperCase() + " MEMBERS"
            );

            // ✅✅✅ FIX 1: STATUS SET PROPERLY
            var currentStatus = type.toUpperCase();   // PAID / PENDING / PENALTY
            $('#memberStatus').val(currentStatus);

            var modal = new bootstrap.Modal(document.getElementById("maintenanceModal"));
            modal.show();

            $("#maintenanceModalContent").html(`
               <div class="text-center p-4">
                   <div class="spinner-border text-primary"></div>
                   <p class="mt-2">Loading...</p>
               </div>
           `);

            let selectedMonthIndex = month - 1;

            let isCurrentMonth =
                selectedMonthIndex === new Date().getMonth() &&
                year === new Date().getFullYear();

            let fromDate, toDate;

            if (isCurrentMonth) {
                fromDate = moment().startOf('month').format('YYYY-MM-DD');
                toDate = moment().format('YYYY-MM-DD');
            } else {
                fromDate = moment(new Date(year, selectedMonthIndex, 1)).startOf('month').format('YYYY-MM-DD');
                toDate = moment(new Date(year, selectedMonthIndex, 1)).endOf('month').format('YYYY-MM-DD');
            }

            loadMaintenanceMembersData(type, wingId, month, year, maintenanceTypeId, fromDate, toDate);

            // ✅✅✅ FIX 2: CALL AFTER STATUS IS SET
            setTimeout(function () {
                togglePaymentModeFilter(type);

            }, 300);
        }



        function togglePaymentModeFilter(type) {

            var status = type.toUpperCase();   // ✅ TRUST ONLY CHART CLICK VALUE

            console.log("✅ Payment Filter Status =", status);

            if (status === "PAID") {
                $('#paymentModeWrapper').show();
            } else {
                $('#paymentModeWrapper').hide();
                $('#paymentModeFilter').val('').trigger('change');
            }
        }


        /* ===========================
               ✅ SERVER SIDE LOAD
        ============================ */
        function loadMaintenanceMembersData(type, wingId, month, year, maintenanceTypeId, fromDate, toDate) {

            console.log("✅ API HIT →", type, wingId, month, year, maintenanceTypeId, fromDate, toDate);

            $('#maintenanceModalContent').load(
                '/AccountManager/GetMaintenanceMemberListYP' +
                '?status=' + type +
                '&wingId=' + wingId +
                '&month=' + month +
                '&year=' + year +
                '&maintenanceTypeId=' + maintenanceTypeId +
                '&fromDate=' + fromDate +
                '&toDate=' + toDate,

                function () {

                    // 🔹 Date Range Button
                    togglePaymentModeFilter(type);

                    // 🔹 Date Range Picker Init
                    initModalDateRange(type, wingId, month, year, maintenanceTypeId);

                    // 🔹 Column hide logic
                    waitForDataTableAndToggleByName(maintenanceTypeId);

                    // 🔹 NOW INIT DATATABLE (MOST IMPORTANT)

                }
            );

        }


        function toggleMaintenanceColumns_ByName(maintenanceTypeId) {

            console.log("✅ toggleMaintenanceColumns_ByName CALLED");
            console.log("✅ maintenanceTypeId =", maintenanceTypeId);

            if (!$.fn.DataTable.isDataTable('#dueDataTable')) {
                console.log("❌ DataTable NOT initialized yet.");
                return;
            }

            var table = $('#dueDataTable').DataTable();

            var headers = table.columns().header().toArray();

            // ✅ Auto-detect all required columns
            var dueDateIndex = headers.findIndex(h => h.innerText.trim() === "Maintenance Due Date");
            var penaltyIndex = headers.findIndex(h => h.innerText.trim() === "Penalty Amount");
            var pendingIndex = headers.findIndex(h => h.innerText.trim() === "Pending Amount"); // ✅ NEW

            console.log("✅ Auto Found Due Date Index:", dueDateIndex);
            console.log("✅ Auto Found Penalty Index:", penaltyIndex);
            console.log("✅ Auto Found Pending Index:", pendingIndex);

            if (maintenanceTypeId == 58) {
                console.log("🔴 OCCASIONAL → HIDING COLUMNS");

                if (dueDateIndex !== -1) table.column(dueDateIndex).visible(false);
                if (penaltyIndex !== -1) table.column(penaltyIndex).visible(false);
                if (pendingIndex !== -1) table.column(pendingIndex).visible(false); // ✅ NEW

            } else {
                console.log("🟢 MONTHLY → SHOWING COLUMNS");

                if (dueDateIndex !== -1) table.column(dueDateIndex).visible(true);
                if (penaltyIndex !== -1) table.column(penaltyIndex).visible(true);
                if (pendingIndex !== -1) table.column(pendingIndex).visible(true); // ✅ NEW
            }

            console.log("✅ Column toggle by NAME completed.");
        }





        function waitForDataTableAndToggleByName(maintenanceTypeId) {

            var retryCount = 0;
            var maxRetries = 20;

            var checkInterval = setInterval(function () {

                if ($.fn.DataTable.isDataTable('#dueDataTable')) {

                    console.log("✅ DataTable Initialized — Now toggling columns");
                    clearInterval(checkInterval);

                    toggleMaintenanceColumns_ByName(maintenanceTypeId);
                }

                retryCount++;

                if (retryCount >= maxRetries) {
                    console.log("❌ DataTable still not initialized after waiting.");
                    clearInterval(checkInterval);
                }

            }, 300);
        }





        function initModalDateRange(type, wingId, month, year, maintenanceTypeId) {

            if (!$('.daterange-btn').length) {
                console.log("❌ daterange-btn not found inside partial");
                return;
            }

            $('.daterange-btn').daterangepicker({
                autoUpdateInput: false,
                opens: 'right',
                startDate: moment().startOf('month'),
                endDate: moment(),
                locale: {
                    format: 'DD-MM-YYYY',
                    cancelLabel: 'Clear'
                }
            });

            // ✅ APPLY CLICK
            $('.daterange-btn')
                .off('apply.daterangepicker')
                .on('apply.daterangepicker', function (ev, picker) {

                    let fromDate = picker.startDate.format('YYYY-MM-DD');
                    let toDate = picker.endDate.format('YYYY-MM-DD');

                    // ✅✅✅ VERY IMPORTANT → SET HIDDEN FIELDS INSIDE PARTIAL
                    $('#fromDate').val(fromDate);
                    $('#toDate').val(toDate);

                    $(this).find('span').text(
                        picker.startDate.format('DD-MM-YYYY') +
                        ' - ' +
                        picker.endDate.format('DD-MM-YYYY')
                    );

                    // ✅✅✅ RELOAD PARTIAL WITH NEW DATE RANGE
                    loadMaintenanceMembersData(
                        type,
                        wingId,
                        month,
                        year,
                        maintenanceTypeId,
                        fromDate,
                        toDate
                    );
                });

            // ✅ CANCEL / CLEAR
            $('.daterange-btn')
                .off('cancel.daterangepicker')
                .on('cancel.daterangepicker', function () {

                    $(this).find('span').text('Choose Date');

                    let fromDate = moment().startOf('month').format('YYYY-MM-DD');
                    let toDate = moment().format('YYYY-MM-DD');

                    $('#fromDate').val(fromDate);
                    $('#toDate').val(toDate);

                    loadMaintenanceMembersData(
                        type,
                        wingId,
                        month,
                        year,
                        maintenanceTypeId,
                        fromDate,
                        toDate
                    );
                });
        }


        $(document).on('click', '[data-bs-dismiss="modal"]', function () {
            $('#maintenanceModal').modal('hide');
        });




    </script>



