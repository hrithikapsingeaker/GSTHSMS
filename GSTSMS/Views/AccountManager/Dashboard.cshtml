    $(window).on('load', function () {
        $('#listLoader').fadeOut(300);
    });






    // ================== BANK BALANCE LIST (HOVER CARD) ==================
    document.addEventListener("DOMContentLoaded", function () {
        fetch('/AccountManager/GetbankBalanceList')
            .then(response => response.json())
            .then(res => {
                if (res.status === "success") {
                    const bankList = res.data;
                    const ul = document.querySelector("#bankBalanceList");

                    ul.innerHTML = "";

                    if (bankList.length > 0) {
                        bankList.forEach(bank => {
                            const li = document.createElement("li");

                            li.style.background = "linear-gradient(145deg, #d1c4e9, #b39ddb)";
                            li.style.color = "black";
                            li.style.margin = "8px auto";
                            li.style.padding = "10px 15px";
                            li.style.borderRadius = "12px";
                            li.style.width = "90%";
                            li.style.boxShadow = "6px 6px 12px rgba(0,0,0,0.2), -4px -4px 10px rgba(255,255,255,0.1)";
                            li.style.display = "flex";
                            li.style.justifyContent = "space-between";
                            li.style.alignItems = "center";
                            li.style.transition = "all 0.3s ease";

                            li.onmouseover = function () {
                                this.style.transform = "translateY(-4px) scale(1.02)";
                                this.style.boxShadow = "8px 8px 18px rgba(0,0,0,0.3), -5px -5px 15px rgba(255,255,255,0.15)";
                            };
                            li.onmouseout = function () {
                                this.style.transform = "translateY(0) scale(1)";
                                this.style.boxShadow = "6px 6px 12px rgba(0,0,0,0.2), -4px -4px 10px rgba(255,255,255,0.1)";
                            };

                            li.innerHTML = `
                                <span>
                                    <i class="fas fa-university"></i> ${bank.BankShortCode}
                                    <span class="balance d-none"> : ₹${parseFloat(bank.OpeningBalance).toLocaleString('en-IN', {
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    })}
</span>
                                </span>
                                <button class="btn btn-sm toggle-balance"
                                        style="color: white; background: rgba(255,255,255,0.15); border-radius: 8px; padding: 4px 8px;">
                                    <i class="fas fa-eye"></i>
                                </button>
                            `;

                            li.querySelector(".toggle-balance").addEventListener("click", function () {
                                const balanceEl = li.querySelector(".balance");
                                balanceEl.classList.toggle("d-none");

                                const icon = this.querySelector("i");
                                if (balanceEl.classList.contains("d-none")) {
                                    icon.classList.remove("fa-eye-slash");
                                    icon.classList.add("fa-eye");
                                } else {
                                    icon.classList.remove("fa-eye");
                                    icon.classList.add("fa-eye-slash");
                                }
                            });

                            ul.appendChild(li);
                        });
                    } else {
                        ul.innerHTML = `<li class="text-muted">No banks found.</li>`;
                    }
                } else {
                    console.error(res.message);
                }
            })
            .catch(err => {
                console.error("Fetch error:", err);
            });
    });






    // ================== RED LIST MEMBERS ==================
    async function loadRedListMembers() {
        try {
            const response = await fetch('/AccountManager/GetTop5RedListMembers');
            const result = await response.json();

            const tbody = document.getElementById('redListBody');
            tbody.innerHTML = '';

            if (result.status === 'success') {
                const data = result.data;
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="10">No data available.</td></tr>';
                } else {
                    data.forEach((item, index) => {
                        tbody.innerHTML += `
                            <tr style="height: 25px; font-size: 13px; color: black; text-align: center;">
                                <td>${index + 1}</td>
                                <td style="color:black;">${item.FullName}</td>
                                <td style="color:black;">${item.FlatCode}</td>
                                <td style="color:black;">₹${item.MaintenanceAmount}</td>
                                <td style="color:black;">${item.MonthsPending}</td>
                                <td style="color:black;">₹${item.PendingAmount}</td>
                                <td style="color:black;">${item.PenaltyPercent}%</td>
                                <td style="color:black;">${item.GraceDate ? item.GraceDate.split(' ')[0] : ''}</td>
                                <td style="color:black;">₹${item.PenaltyAmount}</td>
                                <td style="color:black;">₹${item.FinalPayable}</td>
                            </tr>
                        `;
                    });
                }
            } else {
                tbody.innerHTML = `<tr><td colspan="10">${result.message}</td></tr>`;
            }
        } catch (err) {
            document.getElementById('redListBody').innerHTML = `<tr><td colspan="10">Error loading data.</td></tr>`;
        }
    }
    document.addEventListener("DOMContentLoaded", loadRedListMembers);
    </script>

