    //Delete Button Code
$(document).on('click', '.delete-budget', function () {
    const $button = $(this);
    const eBudgetCode = $button.data('ebudgetcode');

    swal({
        title: "Are you sure?",
        text: "This action cannot be undone!",
        icon: "warning",
        buttons: ["Cancel", "Yes, delete it!"],
        dangerMode: true
    }).then(function (willDelete) {
        if (willDelete) {
            $.ajax({
                url: '@Url.Action("DeleteBudget", "AccountManager")',
                type: 'POST',
                data: { eBudgetCode: eBudgetCode },
                success: function (response) {
                    if (response.success) {
                        swal({
                            title: "Deleted!",
                            text: "Event budget deleted successfully.",
                            icon: "success",
                            buttons: false,
                            timer: 3000 // ✅ Only success alert auto-closes
                        });
                        $button.closest('tr').fadeOut(300, function () {
                            $(this).remove();
                        });
                    } else {
                        swal({
                            title: "Failed",
                            text: response.message || "Delete failed.",
                            icon: "error",
                            buttons: true // ❌ This will stay until user clicks
                        });
                    }
                },
                error: function () {
                    swal({
                        title: "Error",
                        text: "An error occurred while deleting.",
                        icon: "error",
                        buttons: true // ❌ This will stay until user clicks
                    });
                }
            });
        }
    });
});





