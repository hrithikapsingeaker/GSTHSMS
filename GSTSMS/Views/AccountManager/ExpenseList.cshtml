`;
                            $(win.document.head).append(style);
                        },

                        action: function (e, dt, button, config) {
                            if ($('.row-checkbox:checked').length === 0) {
                                iziToast.warning({ title: 'No row selected', message: 'Please select at least one row to print.', position: 'topCenter' });
                                return;
                            }

                            $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);

                            // Clear checkboxes after print
                            setTimeout(() => {
                                dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                                $('#select-all').prop('checked', false);
                            }, 100);

                            setTimeout(() => {
                                swal({ icon: 'success', title: 'Printed!', text: 'Print view generated successfully.', buttons: false, timer: 2000 });
                            }, 500);
                        }
                    },

                    {

                        text: '<img src="/Content/img/icons8-refresh-50.png" alt="Refresh" style="height:28px;" title="Refresh Table" />',
                        className: 'export-buttons icon-only-btn',
                        action: function (e, dt, node, config) {
                            // Get the refresh button image
                            var refreshIcon = $(node).find('img');

                            // Add spin class to trigger animation
                            refreshIcon.addClass('spin');

                            // Remove spin class after animation completes
                            setTimeout(function () {
                                refreshIcon.removeClass('spin');
                            }, 500);

                            // Clear search filters
                            dt.search('').columns().search('').draw();

                            // Reset dropdown filters
                            $('#wingFilter').val('');
                            $('#statusFilter').val('');
                            $('#expenseTypeFilter').val('');

                            // Reset checkboxes
                            $('#select-all').prop('checked', false);
                            $('.row-checkbox').prop('checked', false);

                            // Reset date range picker to current month
                            const start = moment().startOf('month');
                            const end = moment();
                            $('#fromDate').val(start.format('DD-MM-YYYY'));
                            $('#toDate').val(end.format('DD-MM-YYYY'));
                            $('.daterange-btn span').html(start.format('DD-MM-YYYY') + ' - ' + end.format('DD-MM-YYYY'));


                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-all').prop('checked', false);

                            // Redraw table
