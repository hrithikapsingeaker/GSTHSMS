@model IEnumerable<GSTSMSLibrary.AccountManager.AccountManager>
@{
    ViewBag.Title = "All Expenses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" />
    <link rel="stylesheet" href="~/Content/css/ExpenseDD.css" />
    <link href="~/Content/css/ExpensePNS.css" rel="stylesheet" />

}


<style>

    .status-cell.paid {
        color: green !important;
        font-weight: 600;
    }

    .status-cell.unpaid {
        color: red !important;
        font-weight: 600;
    }

    .status-cell.pending {
        color: blue !important;
        font-weight: 600;
    }


    /* Remove default background + border on normal and hover */
    button.dt-print-btn,
    button.dt-print-btn:hover,
    button.dt-print-btn:focus {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }

        /* Ensure icon cursor looks clickable */
        button.dt-print-btn img {
            cursor: pointer;
            margin-left: -13px;
        }

    /* White Spinning Loader */
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7); /* Semi-transparent black background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader {
        width: 50px;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 8px solid;
        border-color: white transparent; /* White spinner with transparent middle */
        animation: spin 1s infinite linear;
    }

    @@keyframes spin {
        to {
            transform: rotate(0.5turn);
        }
    }


    /* Add to your existing style section */
    .btn-spin {
        transition: transform 0.5s ease;
    }

    .spin {
        animation: spin 0.5s linear 1;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .section {
        position: relative;
        margin-top: -135px;
    }
</style>


<div class="loader-overlay" id="listLoader">
    <div class="loader"></div>
</div>



<section class="section">
    <div class="section-header d-flex justify-content-between align-items-center mb-4 px-3">
        <div class="flex-grow-1 text-center">
            <h1 class="mb-0">Expense List</h1>
        </div>

        <div class="btnlist d-flex" style="margin-bottom:-252px !important; margin-right:-13px !important">
            <button class="btn btn-primary mr-2" id="btnRegisterVendor">
                <i class="fa fa-plus"></i> Register Vendor
            </button>
            <button class="btn btn-success" id="btnAddExpense">
                <i class="fa fa-plus"></i> Add Expense
            </button>
        </div>
    </div>

    <div class="section-body">





        <!-- 🔍 Filters in One Row - Original Structure -->
        <div class="row justify-content-center mb-3" id="filterRow" style="margin-top:-30px !important">
            <div class="col-md-3">
                <label class="filter-active" for="wingFilter"></label>
                <select id="wingFilter" class="form-control">
                    <option value="">-- All Wings --</option>
                    @foreach (var wing in Model.Select(m => m.WingName).Distinct())
                    {
                        <option value="@wing">@wing</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="filter-active" for="statusFilter"></label>
                <select id="statusFilter" class="form-control">
                    <option value="">-- All Status --</option>
                    <option value="Paid">Paid</option>
                    <option value="Unpaid">Unpaid</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="filter-active" for="expenseTypeFilter"></label>
                <select id="expenseTypeFilter" class="form-control">
                    <option value="">-- All Types --</option>
                    <option value="Direct">Direct</option>
                    <option value="Indirect">Indirect</option>
                </select>
            </div>
        </div>


    </div>
    <div class="row align-items-center mb-3">
        <div class="form-group col-md-2">
            <label style="font-size: 12px;"></label>
            <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon form-control" style="font-size: 12px; height:35px ; width:200px; padding: 4px 6px;">
                <i class="fas fa-calendar"></i> <span>Select Date</span>
            </a>
            <input type="hidden" id="fromDate" />
            <input type="hidden" id="toDate" />
        </div>
    </div>





    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table id="expenseTable" class="table table-bordered table-striped ">
                <thead class="headertable">
                    <tr>
                        <th><input type="checkbox" id="select-all" /></th>
                        <th>Sr.No</th>
                        <th>Vendor Name</th>
                        <th>Wing Name</th>

                        <th>Expense Type</th>
                        @*<th>Status</th>*@
                        <th>Expense Name</th>
                        @*@
                            <th>Wing Name</th>
                            @*@
                        @*<th>Description</th>*@
                        <th>AddedDate</th>
                        <th>Total Amount(₹)</th>
                        <th>Paid Amount(₹)</th>
                        <th>Remaining Amount(₹)</th>

                        <th>Status</th>


                        @*@
                            <th>IFSCCode</th>
                            @*@
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var srNo = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="row-checkbox" /></td>
                            <td class="sr-no">@srNo</td>
                            <td style="width:75px !important" title="@item.VendorName">@item.VendorName</td>
                            <td title="@item.WingName">@item.WingName</td>

                            <td title="@item.ExpenseType">@item.ExpenseType</td>
                            @*<td style="width:30px !important" title="@item.StatusName"
                                            class="status-cell @(item.StatusName.ToLower() == "paid" ? "paid" :
                                (item.StatusName.ToLower() == "unpaid" ? "unpaid" :
                                (item.StatusName.ToLower() == "pending" ? "pending" : "")))">
                                            @item.StatusName
                                        </td>*@



                            <td style="width:80px!important" title="@item.ExpenseName">@item.ExpenseName</td>
                            @*@
                                <td title="@item.WingName">@item.WingName</td>
                                @*@
                            @*<td style="width:60px !important" title="@item.Description">@item.Description</td>*@
                            <td title="@item.AddedDate">@item.AddedDate.ToString("dd-MM-yyyy")</td>
                            <td title="@item.TotalAmount">₹@item.TotalAmount</td>
                            <td title="@item.PaidAmount">₹@item.PaidAmount</td>
                            <td title="@item.RemainingAmount">₹@item.RemainingAmount</td>
                            <td style="width:20px !important" title="@item.StatusName"
                                class="status-cell @(item.StatusName.ToLower() == "paid" ? "paid" :
(item.StatusName.ToLower() == "unpaid" ? "unpaid" :
(item.StatusName.ToLower() == "pending" ? "pending" : "")))">
                                @item.StatusName
                            </td>

                            <td>
                                @* View button logic *@
                                @if (item.StatusId == 11)
                                {
                                    <a href="javascript:void(0);" title="View" style="pointer-events: none; opacity: 0.5;">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:void(0);" onclick="viewExpenseDetails('@item.ExpenseCode')" title="View">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                }

                                &nbsp;

                                @* Pay button logic *@
                                @if (item.StatusId == 10)
                                {
                                    <button class="btn btn-sm btn-pay-green" style="pointer-events: none; opacity: 0.5;">Pay</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-pay-green" onclick="openIFSCModal('@item.ExpenseCode')">Pay</button>
                                }
                            </td>

                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No records found.</p>
    }


</section>

<!-- Modal Containers -->
<div id="ifscModalContainer"></div>
<div id="expenseDetailsContainer"></div>
<div class="modal fade" id="vendorModal" tabindex="-1" role="dialog"></div>
<div class="modal fade" id="addExpenseModal" tabindex="-1" role="dialog"></div>
@section Scripts {
    <script src="~/Content/modules/moment.min.js"></script>
    <script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
    <link href="~/Content/modules/izitoast/css/iziToast.min.css" rel="stylesheet" />
    <script src="~/Content/modules/izitoast/js/iziToast.js"></script>
    <link href="~/Content/modules/izitoast/css/iziToast.css" rel="stylesheet" />
    <link href="~/Content/modules/datatables/datatables.css" rel="stylesheet" />
    <script src="~/Content/modules/datatables/datatables.js"></script>
    <link href="~/Content/modules/datatables/datatables.min.css" rel="stylesheet" />
    <script src="~/Content/modules/datatables/datatables.min.js"></script>
    <script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>


    <script>


        // Show loader when page is loading
        $(window).on('load', function () {
            $('#listLoader').fadeOut(300);
        });

        // Optional: Also hide loader when table is fully drawn
        $(document).ready(function () {
            $('#expenseTable').on('draw.dt', function () {
                $('#listLoader').fadeOut(300);
            });
        });


        // ✅ Refresh Page Button
           $('#btnRefreshExpense').click(function () {
          location.reload(); // Full refresh
});


    $(document).ready(function () {
        $('#btnRefreshList').click(function () {
            $.ajax({
                url: '@Url.Action("AllExpensesListPartial", "Expense")',
                type: 'GET',
                success: function (data) {
                    $('#loadExpenseList').html(data);

                    // Reinitialize DataTable with export buttons
                    $('#table-export').DataTable({
                        dom: 'Bfrtip',
                        buttons: ['copy', 'csv', 'excel', 'pdf'],
                        responsive: true,
                        destroy: true
                    });
                },
                error: function () {
                    alert('Failed to refresh the list.');
                }
            });
        });
    });

        // Close modal function
        function closeModal() {
            if ($('#ifscModal').hasClass('show')) {
                $('#ifscModal').modal('hide');
            } else if ($('#expenseDetailsModal').hasClass('show')) {
                $('#expenseDetailsModal').modal('hide');
            }

        }

        $(document).ready(function () {
            // ✅ Date Range Picker Initialize
            function initializeDateRangePicker() {
                var displayFormat = 'DD-MM-YYYY';

                $('.daterange-btn').daterangepicker({
                    locale: { format: displayFormat },
                    ranges: {
                        'Today': [moment(), moment()],
                        'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                        'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                        'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                        'This Month': [moment().startOf('month'), moment().endOf('month')],
                        'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                    },
                    startDate: moment().startOf('month'),
                    endDate: moment()
                }, function (start, end) {
                    $('.daterange-btn span').html(start.format(displayFormat) + ' - ' + end.format(displayFormat));
                    $('#fromDate').val(start.format(displayFormat));
                    $('#toDate').val(end.format(displayFormat));
                    $('#expenseTable').DataTable().draw();
                });

                $('#fromDate').val(moment().startOf('month').format(displayFormat));
                $('#toDate').val(moment().format(displayFormat));
                $('.daterange-btn span').html(moment().startOf('month').format(displayFormat) + ' - ' + moment().format(displayFormat));
                $('#expenseTable').DataTable().draw(); // ✅ Force redraw based on current month

            }

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var min = $('#fromDate').val();
                var max = $('#toDate').val();
                var dateStr = data[6]; // This should be the index of your date column (8 for 'AddedDate')

                if (!min && !max) return true;
                if (!dateStr) return false;

                var rowDate = moment(dateStr, 'DD-MM-YYYY');
                var minDate = moment(min, 'DD-MM-YYYY');
                var maxDate = moment(max, 'DD-MM-YYYY');

                if (!rowDate.isValid()) return false;
                if (minDate && rowDate.isBefore(minDate, 'day')) return false;
                if (maxDate && rowDate.isAfter(maxDate, 'day')) return false;

                return true;
            });





            let table = $('#expenseTable').DataTable({
                dom: "<'row mb-2'<'col-md-6'B><'col-md-6 text-end'f>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row mt-2'<'col-md-5'i><'col-md-7 text-end'p>>",
                ordering: false,
                pageLength: 10,
                responsive: true,
                language: {
                    info: "Showing _START_ to _END_ of _TOTAL_ entries", // ✅ Removes bracket text
                    infoFiltered: "", // ✅ No "(filtered from ...)" part
                    infoEmpty: "No entries to show" // Optional when table is empty
                },
                buttons: [
                    {
                        extend: 'csvHtml5',
                        text: '<img src="/Content/img/icons8-csv-64.png" style="height:32px; margin-top:-4px;"  title="Export CSV" />',
                        className: 'transparent-btn',
                        title: null,
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('.row-checkbox').is(':checked');
                            },
                            columns: ':visible:not(:first-child):not(:last-child)'
                        },
                        customize: function (csv) {
                            const now = new Date();
                            const headerText = "Expense List";
                            const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour: '2-digit', minute: '2-digit', hour12: true
                            })}`;

                            let lines = csv.split('\n').filter(line => line.trim() !== '');
                            const header = lines[0].split(',');
                            header[0] = 'Sr. No';
                            lines[0] = header.join(',');

                            // Amount column indexes (adjust based on visible CSV)
                            const amountColumns = [1]; // change/add indexes if multiple amount columns exist

                            for (let i = 1; i < lines.length; i++) {
                                if (lines[i].trim() !== "") {
                                    const cols = lines[i].split(',');

                                    // Sr. No.
                                    cols[0] = i.toString();

                                    // Prepend ₹ to amount columns only if numeric
                                    for (let j = 0; j < cols.length; j++) {
                                        let cleanText = cols[j].replace(/['"]+/g, '').trim();

                                        if (amountColumns.includes(j) && cleanText && !isNaN(cleanText.replace(/,/g, ''))) {
                                            // Only prepend ₹ if the value is a number
                                            cleanText = '₹' + cleanText.replace(/,/g, '');
                                        }

                                        cols[j] = cleanText;
                                    }
                                }

                            }

                            // Add BOM for UTF-8 and prepend custom header
                            const spacingRow = new Array(header.length).fill('').join(',');
                            const centerText = (text) => {
                                const totalCols = header.length;
                                const row = new Array(totalCols).fill('');
                                row[Math.floor(totalCols / 2)] = text;
                                return row.join(',');
                            };

                            return '\uFEFF' + `${centerText(headerText)}\n${centerText(timestamp)}\n${spacingRow}\n${lines.join('\n')}`;
                        },
                        filename: function () {
                            const now = new Date();
                            return 'ExpenseList_' + now.toLocaleDateString('en-GB').replace(/\//g, '-') + '_' +
                                now.getHours().toString().padStart(2, '0') + now.getMinutes().toString().padStart(2, '0');
                        },
                        action: function (e, dt, button, config) {
                            var selected = dt.rows().nodes().to$().find('.row-checkbox:checked');
                            if (selected.length === 0) {
                                iziToast.warning({ title: 'Warning', message: 'Please select at least one row to export CSV.', position: 'topCenter' });
                                return;
                            }

                            $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);

                            // Clear checkboxes immediately after export
                            setTimeout(() => {
                                dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                                $('#select-all').prop('checked', false);
                            }, 100);

                            swal({ icon: 'success', title: 'CSV Exported', text: 'Your CSV file has been downloaded successfully!', timer: 2000, buttons: false });
                        }

                    },

                    {
                        extend: 'excelHtml5',
                        text: '<img src="/Content/img/icons8-xls-64.png" style="height:32px;" title="Export Excel" />',
                        className: 'export-buttons icon-only-btn',
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('input.row-checkbox').is(':checked');
                            },
                            columns: ':visible:not(:first-child):not(:last-child)'
                        },
                        customizeData: function (data) {
                            let sr = 1;
                            data.body.forEach(function (row) {
                                row[0] = sr++;
                            });

                            const now = new Date();
                            const society = "Green Valley Society - Expense List";
                            const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour: '2-digit', minute: '2-digit', hour12: true
                            })}`;

                            const totalCols = data.header.length;
                            const getCenteredRow = (text) => {
                                const row = new Array(totalCols).fill('');
                                row[Math.floor(totalCols / 2)] = text;
                                return row;
                            };

                            data.body.unshift(data.header);
                            data.header = getCenteredRow(society);
                            data.body.unshift(getCenteredRow(timestamp));
                        },
                        customize: function (xlsx) {
                            let sheet = xlsx.xl.worksheets['sheet1.xml'];

                            // Style index: 51 = centered text in Excel
                            $('row c', sheet).attr('s', '51'); // Apply center to all cells

                            // Make column headers bold and center them
                            $('row:nth-child(3) c', sheet).attr('s', '51');

                            // Optional: Adjust column width
                            // $('cols col', sheet).attr('width', 25);
                        },
                        filename: function () {
                            const now = new Date();
                            return 'ExpenseList_' + now.toLocaleDateString('en-GB').replace(/\//g, '-') + '_' +
                                now.getHours().toString().padStart(2, '0') + now.getMinutes().toString().padStart(2, '0');
                        },
                        action: function (e, dt, button, config) {
                            if ($('.row-checkbox:checked').length === 0) {
                                iziToast.warning({ title: 'No row selected', message: 'Please select at least one row to export.', position: 'topCenter' });
                                return;
                            }

                            $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);

                            // Clear checkboxes immediately after export
                            setTimeout(() => {
                                dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                                $('#select-all').prop('checked', false);
                            }, 100);

                            setTimeout(() => {
                                swal({ icon: 'success', title: 'Exported!', text: 'Excel generated successfully.', buttons: false, timer: 2000 });
                            }, 500);
                        }


                    },


                    {
                        extend: 'pdfHtml5',
                        text: '<img src="/Content/img/icons8-pdf-64.png" alt="PDF" style="height:32px;" title="Export PDF" />',
                        className: 'export-buttons icon-only-btn',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('input.row-checkbox').is(':checked');
                            },
                            columns: ':visible:not(:first-child):not(:last-child)'
                        },
                        customize: function (doc) {
                            const now = new Date();
                            const formatted = now.toLocaleString('en-IN', {
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour: '2-digit', minute: '2-digit', hour12: true
                            });

                            // Header text
                            doc.content.unshift({
                                alignment: 'center',
                                margin: [0, 0, 0, 12],
                                text: [
                                    { text: 'Green Valley Society - Expense List\n', fontSize: 18, bold: true },
                                    { text: 'Generated on: ' + formatted + '\n\n', fontSize: 12, italics: true }
                                ]
                            });

                            const tableContent = doc.content.find(obj => obj.table);

                            if (tableContent) {
                                const colCount = tableContent.table.body[0].length;

                                // 🔄 Flexible column widths
                                tableContent.table.widths = Array(colCount).fill('*');

                                // 🔄 Center all cell content
                                tableContent.table.body.forEach((row, rowIndex) => {
                                    // Auto-generate serial number for first column
                                    if (rowIndex > 0) {
                                        row[0].text = rowIndex.toString();
                                    }

                                    row.forEach((cell, colIndex) => {
                                        if (typeof cell === 'object') {
                                            cell.alignment = 'center';
                                            // Style header row
                                            if (rowIndex === 0) {
                                                cell.fillColor = '#615677'; // Dark green
                                                cell.color = 'white';
                                                cell.bold = true;
                                            }
                                        } else {
                                            row[colIndex] = { text: cell, alignment: 'center' };
                                        }
                                    });
                                });

                                // 🎯 Table layout
                                tableContent.layout = {
                                    hLineWidth: () => 0.4,
                                    vLineWidth: () => 0.4,
                                    hLineColor: () => '#aaa',
                                    vLineColor: () => '#aaa',
                                    paddingLeft: () => 5,
                                    paddingRight: () => 5,
                                    paddingTop: (rowIndex) => rowIndex === 0 ? 4 : 3,
                                    paddingBottom: (rowIndex) => rowIndex === 0 ? 4: 3
                                };

                                // ✅ Wrap in centered container to center the table on the page
                                const wrapper = {
                                    alignment: 'center',
                                    table: tableContent.table,
                                    layout: tableContent.layout
                                };

                                const index = doc.content.indexOf(tableContent);
                                if (index !== -1) {
                                    doc.content[index] = wrapper;
                                }
                            }

                            // 🖋 Default styles
                            doc.defaultStyle.fontSize = 8;
                            doc.styles.tableHeader.fontSize = 9;
                            doc.styles.tableHeader.bold = true;
                            doc.styles.tableHeader.alignment = 'center';
                            doc.styles.tableHeader.fillColor = '#615677';
                            doc.styles.tableHeader.color = '#ffffff';
                        },
                        action: function (e, dt, button, config) {
                            if ($('.row-checkbox:checked').length === 0) {
                                iziToast.warning({ title: 'No row selected', message: 'Please select at least one row to export.', position: 'topCenter' });
                                return;
                            }

                            $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);

                            // Clear checkboxes immediately after export
                            setTimeout(() => {
                                dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                                $('#select-all').prop('checked', false);
                            }, 100);

                            setTimeout(() => {
                                swal({ icon: 'success', title: 'Exported!', text: 'PDF generated successfully.', buttons: false, timer: 2000 });
                            }, 500);
                        }


                    },
                    {
                        extend: 'print',
                        title: '',
                        text: '<img src="/Content/img/icons8-print-100.png" alt="PDF" style="height:32px;" title="Print Expense List" />',
                        className: 'export-buttons icon-only-btn',

                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 8, 9, 10], // ✅ Excludes Payment (index 8), includes Status (index 10)
                            modifier: { search: 'applied', order: 'applied', page: 'all' },
                            rows: function (idx, data, node) {
                                const isChecked = $(node).find('input.row-checkbox').prop('checked');
                                const isActive = !$(node).hasClass('inactive-event');
                                return isChecked && isActive;
                            },
                            format: {
                                body: function (data, row, column, node) {
                                    if (column === 0) return (row + 1).toString(); // Serial number
                                    return $(node).text().trim();
                                }
                            }
                        },

                        customize: function (win) {
                            $(win.document.body).css('font-size', '10pt');

                            const now = new Date();
                            const day = now.getDate().toString().padStart(2, '0');
                            const month = (now.getMonth() + 1).toString().padStart(2, '0');
                            const year = now.getFullYear();
                            const hours = now.getHours() % 12 || 12;
                            const minutes = now.getMinutes().toString().padStart(2, '0');
                            const ampm = now.getHours() >= 12 ? 'PM' : 'AM';
                            const dateString = `${day}-${month}-${year}`;
                            const timeString = `${hours.toString().padStart(2, '0')}:${minutes} ${ampm}`;

                            $(win.document.body).prepend(
                                '<div style="text-align:center; margin-bottom:10px;">' +
                                '<h2>GREEN VALLEY SOCIETY : Expense List</h2>' +
                                '<p>Generated on: ' + dateString + ' ' + timeString + '</p>' +
                                '</div>'
                            );

                            $(win.document.body).find('table')
                                .addClass('compact print-table')
                                .css({ fontSize: 'inherit', textAlign: 'center', margin: '0 auto', borderCollapse: 'collapse' });

                            $(win.document.body).find('th, td')
                                .css({ border: '1px solid black', padding: '5px' });

                            $(win.document.body).find('caption, .print-hide').remove();

                            const style = document.createElement('style');
                            style.type = 'text/css';
                            style.innerHTML = `
