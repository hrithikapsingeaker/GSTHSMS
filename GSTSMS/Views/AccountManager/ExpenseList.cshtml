  function openIFSCModal(expenseCode) {
    // Show loader
    $('#listLoader').fadeIn(200);

    $.ajax({
        url: '@Url.Action("GetIFSCDetailsPS", "AccountManager")',
        type: 'GET',
        data: { expenseCode: expenseCode },
        success: function (result) {
            $("#ifscModalContainer").html(result);

            // Hide loader before showing modal
            $('#listLoader').fadeOut(200);

            $("#ifscModal").modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');
        },
        error: function () {
            $('#listLoader').fadeOut(200);
            alert("Error loading IFSC modal.");
        }
    });

}


        function fetchBankDetailsByIFSC() {
            var ifsc = $('#hdnIFSCCode').val();

            if (ifsc && ifsc !== "Not Available") {
                $.ajax({
                    url: "https://ifsc.razorpay.com/" + ifsc,
                    type: "GET",
                    success: function (data) {
                        $('#lblBankName').text(data.BANK || 'Not Available');
                        $('#lblBranchName').text(data.BRANCH || 'Not Available');
                    },
                    error: function () {
                        $('#lblBankName').text('Invalid IFSC');
                        $('#lblBranchName').text('-');
                    }
                });
            } else {
                $('#lblBankName').text('Not Available');
                $('#lblBranchName').text('Not Available');
            }
        }



      function viewExpenseDetails(expenseCode) {
    // Show loader
    $('#listLoader').fadeIn(200);

    $.ajax({
        url: '@Url.Action("GetExpenseDetailsPS", "AccountManager")',
        data: { expenseCode: expenseCode },
        success: function (result) {
            $("#expenseDetailsContainer").html(result);

            // Hide loader before showing modal
            $('#listLoader').fadeOut(200);

            // Show modal
            $("#expenseDetailsModal").modal({
                backdrop: 'static',
                keyboard: false
            }).modal('show');

            // ✅ Fetch Bank & Branch Name from Razorpay API
            fetchBankDetailsByIFSC();
        },
        error: function () {
            $('#listLoader').fadeOut(200);
            alert("Unable to load expense details.");
        }
    });
}







