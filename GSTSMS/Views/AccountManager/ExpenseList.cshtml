    ],
            pageLength: 10,
            responsive: true
            });


            table.on('draw.dt', function () {
                let info = table.page.info();
                table.column(1, { page: 'current' }).nodes().each(function (cell, i) {
                    cell.innerHTML = info.start + i + 1;
                });
            });


        // ✅ Custom Search
        $('#customSearch').on('keyup', function () {
            table.search(this.value).draw();
        });

        // Filter event handlers - MUST MATCH YOUR COLUMN INDEXES
        $('#wingFilter').on('change', function () {
            table.column(3).search(this.value).draw(); // Wing Name is column 6
        });

            // ✅ Status Filter (Paid / Unpaid)
            $('#statusFilter').on('change', function () {
                let val = $.fn.dataTable.util.escapeRegex($(this).val());
                table.column(10).search(val ? '^' + val + '$' : '', true, false).draw();
            });


            // ✅ Expense Type Filter (Direct / Indirect)
            $('#expenseTypeFilter').on('change', function () {
                let val = $.fn.dataTable.util.escapeRegex($(this).val());
                table.column(4).search(val ? '^' + val + '$' : '', true, false).draw();
            });


        // ✅ Export Trigger Buttons
        $('#exportExcel').on('click', function () {
            table.button('.buttons-excel').trigger();
        });
        $('#exportCSV').on('click', function () {
            table.button('.buttons-csv').trigger();
        });
        $('#exportPDF').on('click', function () {
            table.button('.buttons-pdf').trigger();
        });

        // ✅ Select All
        $('#select-all').on('click', function () {
            const checked = this.checked;
            $('.row-checkbox', table.rows({ search: 'applied' }).nodes()).prop('checked', checked);
        });

        // ✅ Initialize Date Picker at End
        initializeDateRangePicker();
