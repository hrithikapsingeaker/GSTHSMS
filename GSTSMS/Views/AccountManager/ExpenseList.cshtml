    // ✅ Add Expense form submit via AJAX
    $(document).off('submit', '#addExpenseForm').on('submit', '#addExpenseForm', function (e) {
    e.preventDefault();

    var form = $(this)[0];
    var formData = new FormData(form);

    $.ajax({
    url: $(this).attr('action'),
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    success: function (res) {
    if (res.success) {
    $('#addExpenseModal').modal('hide');
    alert("Expense saved successfully.");
    location.reload();
    } else {
    alert("Failed to save expense.");
    }
    },
    error: function () {
    alert("An error occurred while saving.");
    }
    });
    });













