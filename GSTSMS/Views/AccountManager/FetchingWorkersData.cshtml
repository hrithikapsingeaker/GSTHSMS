@using System.Globalization

@model IEnumerable<GSTSMSLibrary.AccountManager.AccountManager>

@{
    ViewBag.Title = "Worker Payment List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var exportTimestamp = DateTime.Now.ToString("dd-MM-yyyy hh:mm tt");
    var today = DateTime.Now;
    var isAfter10th = today.Day > 10;
    var currentDay = today.Day;
    var isBetween1stAnd10th = currentDay >= 1 && currentDay <= 10;
    var hasData = Model.Any();

    // Calculate previous month
    var previousMonth = DateTime.Now.AddMonths(-1);
    var previousMonthStart = new DateTime(previousMonth.Year, previousMonth.Month, 1);
    var previousMonthEnd = previousMonthStart.AddMonths(1).AddDays(-1);
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        swal({
            icon: 'success',
            title: 'Transaction Complete 🎉',
            text: '@TempData["SuccessMessage"]',
            confirmButtonColor: '#3085d6'
        });
    </script>
}

<div class="card" style="padding-bottom: 0 !important;">
    @*Loader overlay*@
    <div class="loader-overlay" id="listLoader">
        <div class="loader"></div>
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-center">
            <h4 class="page-title-custom">Worker Payment List</h4>
        </div>

        <div class="form-group mb-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon">
                    <i class="fas fa-calendar"></i> <span id="selectedRangeText">@previousMonthStart.ToString("dd-MM-yyyy") - @previousMonthEnd.ToString("dd-MM-yyyy")</span>
                </a>
            </div>

            <div class="filter-container">
                <label for="paymentStatusFilter" class="mb-0" style="font-weight: bold; margin-right: 8px ; color:black"> Payment Status :</label>
                <select id="paymentStatusFilter" class="form-control @(!hasData ? "disabled-filter" : "")">
                    <option value="">All Status </option>
                    <option value="Paid">Paid</option>
                    <option value="Unpaid">Unpaid</option>
                </select>
                <label for="roleFilter" class="mb-0" style="font-weight: bold; margin-right: 8px; margin-left :12px ; color:black">Role Filter:</label>
                <select id="roleFilter" class="form-control @(!hasData ? "disabled-filter" : "")">
                    <option value="">All Roles</option>
                    @if (hasData)
                    {
                        foreach (var role in Model.Select(m => m.RoleName).Distinct().OrderBy(r => r))
                        {
                            <option value="@role">@role</option>
                        }
                    }
                </select>
            </div>
        </div>

        @if (hasData)
        {
            <div id="exportButtons" class="d-flex flex-wrap me-2"></div>
        }

        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover table-striped dataTableExport mb-0" id="workerTable" style="width:100%; table-layout: fixed;">
                <thead class="text-center">
                    <tr>
                        <th class="text-center"><input type="checkbox" id="selectAll" @(!hasData ? "disabled" : "") /></th>
                        <th class="text-center">Sr.No</th>
                        <th class="text-center">Worker Name</th>
                        <th class="text-center">Worker Role</th>
                        <th class="text-center">Contact</th>
                        <th class="text-center">Attendance Month</th>
                        <th class="text-center">Base Salary</th>
                        <th class="text-center"> Present Days</th>
                        <th class="text-center"> Payable Amount(₹)</th>
                        <th class="text-center">Payment Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (hasData)
                    {
                        foreach (var item in Model.Select((value, index) => new { value, index }))
                        {
                            var joiningDate = item.value.DateOfJoining.ToString("yyyy-MM-dd");
                            var attendanceMonth = Convert.ToDateTime(item.value.AttendanceMonth).ToString("MMMM yyyy");
                            var attendanceMonthValue = Convert.ToDateTime(item.value.AttendanceMonth).ToString("yyyy-MM");
                            var rowId = "checkbox-" + (item.index + 1);
                            var workerCode = item.value.WorkerCode;
                            var isPaid = item.value.IsPaid;
                            var paymentStatus = isPaid ? "Paid" : "Unpaid";

                            var contactNumber = item.value.Contact;
                            if (!string.IsNullOrEmpty(contactNumber))
                            {
                                contactNumber = contactNumber.Trim();
                                if (contactNumber.StartsWith("+91"))
                                {
                                    contactNumber = contactNumber.Substring(3);
                                }
                                else if (contactNumber.StartsWith("91"))
                                {
                                    contactNumber = contactNumber.Substring(2);
                                }
                                contactNumber = contactNumber.TrimStart('0');
                                contactNumber = "+91" + contactNumber;
                            }

                            <tr class="text-center" data-attendance-month="@attendanceMonthValue" data-role="@item.value.RoleName" data-payment-status="@paymentStatus" style="height: 30px; color: black; padding: 0; position: relative;">
                                <td class="text-center"><input type="checkbox" class="row-checkbox" id="@rowId" data-id="@workerCode" /></td>
                                <td class="text-center" title="Index">@(item.index + 1)</td>
                                <td class="text-center" title="Staff: @item.value.StaffName">@item.value.StaffName</td>
                                <td class="text-center" title="Role: @item.value.RoleName">@item.value.RoleName</td>
                                <td class="text-center" title="Contact: @contactNumber">@contactNumber</td>
                                <td class="text-center" title="Month: @attendanceMonth">@attendanceMonth</td>
                                <td class="text-center" title="Base Salary">@item.value.BaseSalary.ToString("C")</td>
                                <td class="text-center" title="Days Present">@item.value.DaysPresent</td>
                                <td class="text-center" title="@item.value.AmountToBePaid">@item.value.AmountToBePaid.ToString("C")</td>
                                <td class="text-center">
                                    @if (isPaid)
                                    {
                                        <span class="text-center">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="text-center">Unpaid</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.value.IsPaid)
                                    {
                                        <button class="btn btn-info btn-sm viewBtn"
                                                data-worker="@item.value.WorkerCode"
                                                data-month="@item.value.AttendanceMonth">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-sm payBtn"
                                                data-worker="@item.value.WorkerCode"
                                                data-month="@item.value.AttendanceMonth">
                                            <i class="bi bi-currency-rupee"></i> Pay
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="no-data-row py-3">
                            <td colspan="13" class="text-center text-danger font-weight-bold">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="viewPaymentModal" tabindex="-1" style="max-height:fit-content">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width: 800px;">
        <div class="modal-content" id="viewModalContent" style="max-height:80vh; overflow-y:auto;"></div>
    </div>
</div>

<div class="modal fade" id="payPaymentModal" tabindex="-1" style="max-height:fit-content">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width: 700px;">
        <div class="modal-content" id="payModalContent" style="position:relative;"></div>
    </div>
</div>

