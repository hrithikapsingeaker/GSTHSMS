        customize: function (csv) {
            const now = new Date();
            const society = "Green Valley Society - Worker Payment List";
            const timestamp = `Generated on: ${now.toLocaleString('en-IN', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', hour12: true
            })}`;

            let lines = csv.split('\n').filter(line => line.trim() !== '');
            const header = lines[0].split(',');
            header[0] = 'Sr. No';
            lines[0] = header.join(',');

            for (let i = 1; i < lines.length; i++) {
                let cols = lines[i].split(',');
                cols[0] = i.toString(); // Sr.No सेट करतोय

                for (let j = 0; j < cols.length; j++) {
                    let cleanText = cols[j].replace(/['"]+/g, '').trim();

                    const totalWidth = 15; // Adjust for center alignment
                    const leftPadding = Math.max(0, Math.floor((totalWidth - cleanText.length) / 2));
                    const rightPadding = Math.max(0, totalWidth - cleanText.length - leftPadding);
                    cleanText = ' '.repeat(leftPadding) + cleanText + ' '.repeat(rightPadding);

                    cols[j] = `"${cleanText}"`;
                }
                lines[i] = cols.join(',');
            }

            const totalCols = header.length;
            const centerText = (text) => {
                const emptyCols = Math.floor((totalCols - 1) / 2);
                const centered = Array(emptyCols).fill('').concat([text]);
                return centered.join(',');
            };

            const spacingRow = new Array(totalCols).fill('').join(',');
            return [
                centerText(society),
                centerText(timestamp),
                spacingRow,
                lines.join('\n')
