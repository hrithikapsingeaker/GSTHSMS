@section Styles {
    <link href="~/Content/modules/datatables/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/modules/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css" rel="stylesheet" />


    <link rel="stylesheet" href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" />
    <link href="~/Content/modules/izitoast/css/iziToast.min.css" rel="stylesheet" />
    <link href="~/Content/css/WorkerPaymentListSB.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
    <script src="~/Content/modules/moment.min.js"></script>
    <script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/modules/datatables/datatables.min.js"></script>





    <script>
        // Store selected checkboxes by serial number
var selectedSerialNumbers = JSON.parse(sessionStorage.getItem('selectedSerialNumbers')) || {};
var dataTable; // Variable to hold DataTable instance
var hasData = @(hasData ? "true" : "false"); // Check if model has data

// Function to check if any row is selected
function hasAnyRowSelected() {
    return Object.keys(selectedSerialNumbers).some(key => selectedSerialNumbers[key]);
}

// Function to show warning when no rows are selected
function showToastWarning(message = "Please select at least one worker to export.") {
    iziToast.warning({
        title: 'Warning!',
        message: message,
        position: 'topCenter'
    });
}

// Show loader when page is loading
$(window).on('load', function () {
    refreshTable();
    $('#listLoader').fadeOut(300);
    // Clear all checkboxes on page load/refresh
    $('#selectAll').prop('checked', false);
    $('.row-checkbox').prop('checked', false);
});

// For Opening modal for the View modal
$(document).on('click', '.viewBtn', function () {
    $('#listLoader').fadeIn(200); // Show loader
    $.get('@Url.Action("GetWorkerPaymentDetailsAD", "AccountManager")', {
        workerCode: $(this).data('worker'),
        attendanceMonth: $(this).data('month')
    }, function (html) {
        $('#listLoader').fadeOut(200); // Hide loader
        if (html.trim() !== "") {
            $('#viewModalContent').html(html);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('viewPaymentModal')).show();
        } else {
            alert("No payment data found! ❌");
        }
    }).fail(function () {
        $('#listLoader').fadeOut(200); // Hide loader
        alert("Error retrieving payment details.");
    });
});

// Pay Modal Open
$(document).on('click', '.payBtn', function () {
    $('#listLoader').fadeIn(200); // Show loader
    $.get('@Url.Action("FetchSingleWorkerPaymentDataAD", "AccountManager")', {
        workerCode: $(this).data('worker'),
        attendanceMonth: $(this).data('month')
    }, function (html) {
        $('#listLoader').fadeOut(200); // Hide loader
        if (html.trim() !== "") {
            $('#payModalContent').html(html);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('payPaymentModal')).show();
            loadBankDropdown(document.getElementById('payPaymentModal'));
        } else {
            alert("Unable to load payment form! ❌");
        }
    }).fail(function () {
        $('#listLoader').fadeOut(200); // Hide loader
        alert("Error loading payment form.");
    });
});

// Modal cleanup handler
$(document).on('hidden.bs.modal', '#payPaymentModal', function() {
    // Clear any remaining data
    $('#payModalContent').empty();
    window.bankDropdownInitialized = false;
});

// For Month Selection for the payment
$('.daterange-btn').daterangepicker({
    startDate: moment().subtract(1, 'month').startOf('month'),
    endDate: moment().subtract(1, 'month').endOf('month'),
    locale: {
        format: 'DD-MM-YYYY',
        applyLabel: 'Apply',
        cancelLabel: 'Cancel',
        fromLabel: 'From',
        toLabel: 'To',
        customRangeLabel: 'Custom Range',
        daysOfWeek: ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'],
        monthNames: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
        firstDay: 1
    },
    ranges: {
        'This Month': [moment().startOf('month'), moment().endOf('month')],
        'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
        'Last 3 Months': [moment().subtract(2, 'month').startOf('month'), moment().endOf('month')],
        'Last 6 Months': [moment().subtract(5, 'month').startOf('month'), moment().endOf('month')],
        'This Year': [moment().startOf('year'), moment().endOf('year')]
    },
    alwaysShowCalendars: true, // This ensures calendars are always shown for custom ranges
    showCustomRangeLabel: true // This ensures custom range option is available
}, function (start, end) {
    $('#selectedRangeText').text(start.format('DD-MM-YYYY') + ' - ' + end.format('DD-MM-YYYY'));

    // Apply the filter based on the selected date range
    if (hasData) {
        applyDateFilter(start, end);
    }
});

$(document).on('hide.bs.modal', '#paymentModal', function () {
    $('#bankSelect').empty().append('<option value="">-- Select Bank --</option>');
    $('#bankBalance').text('-').css('color', '');
});

function initializeFilters() {
    if (!hasData) {
        $('#roleFilter, #paymentStatusFilter').addClass('disabled-filter');
        $('#noDataMessage').show();
        $('#exportButtons').hide();
        $('#selectAll').prop('disabled', true);
    } else {
        $('#roleFilter, #paymentStatusFilter').removeClass('disabled-filter');
        $('#noDataMessage').hide();
        $('#exportButtons').show();
        $('#selectAll').prop('disabled', false);
    }
}

function updateSelectAllCheckbox() {
    if (!hasData) return;

    if (dataTable) {
        // Get total number of filtered rows
        var totalRows = dataTable.rows({ search: 'applied' }).count();
        var selectedCount = 0;

        // Count only selected rows that are currently visible/filtered
        dataTable.rows({ search: 'applied' }).every(function () {
            var row = $(this.node());
            var serialNo = row.find('td:eq(1)').text().trim();
            if (selectedSerialNumbers[serialNo]) {
                selectedCount++;
            }
        });

        // Check if all filtered rows are selected
        $('#selectAll').prop('checked', totalRows > 0 && totalRows === selectedCount);
    } else {
        // For non-DataTable implementation
        var visibleRows = $('#workerTable tbody tr:visible').not('.no-data-row');
        var selectedCount = 0;

        visibleRows.each(function () {
            var serialNo = $(this).find('td:eq(1)').text().trim();
            if (selectedSerialNumbers[serialNo]) {
                selectedCount++;
            }
        });

        $('#selectAll').prop('checked', visibleRows.length > 0 && visibleRows.length === selectedCount);
    }
}

function updateSerialNumbers() {
    var visibleRows = $('#workerTable tbody tr:visible').not('.no-data-row');
    visibleRows.each(function(index) {
        $(this).find('td:eq(1)').text(index + 1);
    });
}

function updateRowVisibilityStatus() {
    if (!hasData) {
        $('#noDataMessage').show();
        return;
    }

    var visibleRows = $('#workerTable tbody tr:visible').not('.no-data-row').length;
    var noDataRow = $('.no-data-row');
    var noDataMsg = $('#noDataMessage');
    var paginationControls = $('.dataTables_paginate, .dataTables_info');
    var exportButtons = $('#exportButtons');

    noDataRow.hide();

    if (visibleRows === 0) {
        noDataMsg.show();
        paginationControls.hide();
        exportButtons.hide();
    } else {
        noDataMsg.hide();
        paginationControls.show();
        exportButtons.show();
    }

    restoreCheckboxSelections();
    updateSelectAllCheckbox();
}

// Function to restore checkbox selections when table redraws
function restoreCheckboxSelections() {
    if (!hasData) return;

    if (dataTable) {
        // Process all rows (including those not on current page)
        dataTable.rows({ search: 'applied' }).every(function() {
            var row = $(this.node());
            var serialNo = row.find('td:eq(1)').text().trim();

            // Check if this serial number is in our selected list
            if (selectedSerialNumbers[serialNo]) {
                row.find('.row-checkbox').prop('checked', true);
            } else {
                row.find('.row-checkbox').prop('checked', false);
            }
        });
    } else {
        $('.row-checkbox').each(function() {
            var serialNo = $(this).closest('tr').find('td:eq(1)').text().trim();
            $(this).prop('checked', selectedSerialNumbers[serialNo] || false);
        });
    }
}

// Update your role filter function to include date filtering
function applyRoleFilter(role) {
    if (!hasData) return;

    let hasVisibleRows = false;

    if (dataTable) {
        dataTable.search('').draw();

        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            if (settings.nTable.id !== 'workerTable') return true;

            var row = $(dataTable.row(dataIndex).node());
            var rowRole = row.data('role');
            var rowStatus = row.data('payment-status');
            var attendanceMonth = row.data('attendance-month');

            var selectedRole = $('#roleFilter').val();
            var selectedStatus = $('#paymentStatusFilter').val();

            // Get the current date range
            var dateRange = $('.daterange-btn').data('daterangepicker');
            var startDate = dateRange ? dateRange.startDate : moment().startOf('month');
            var endDate = dateRange ? dateRange.endDate : moment();
            var monthDate = moment(attendanceMonth + '-01', 'YYYY-MM-DD');

            var showByRole = !selectedRole || rowRole === selectedRole;
            var showByStatus = !selectedStatus || rowStatus === selectedStatus;
            var showByDate = monthDate.isBetween(startDate, endDate, 'month', '[]');

            return showByRole && showByStatus && showByDate;
        });

        dataTable.draw();
        hasVisibleRows = dataTable.rows({ filter: 'applied' }).count() > 0;
    } else {
        // Get the current date range
        var dateRange = $('.daterange-btn').data('daterangepicker');
        var startDate = dateRange ? dateRange.startDate : moment().startOf('month');
        var endDate = dateRange ? dateRange.endDate : moment();

        const selectedStatus = $('#paymentStatusFilter').val();

        $('#workerTable tbody tr').not('.no-data-row').each(function () {
            const attendanceMonth = $(this).data('attendance-month');
            const monthDate = moment(attendanceMonth + '-01', 'YYYY-MM-DD');
            const rowRole = $(this).data('role');
            const rowStatus = $(this).data('payment-status');

            const showByRole = !role || rowRole === role;
            const showByStatus = !selectedStatus || rowStatus === selectedStatus;
            const showByDate = monthDate.isBetween(startDate, endDate, 'month', '[]');

            $(this).toggle(showByRole && showByStatus && showByDate);
            if (showByRole && showByStatus && showByDate) hasVisibleRows++;
        });
    }

    if (!hasVisibleRows) {
        $('#noDataMessage').show();
        $('.dataTables_paginate, .dataTables_info').hide();
        $('#exportButtons').hide();
    } else {
        $('#noDataMessage').hide();
        $('.dataTables_paginate, .dataTables_info').show();
        $('#exportButtons').show();
    }

    $.fn.dataTable.ext.search.pop();
    restoreCheckboxSelections();
    updateSelectAllCheckbox();
}

