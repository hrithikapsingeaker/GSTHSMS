function clearAllSelectionsAfterExport(dt) {
    // ✅ 1. Clear all row checkboxes (on current page)
    dt.rows().every(function () {
        $(this.node()).find('.row-checkbox').prop('checked', false);
    });

    // ✅ 2. Uncheck "Select All"
    $('#selectAll').prop('checked', false);

    // ✅ 3. Clear the selectedSerialNumbers object
    selectedSerialNumbers = {};
    sessionStorage.setItem('selectedSerialNumbers', JSON.stringify(selectedSerialNumbers));
}

function filterDataOnPageLoad() {
    if (!hasData) {
        $('#noDataMessage').show();
        return;
    }

    // Load previous month data by default
    const startDate = moment().subtract(1, 'month').startOf('month');
    const endDate = moment().subtract(1, 'month').endOf('month');
    applyDateFilter(startDate, endDate);

    const hasVisibleRows = $('#workerTable tbody tr:visible').not('.no-data-row').length > 0;
    if (!hasVisibleRows) {
        $('#noDataMessage').show();
    }
}

$(function () {
    initializeFilters();

    $('.daterange-btn').daterangepicker({
        startDate: moment().subtract(1, 'month').startOf('month'),
        endDate: moment().subtract(1, 'month').endOf('month'),
        locale: {
            format: 'DD-MM-YYYY',
            applyLabel: 'Apply',
            cancelLabel: 'Cancel',
            fromLabel: 'From',
            toLabel: 'To',
            customRangeLabel: 'Custom Range',
            daysOfWeek: ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'],
            monthNames: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
            firstDay: 1
        },
        ranges: {
            'This Month': [moment().startOf('month'), moment().endOf('month')],
            'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
            'Last 3 Months': [moment().subtract(2, 'month').startOf('month'), moment().endOf('month')],
            'Last 6 Months': [moment().subtract(5, 'month').startOf('month'), moment().endOf('month')],
            'This Year': [moment().startOf('year'), moment().endOf('year')]
        }
    }, function (start, end) {
        $('#selectedRangeText').text(start.format('DD-MM-YYYY') + ' - ' + end.format('DD-MM-YYYY'));

        // Apply the filter based on the selected date range
        if (hasData) {
            applyDateFilter(start, end);
        }
    });

    function applyDateFilter(start, end) {
        if (!hasData) {
            $('#noDataMessage').show();
            return;
        }

        let hasVisibleRows = false;

        if (dataTable) {
            dataTable.search('').draw();

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable.id !== 'workerTable') return true;

                var row = $(dataTable.row(dataIndex).node());
                var rowRole = row.data('role');
                var rowStatus = row.data('payment-status');
                var attendanceMonth = row.data('attendance-month');

                var selectedRole = $('#roleFilter').val();
                var selectedStatus = $('#paymentStatusFilter').val();

                var monthDate = moment(attendanceMonth + '-01', 'YYYY-MM-DD');

                var showByRole = !selectedRole || rowRole === selectedRole;
                var showByStatus = !selectedStatus || rowStatus === selectedStatus;
                var showByDate = monthDate.isBetween(start, end, 'month', '[]');

                return showByRole && showByStatus && showByDate;
            });

            dataTable.draw();
            hasVisibleRows = dataTable.rows({ filter: 'applied' }).count() > 0;
        } else {
            const selectedRole = $('#roleFilter').val();
            const selectedStatus = $('#paymentStatusFilter').val();

            $('#workerTable tbody tr').not('.no-data-row').each(function () {
                const attendanceMonth = $(this).data('attendance-month');
                const monthDate = moment(attendanceMonth + '-01', 'YYYY-MM-DD');
                const rowRole = $(this).data('role');
                const rowStatus = $(this).data('payment-status');

                const showByDate = monthDate.isBetween(start, end, 'month', '[]');
                const showByRole = !selectedRole || rowRole === selectedRole;
                const showByStatus = !selectedStatus || rowStatus === selectedStatus;

                $(this).toggle(showByDate && showByRole && showByStatus);
                if (showByDate && showByRole && showByStatus) hasVisibleRows++;
            });
        }

        if (!hasVisibleRows) {
            $('#noDataMessage').show();
            $('.dataTables_paginate, .dataTables_info').hide();
            $('#exportButtons').hide();
        } else {
            $('#noDataMessage').hide();
            $('.dataTables_paginate, .dataTables_info').show();
            $('#exportButtons').show();
        }

        $.fn.dataTable.ext.search.pop();
        restoreCheckboxSelections();
        updateSelectAllCheckbox();
    }

    if (hasData) {
        $('#roleFilter').change(function() {
            applyRoleFilter($(this).val());
            selectedSerialNumbers = {};
            sessionStorage.setItem('selectedSerialNumbers', JSON.stringify(selectedSerialNumbers));
            updateSelectAllCheckbox();
        });

        $('#paymentStatusFilter').change(function() {
            applyPaymentStatusFilter($(this).val());
            selectedSerialNumbers = {};
            sessionStorage.setItem('selectedSerialNumbers', JSON.stringify(selectedSerialNumbers));
            updateSelectAllCheckbox();
        });
    }

    dataTable = initializeDataTable();

    // Fix for search functionality - Proper search handling
    if (dataTable) {
        // Add event listener to search input
        $('.dataTables_filter input').on('keyup', function () {
            var searchValue = this.value;

            // Use a small delay to ensure the search is processed
            setTimeout(function () {
                // If search is NOT empty, let DataTable handle it normally
                if (searchValue !== '') {
                    return;
                }

                // If search is empty, reapply the date filter
                // First clear the DataTable search
                dataTable.search('').draw();

                // Get the current date range from the picker
                var dateRange = $('.daterange-btn').data('daterangepicker');
                var startDate = dateRange.startDate;
                var endDate = dateRange.endDate;

                // Clear any custom filters
                $.fn.dataTable.ext.search = [];

                // Reapply only the date filter
                applyDateFilter(startDate, endDate);

                // If no data found, show the message
                updateRowVisibilityStatus();
            }, 100);
        });
    }

    filterDataOnPageLoad();
    updateRowVisibilityStatus();

    // ✅ Updated select all handler - selects only FILTERED workers
    $('#selectAll').on('change', function () {
        var isChecked = $(this).is(':checked');

        if (isChecked) {
            // Select only FILTERED workers
            if (dataTable) {
                // Use DataTables API to get only filtered rows
                dataTable.rows({ search: 'applied' }).every(function () {
                    var row = $(this.node());
                    var serialNo = row.find('td:eq(1)').text().trim();
                    selectedSerialNumbers[serialNo] = true;
                    row.find('.row-checkbox').prop('checked', true);
                });
            } else {
                // Fallback for non-DataTable implementation - select only visible rows
                $('#workerTable tbody tr:visible').not('.no-data-row').each(function () {
                    var checkbox = $(this).find('.row-checkbox');
                    var serialNo = $(this).find('td:eq(1)').text().trim();
                    selectedSerialNumbers[serialNo] = true;
                    checkbox.prop('checked', true);
                });
            }
        } else {
            // Deselect ALL workers (including those not visible)
            selectedSerialNumbers = {};
            $('.row-checkbox').prop('checked', false);
        }

        sessionStorage.setItem('selectedSerialNumbers', JSON.stringify(selectedSerialNumbers));
        updateSelectAllCheckbox();
    });

    // ✅ Updated individual checkbox handler - selection based on serial number only
    $(document).on('change', '.row-checkbox', function (e) {
        e.stopPropagation();
        var isChecked = $(this).is(':checked');
        var serialNo = $(this).closest('tr').find('td:eq(1)').text().trim();

        if (isChecked) {
            selectedSerialNumbers[serialNo] = true;
        } else {
            delete selectedSerialNumbers[serialNo];
        }

        sessionStorage.setItem('selectedSerialNumbers', JSON.stringify(selectedSerialNumbers));

        // Update select all checkbox state
        updateSelectAllCheckbox();
    });

    $(document).on('submit', '.payForm', function (e) {
        e.preventDefault();
        const currentDay = new Date().getDate();
        if (currentDay < 1 || currentDay > 10) {
            iziToast.error({
                title: 'Error',
                message: 'Payments can only be processed from 1st to 10th of the month',
                position: 'topCenter'
            });
            return;
        }

        $.post(this.action, $(this).serialize(), function (html) {
            if (html.trim()) {
                $('#modalContent').html(html);
                new bootstrap.Modal($('#paymentModal')).show();
            } else {
                iziToast.info({ title: 'Info', message: 'Already Paid!', position: 'topCenter' });
            }
        });
    });
