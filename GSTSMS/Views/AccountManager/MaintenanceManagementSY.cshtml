                            // Shift existing rows down by 2 to insert title & timestamp
                            rows.each(function () {
                                const r = parseInt($(this).attr('r')) + 2;
                                $(this).attr('r', r);
                                $(this).find('c').each(function () {
                                    const cellRef = $(this).attr('r');
                                    const col = cellRef.replace(/[0-9]/g, '');
                                    $(this).attr('r', col + r);
                                });
                            });

                            // Insert Title and Timestamp rows
                            const titleRow = `
<row r="1">
    <c t="inlineStr" r="D1" s="2">
        <is><t>${title}</t></is>
    </c>
</row>`;
                            const dateRow = `
<row r="2">
    <c t="inlineStr" r="D2" s="2">
        <is><t>${timestamp}</t></is>
    </c>
</row>`;

                            sheetData.prepend(dateRow);
                            sheetData.prepend(titleRow);

                            // Add center alignment style
                            const cellXfs = $('cellXfs', styles);
                            const centerStyleIndex = cellXfs.children().length;
                            cellXfs.append(`
            <xf xfId="0" applyAlignment="1">
                <alignment horizontal="center" vertical="center"/>
            </xf>
        `);

                            // Apply center alignment style to all cells
                            $('sheetData row c', sheet).attr('s', centerStyleIndex);

                            // Update Sr. No (column A) values
                            let srNo = 1;
                            $('row', sheet).each(function () {
                                const rowIndex = parseInt($(this).attr('r'));
                                if (rowIndex >= 4) {
                                    const firstCell = $('c[r^="A"]', this);
                                    if (firstCell.length) {
                                        firstCell.attr('t', 'n');
                                        const v = firstCell.find('v');
                                        if (v.length) {
                                            v.text(srNo++);
                                        } else {
                                            firstCell.append(`<v>${srNo++}</v>`);
                                        }
                                    }
                                }
                            });
