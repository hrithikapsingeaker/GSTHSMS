        function showMaintenanceModal(memberCode, maintainanceTypeId, entityCode, paidDate) {
            if (!memberCode || maintainanceTypeId === 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Data',
                    text: 'Invalid MemberCode or MaintananceTypeId.'
                });
                return;
            }

            $('#listLoader').fadeIn(200);

            $.ajax({
                url: '@Url.Action("MemberMaintenanceDetailsSY", "AccountManager")',
                type: 'POST',
                data: {
                    memberCode: memberCode,
                    maintainanceTypeId: maintainanceTypeId,
                    entityCode: entityCode,
                    paidDate: paidDate
                },
                success: function (result) {
                    $("#modalMaintenanceContent").html(result);
                    var modalElement = document.getElementById("maintenanceModal");

                    var modal = new bootstrap.Modal(modalElement, {
                        backdrop: 'static',
                        keyboard: false
                    });

                    modal.show();
                    document.querySelector('.maincontaint').style.marginTop = "80px";
                    $('#listLoader').fadeOut(300);
                },
                error: function (xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error Loading Data',
                        text: xhr.responseText
                    });
                    $('#listLoader').fadeOut(300);
                }
            });

            $(document).on('click', '.btn-close-square-btn', function () {
                $('#maintenanceModal').modal('hide');
            });
        }

        function showMaintenancePaymentModal(memberCode, maintainanceTypeId, EntityCode) {
            if (!memberCode || maintainanceTypeId === 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Data',
                    text: 'Invalid MemberCode or MaintananceTypeId.'
                });
                return;
            }

            $('#listLoader').fadeIn(200);

            $.ajax({
                url: '@Url.Action("MemberPaymentDetailsSY", "AccountManager")',
                type: 'POST',
                data: {
                    memberCode: memberCode,
                    maintainanceTypeId: maintainanceTypeId,
                    EntityCode: EntityCode
                },
                success: function (result) {
                    $("#modalMaintenancePaymentContent").html(result);
                    var modalElement = document.getElementById("MemberpaymentModal");
                    var modal = new bootstrap.Modal(modalElement, {
                        backdrop: 'static',
                        keyboard: false
                    });

                    var modalElement = document.getElementById("MemberpaymentModal");
                    var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.show();

                    if (document.querySelector('.maincontaint')) {
                        document.querySelector('.maincontaint').style.marginTop = "80px";
                    }

                    $('#listLoader').fadeOut(300);
                },
                error: function (xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error Loading Data',
                        text: xhr.responseText
                    });
                    $('#listLoader').fadeOut(300);
                }
            });
        }

        $(document).on('click', '.close-square-btn', function () {
            var modalElement = document.getElementById("MemberpaymentModal");
            var modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) modal.hide();
        });

        function showStislaToast(type, title, message) {
            iziToast[type]({
                title: title,
                message: message,
                position: 'topCenter',
                timeout: 3000
            });
        }

        function getActiveTabLabel() {
            const activeTab = document.querySelector('.section-header-tabs .equal-tab.active');
            if (activeTab) {
                const text = activeTab.textContent.trim().toLowerCase();
                if (text.includes('unpaid')) return 'Unpaid Maintenance List';
                if (text.includes('paid')) return 'Paid Maintenance List';
            }
            return 'Maintenance List';
        }
