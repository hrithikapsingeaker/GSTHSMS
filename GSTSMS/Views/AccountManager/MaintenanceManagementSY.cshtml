@model IEnumerable<GSTSMSLibrary.AccountManager.AccountManager>

@{
    ViewBag.Title = "Maintenance Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .maincontaint {
        position: relative;
        margin-top: -35px !important;
    }

    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7); /* Semi-transparent black background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader {
        width: 50px;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 8px solid;
        border-color: white transparent; /* White spinner with transparent middle */
        animation: spin 1s infinite linear;
    }

    @@keyframes spin {
        to {
            transform: rotate(0.5turn);
        }
    }

    .btn-view-transaction {
        background-color: #339af0;
        border: 1px solid lightgray !important;
        color: white;
        text-align: center;
        height: 25px !important;
        outline: none !important;
        box-shadow: none !important;
        cursor: pointer; /* optional: hover feel */
    }

        .btn-view-transaction:hover {
            background-color: lightgray;
            color: #339af0;
            outline: none !important;
            box-shadow: none !important;
        }

        .btn-view-transaction:focus,
        .btn-view-transaction:focus-visible,
        .btn-view-transaction:active {
            outline: none !important;
            box-shadow: none !important;
            border-color: lightgray !important;
        }
</style>

<div class="loader-overlay" id="listLoader">
    <div class="loader"></div>
</div>
<div class="maincontaint" style=" margin-top: 0px">




    <div class="card mb-3 ">
        <div class="card-body">

            <div><h2 class=" custom-heading">Maintenance Member List</h2></div>

            <!-- ✅ Row 1: Paid/Unpaid Tabs + Wing Filter (side by side) -->
            <div class="row justify-content-between align-items-center mb-3">
                <!-- Tabs and Filters in one line -->
                <div class="col-md-4">
                    <div class="section-header-tabs">
                        <div class="equal-tab-group" role="group" aria-label="Maintenance Tabs">
                            <button type="button" class="equal-tab active" id="paid-tab" data-status="Completed">
                                Paid List
                            </button>
                            <button type="button" class="equal-tab" id="unpaid-tab" data-status="Unpaid">
                                Unpaid List
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-8 d-flex align-items-center justify-content-end">
                    <!-- Maintenance Type Filter -->
                    <div class="d-flex align-items-center" style="margin-right: 20px;">
                        <label for="maintenanceTypeFilter" class="mb-0" style="font-weight: bold; margin-right: 8px;">
                            Maintenance Type :
                        </label>
                        <select id="maintenanceTypeFilter" class="form-control" style="width: 150px;">
                            <option value="">-- Select Type --</option>
                            @foreach (var type in Model.Select(m => m.MaintananceType).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>


                    <!-- Wing Filter -->
                    <div class="d-flex align-items-center">
                        <label for="wingFilter" class="mb-0" style="font-weight: bold; margin-right: 8px;">Wing :</label>
                        <select id="wingFilter" class="form-control" style="width: 150px;">
                            <option value="">-- Select Wing --</option>
                            <option value="A">Wing A</option>
                            <option value="B">Wing B</option>
                            <option value="C">Wing C</option>
                            <option value="All Wing">All Wing</option>
                        </select>
                    </div>


                    <label for="penaltyFilter" class="mb-0" style="font-weight: bold; margin-right: 8px;"> Penalty :</label>
                    <select id="penaltyFilter" class="form-control" style="width: 150px;">
                        <option value="">-- Select --</option>
                        <option value="">All</option>
                        <option value="withPenalty">With Penalty</option>
                        <option value="withoutPenalty">Without Penalty</option>
                    </select>



                </div>


            </div>

            <!-- Row 2: Date Picker + Export + Search Box -->
            <div class="row align-items-end flex-wrap mb-3">

                <!-- 📅 Date Picker + Export Buttons -->
                <div class="col-lg-3 col-md-2 mb-1">
                    <div class="input-group mb-2" style="display: inline-flex; width: 220px;">
                        <div class="input-group-prepend">
                            <span class="input-group-text"
                                  style="background-color: #6777ef; color: white; border: 1px solid #6777ef; border-right: none; border-radius: 4px 0 0 4px; padding: 0 12px;">
                                <i class="fas fa-calendar"></i>
                            </span>
                        </div>
                        <input type="text" class="form-control" id="customDateRange"
                               style="background-color: #6777ef; color: white; font-size: 13px; border: 1px solid #6777ef; border-left: none; border-radius: 0 4px 4px 0; padding: 6px 10px; width: 160px;" />
                        <input type="hidden" id="fromDate1" />
                        <input type="hidden" id="toDate1" />
                    </div>


                    <div id="exportButtons" class="d-flex gap-2"></div>
                </div>

                <!-- 🔍 Search Box -->
                <div class="col-lg-8 col-md-6 mb-2 d-flex justify-content-lg-end justify-content-start">
                    <div id="moveSearchBoxHere" class="d-flex align-items-center"></div>
                </div>

            </div>


            <div class="table-responsive">
                <table id="maintenanceTable" class="table table-striped table-bordered nowrap" style="width:100%; table-layout:auto">
                    <thead class="custom-expense-header" style="height:30px !important;font-size:14px !important">
                        <tr>
                            <th><input type="checkbox" id="selectAll" /></th>
                            <th>Sr.No</th>
                            <th class="d-none">Wing</th>
                            <th>Flat No</th>
                            <th>Full Name</th>
                            <th class="d-none">Email</th>
                            <th>Maintenance Type</th>
                            <th>Maintenance Amount(₹)</th>
                            <th>Paid Amount(₹)</th>

                            <!-- ✅ New columns -->


                            <th>Penalty %</th>
                            <th>Penalty Amount(₹)</th>
                            <th>Final Payable(₹)</th>

                            <th>Schedule Date</th>
                            <th>Paid Date</th>

                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody style="line-height:25px">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><input type="checkbox" class="selectRow" data-member-code="@item.MemberCode" /></td>
                                <td></td>
                                <td class="d-none">@item.WingName</td>
                                <td>@item.FlatCode</td>
                                <td title="@item.FullName">@item.FullName</td>
                                <td class="d-none" title="@item.Email">@item.Email</td>
                                <td>@item.MaintananceType</td>

                                <td>₹@item.TotalAmount.ToString("0.00")</td>
                                <td>₹@item.PaidAmount.ToString("0.00")</td>

                                <!-- ✅ Pending + Penalty -->


                                <td>@item.PenaltyPercent %</td>
                                <td>₹@item.PenaltyAmount.ToString("0.00")</td>
                                <td>₹@item.FinalPayable.ToString("0.00")</td>

                                <td>
                                    @(item.ScheduleDate.HasValue ? item.ScheduleDate.Value.ToString("dd-MM-yyyy") : "")
                                </td>
                                <td>
                                    @(item.PaidDate.HasValue ? item.PaidDate.Value.ToString("dd-MM-yyyy") : "-")
                                </td>



                                <td>
                                    @item.Status
                                </td>

                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <button class="btn-view-transaction" type="button"
                                                onclick="showMaintenanceModal('@item.MemberCode', @(item.MaintananceTypeId ?? 0), '@item.EntityCode', '@(item.PaidDate?.ToString("yyyy-MM-dd") ?? "")')"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="View Maintenance">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- ✅ Pay button -->
                                        <button class="btn btn-sm btn-pay-green"
                                                onclick="showMaintenancePaymentModal('@item.MemberCode', @(item.MaintananceTypeId ?? 0), '@item.EntityCode')">
                                            Pay
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


        </div>
    </div>
</div>
<!-- partial view for maintainance details -->

<div class="modal fade" id="maintenanceModal" tabindex="-1" aria-labelledby="maintenanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-body p-0" id="modalMaintenanceContent">
                <!-- Partial view will load here -->
            </div>
        </div>
    </div>
</div>


<!-- ✅ Modal -->
<div class="modal fade" id="MemberpaymentModal" tabindex="-1" aria-labelledby="maintenancePaymentModalLabel" aria-hidden="true">
    @*<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">*@
    <div class="modal-body p-0" id="modalMaintenancePaymentContent">
        <!-- Partial view will load here -->
        <!--</div>
        </div>-->
    </div>
</div>





<style>

    #MemberpaymentModal .modal-dialog {
        max-height: 90vh;
        overflow-y: auto;
    }

    /* Remove all scrollbars */
    html, body, .maincontaint {
        overflow: hidden !important;
    }

    /* For DataTables specifically */
    .dataTables_scrollBody {
        overflow: hidden !important;
    }

    /* Card body adjustments */
    .card-body {
        overflow: visible !important;
    }

    /* Table container */
    .table-responsive {
        overflow: visible !important;
        height: auto !important;
    }

    .btn.btn-icon .fas {
        margin-left: 0 !important;
        font-size: 12px;
        height: 25px;
    }


    .card .card-body {
        padding-top: 0px;
        padding-bottom: 0px;
    }


    /* Reduce height of daterangepicker input */
    #customDateRange.form-control {
        height: 32px !important; /* Default Bootstrap input height is ~38px */

        font-size: 14px;
        padding: 4px 10px; /* Adjust padding if needed */
        line-height: 1.2;
    }

    /* Optional: Adjust the calendar icon size to match */
    .input-group-text i.fas.fa-calendar {
        font-size: 14px; /* Icon size */
    }

    .input-group-text {
        height: 32px !important; /* Match input height */
        padding: 4px 10px;
    }



    /* Remove Bootstrap modal top animation */
    .modal.fade .modal-dialog {
        transition: none !important;
        transform: translate(0, 0) !important;
    }


    .modal-backdrop.show {
        opacity: 0.5;
    }
    /* Align pagination to right */
    div.dataTables_paginate {
        text-align: right !important;
        float: right !important;
        margin-top: -26px;
    }

    .custom-heading {
        text-align: center;
        color: #000;
        font-size: 24px;
        font-weight: 600;
        font-weight: bold; /* or use 700 */

        margin-bottom: 20px;
    }
    /* Increase size of Paid/Unpaid tab buttons */
    /* ✅ Common button style for both tabs */
    /* Main tab container */
    .equal-tab-group {
        display: flex;
        justify-content: flex-start;
        border-radius: 5px;
        overflow: hidden;
        max-width: 500px;
        margin: 0 0 10px 0;
        background-color: #fff;
        margin-right: -85px;
    }

    /* Individual tab button */
    .equal-tab {
        flex: 1;
        padding: 8px 16px;
        margin: 0 5px;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        text-align: center;
        text-decoration: none;
        color: #000000;
        font-weight: 500;
        transition: all 0.3s ease;
        cursor: pointer;
        outline: none; /* <-- prevents black border on click */
    }

        .equal-tab:hover {
            background-color: #615677 !important;
            color: #ffffff !important;
            border-color: #615677 !important;
        }

        .equal-tab:focus,
        .equal-tab.active {
            background-color: #615677 !important;
            color: #ffffff !important;
            border-color: #615677 !important;
            outline: none !important;
            box-shadow: none !important;
        }


    /* Add to your existing style section */
    .btn-spin {
        transition: transform 0.10s ease;
    }

    .rotate-refresh {
        animation: spin 0.5s linear;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    #moveSearchBoxHere label {
        margin-right: 5px;
        margin-bottom: -101px !important;
    }
</style>

@section Styles {

    <link rel="stylesheet" href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/css/components.css" />
    <link href="~/Content/css/MaintainanceManagementSY.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/modules/izitoast/css/iziToast.min.css" />

}



@section Scripts {
    <script src="~/Content/modules/moment.min.js"></script>
    <script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/modules/datatables/datatables.min.js"></script>
    <script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
    <script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            if (window.location.pathname.toLowerCase().includes("maintenance")) {

                if (!sessionStorage.getItem("maintenanceRefreshed")) {
                    sessionStorage.setItem("maintenanceRefreshed", "true");
                    location.reload();
                } else {
                    sessionStorage.removeItem("maintenanceRefreshed");
                }
            }
        });
        // Show loader when page is loading
        $(window).on('load', function () {
            $('#listLoader').fadeOut(500);
        });

        $(document).ready(function () {
            let displayFormat = 'DD-MM-YYYY';
            let currentTabStatus = 'Completed'; // Default to Paid
            let userSelectedDates = null;
            const colSelectAll = 0;
            const colSrNo = 1;
            const colWing = 2;
            const colFlatNo = 3;
            const colFullName = 4;
            const colEmail = 5;
            const colMaintenance = 6;
            const colTotalAmount = 7;
            const colPaidAmount = 8;
            const colPenaltyPct = 9;
            const colPenaltyAmt = 10;
            const colFinalPayable = 11;
            const colScheduleDate = 12;
            const colPaidDate = 13;
            const colStatus = 14;
            const colAction = 15;


            // ✅ Initialize Date Range Picker
            function initializeDateRangePicker() {
                $('#customDateRange').daterangepicker({
                    locale: { format: displayFormat },
                    drops: 'down',
                    autoUpdateInput: true,
                    opens: 'right',
                    ranges: {
                        'Today': [moment(), moment()],
                        'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                        'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                        'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                        'This Month': [moment().startOf('month'), moment().endOf('month')],
                        'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                    },
                    startDate: moment().startOf('month'),
                    endDate: moment()
                }, function (start, end) {
                    const from = start.format(displayFormat);
                    const to = end.format(displayFormat);

                    $('#customDateRange').val(from + ' - ' + to);
                    $('#fromDate1').val(from);
                    $('#toDate1').val(to);
                    userSelectedDates = { from, to };
                    reloadTable();
                });

                // Set default values
                const start = moment().startOf('month').format(displayFormat);
                const end = moment().format(displayFormat);
                $('#fromDate1').val(start);
                $('#toDate1').val(end);
                $('#customDateRange').val(start + ' - ' + end);
            }

            // ✅ Function to reload table with correct filter
            function reloadTable() {
                $('#maintenanceTable').DataTable().draw();
            }

            // ✅ Handle tab switching (Paid/Unpaid)
            $('.equal-tab').on('click', function () {
                $('.equal-tab').removeClass('active');
                $(this).addClass('active');

                currentTabStatus = $(this).data('status');

                // Update column visibility based on tab
                updateColumnVisibility();

                // Reset date range if no user selection
                if (!userSelectedDates) {
                    const start = moment().startOf('month').format(displayFormat);
                    const end = moment().format(displayFormat);
                    $('#fromDate1').val(start);
                    $('#toDate1').val(end);
                    $('#customDateRange').val(start + ' - ' + end);
                }

                reloadTable();
            });

            // ✅ Update column visibility based on current tab
            function updateColumnVisibility() {
                const table = $('#maintenanceTable').DataTable();

                if (currentTabStatus === 'Completed') {
                    // ✅ Completed (Paid) Tab
                    table.column(colSelectAll).visible(true);
                    table.column(colSrNo).visible(true);
                    table.column(colWing).visible(false);
                    table.column(colFlatNo).visible(true);
                    table.column(colFullName).visible(true);
                    table.column(colEmail).visible(false);
                    table.column(colMaintenance).visible(true);
                    table.column(colTotalAmount).visible(true);
                    table.column(colPaidAmount).visible(true);
                    table.column(colPenaltyPct).visible(false);
                    table.column(colPenaltyAmt).visible(true);
                    table.column(colFinalPayable).visible(false);
                    table.column(colScheduleDate).visible(false);
                    table.column(colPaidDate).visible(true);
                    table.column(colStatus).visible(false);
                    table.column(colAction).visible(true);
                } else {
                    // ✅ Unpaid Tab
                    table.column(colSelectAll).visible(true);
                    table.column(colSrNo).visible(true);
                    table.column(colWing).visible(false);
                    table.column(colFlatNo).visible(true);
                    table.column(colFullName).visible(true);
                    table.column(colEmail).visible(false);
                    table.column(colMaintenance).visible(true);
                    table.column(colTotalAmount).visible(true);
                    table.column(colPaidAmount).visible(false);
                    table.column(colPenaltyPct).visible(false);
                    table.column(colPenaltyAmt).visible(false);
                    table.column(colFinalPayable).visible(true);
                    table.column(colScheduleDate).visible(true);
                    table.column(colPaidDate).visible(false);
                    table.column(colStatus).visible(false);
                    table.column(colAction).visible(true);
                }
            }
            // ✅ Custom DataTable filter
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                const min = $('#fromDate1').val();
                const max = $('#toDate1').val();
                const currentTab = currentTabStatus;

                // ✅ Status column index = 14
                const status = data[14]?.trim();
                if (!status || status !== currentTab) return false;

                // जर from आणि to दोन्ही रिकामे असतील → सर्व records दिसतील
                if (!min && !max) return true;

                const minDate = moment(min, "DD-MM-YYYY");
                const maxDate = moment(max, "DD-MM-YYYY");

                // ✅ Schedule Date column index = 12 (दोन्ही tabs साठी)
                const dateStr = data[12]?.trim();
                let filterDate = null;

                if (dateStr && dateStr !== "-") {
                    filterDate = moment(dateStr, "DD-MM-YYYY", true);
                }

                // जर date invalid असेल तर filter लागू होऊ नये
                if (!filterDate || !filterDate.isValid()) {
                    return !min && !max;
                }

                return (!min || filterDate.isSameOrAfter(minDate, 'day')) &&
                    (!max || filterDate.isSameOrBefore(maxDate, 'day'));
            });


            // Initialize date range picker
            initializeDateRangePicker();

            // Initialize DataTable
            var table = $('#maintenanceTable').DataTable({
                pageLength: 10,
                lengthChange: true,
                searching: true,
                ordering: true,
                autoWidth: false,
                responsive: true,
                dom: 'Bfrtip',
                language: {
                    infoFiltered: "",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                buttons: [
                    {
                        extend: 'csvHtml5',
                        text: '<img src="/Content/img/icons8-csv-64.png" alt="CSV" style="height:32px;" title="Export CSV" />',
                        className: 'export-buttons icon-only-btn',
                        title: null,
                        filename: 'Green_Valley_Society_' + moment().format("DD-MM-YYYY_hh-mm-A"),
                        exportOptions: {
                            rows: function (idx, data, node) {
                                return $(node).find('input.selectRow').is(':checked');
                            },
                            columns: function (idx, data, node) {
                                const currentTabStatus = $('.equal-tab.active').data('status');
                                if (currentTabStatus === 'Completed') {
                                    return [1, 3, 4, 6, 7, 8, 10, 13]; // Exclude action column 15
                                } else {
                                    return [1, 3, 4, 6, 7, 9, 10, 11, 12]; // Exclude action column 16
                                }
                            },
                            format: {
                                body: function (data, row, col, node) {
                                    if (col === 0) return (row + 1).toString(); // Sr.No auto numbering
                                    return $(node).attr('data-export') || $(node).text().replace(/"/g, '').trim();
                                }
                            }
                        },
                        customize: function (csv) {
                            const BOM = '\uFEFF'; // UTF-8 BOM for Excel to recognize UTF-8 encoding

                            const lines = csv.trim().split('\n');
                            const title = 'Green Valley Society - ' + getActiveTabLabel();
                            const timestamp = 'Generated on: ' + moment().format('DD-MM-YYYY hh:mm A');
                            const titleLine = `,,,${title}`;
                            const timestampLine = `,,,${timestamp}`;
                            const blankLine = '';

                            const currentTabStatus = $('.equal-tab.active').data('status');
                            let headers = [];

                            // Define headers consistently with columns excluded "Action"
                            if (currentTabStatus === 'Completed') {
                                headers = ['Sr.No', 'Flat No', 'Full Name', 'Maintenance Type', 'Total Amount(₹)', 'Paid Amount(₹)', 'Penalty Amount(₹)', 'Paid Date'];
                            } else {
                                headers = ['Sr.No', 'Flat No', 'Full Name', 'Maintenance Type', 'Total Amount(₹)', 'Months Pending', 'Pending Amount(₹)', 'Final Payable(₹)', 'Schedule Date'];
                            }

                            // Rebuild data rows with correct Sr.No
                            const dataRows = lines.slice(1).map((line, index) => {
                                const cols = line.split(',').map(col => col.trim());
                                cols[0] = (index + 1).toString(); // Ensure Sr.No is properly numbered
                                return cols.join(',');
                            });

                            // Return CSV text with title, timestamp, blank line, headers, and data rows
                            return BOM + [
                                titleLine,
                                timestampLine,
                                blankLine,
                                headers.join(','),
                                ...dataRows
                            ].join('\n');
                        },
                        action: function (e, dt, button, config) {
                            if ($('.selectRow:checked').length === 0) {
                                showStislaToast('warning', 'No Rows Selected', 'Please select at least one row to export.');
                                return;
                            }

                            const currentTabStatus = $('.equal-tab.active').data('status');
                            if (currentTabStatus === 'Completed') {
                                config.exportOptions.columns = [1, 3, 4, 6, 7, 8, 10, 13]; // Exclude action column 15
                            } else {
                                config.exportOptions.columns = [1, 3, 4, 6, 7, 9, 10, 11, 12]; // Exclude action column 16
                            }

                            swal({
                                icon: 'success',
                                title: 'CSV Exported',
                                text: 'Your CSV file has been downloaded successfully!',
                                timer: 2000,
                                buttons: false
                            });

                            $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);

                            setTimeout(function () {
                                dt.rows().nodes().to$().find('.selectRow').prop('checked', false);
                                $('#selectAll').prop('checked', false);
                            }, 100);
                        }
                    },


                    {
                        extend: 'excelHtml5',
                        text: '<img src="/Content/img/icons8-xls-64.png" style="height:32px;" title="Export Excel" />',
                        className: 'export-buttons icon-only-btn',
                        title: null,
                        filename: 'Green_Valley_Society_' + moment().format("DD-MM-YYYY_hh-mm-A"),
                        exportOptions: {
