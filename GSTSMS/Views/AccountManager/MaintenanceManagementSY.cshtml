            $('#maintenanceTypeFilter').on('change', function () {
                var selectedType = $(this).val();
                table.column(6).search(selectedType).draw();
            });

            // Wing Filter
            $('#wingFilter').on('change', function () {
                var selectedWing = $(this).val();
                if (selectedWing === "All Wing" || selectedWing === "") {
                    table.column(3).search("").draw();
                } else {
                    table.column(3).search("^" + selectedWing, true, false).draw();
                }
            });


            // Custom Penalty Filter
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

                var selected = $('#penaltyFilter').val();

                // Get raw penalty text from column 10
                var penaltyText = data[10] || "0";


                penaltyText = penaltyText.replace(/<[^>]*>/g, "");
                penaltyText = penaltyText.replace(/[^0-9.]/g, "");

                var penalty = parseFloat(penaltyText) || 0;

                if (selected === "withPenalty") {
                    return penalty > 0;
                }

                if (selected === "withoutPenalty") {
                    return penalty === 0;
                }

                return true;
            });

            // Dropdown trigger
            $('#penaltyFilter').on('change', function () {
                table.draw();
