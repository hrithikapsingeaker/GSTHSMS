                            // ---------- Header + Sr.No + Custom CSV ----------
                            customize: function (csv) {
                                // Date-Time format
                                const now = new Date();
                                const day = now.getDate().toString().padStart(2, '0');
                                const month = (now.getMonth() + 1).toString().padStart(2, '0');
                                const year = now.getFullYear();
                                let hours = now.getHours();
                                const minutes = now.getMinutes().toString().padStart(2, '0');
                                const ampm = hours >= 12 ? 'PM' : 'AM';
                                hours = hours % 12 || 12;
                                hours = hours.toString().padStart(2, '0');
                                const formattedDate = `${day}-${month}-${year} ${hours}:${minutes}${ampm}`;

                                const bom = '\uFEFF';
                                const pad = ' '.repeat(20);

                                // Active tab वरून title
                                const activeTab = $('.nav-tabs .nav-link.active');
                                let title = 'Notice List';

                                if (activeTab.length) {
                                    const href = activeTab.attr('href');
                                    if (href === '#all') title = 'All Notice List';
                                    else if (href === '#accountant') title = 'Accountant Created Notice List';
                                    else if (href === '#expired') title = 'Expired Notice List';
                                }

                                const headerTitle = `${pad}GreenValley Society - ${title}`;
                                const headerDate = `${pad}Generated on: ${formattedDate}`;

                                // Active table
                                const table = $('.tab-pane.active table').DataTable();
                                const isExpired = table.table().node().id === 'expiredNoticesTable';

                                // CSV rows split
                                let rows = csv.split('\n').filter(r => r.trim() !== '');

                                if (isExpired) {
                                    // ---------- Expired Notices साठी: header आणि data manually तयार कर ----------
                                    // मान्य करून layout:
                                    // 0: Checkbox, 1: Sr.No, 2: Title, 3: Description, 4: Publish Date, 5: End Date, 6: Actions
                                    rows = [];

                                    // Custom header (Sr.No पासून)
                                    rows.push('Sr.No,Title,Description,Publish Date,End Date');

                                    // Data rows
                                    table.rows({ filter: 'applied' }).every(function (rowIdx) {
                                        const rowNode = this.node();

                                        const rowData = [
                                            rows.length, // Sr.No (1 पासून सुरू)
                                            $(rowNode).find('td:eq(2)').text().trim(), // Title
                                            $(rowNode).find('td:eq(3)').text().trim(), // Description
                                            $(rowNode).find('td:eq(4)').text().trim(), // Publish Date
                                            $(rowNode).find('td:eq(5)').text().trim()  // End Date
                                        ];

                                        rows.push(rowData.join(','));
                                    });
                                } else {
                                    // ---------- All & Accountant साठी: CSV आधी DataTables ने generate केलेले + Sr.No reset ----------
                                    rows = rows.map((row, index) => {
                                        if (index === 0) return row; // existing header as it is (All मध्ये Notice Created By सुद्धा येईल)
                                        const rowData = row.split(',');
                                        rowData[0] = index; // Sr.No = line क्रमांक (1 पासून)
                                        return rowData.join(',');
                                    });
                                }

                                // Final CSV with BOM + header lines
                                return bom + `${headerTitle}\n${headerDate}\n\n${rows.join('\n')}`;
