<script>

    // Add this to your existing JavaScript
    document.querySelectorAll('details').forEach(details => {
        details.addEventListener('toggle', function () {
            // Close other dropdowns when one opens
            if (this.open) {
                document.querySelectorAll('details').forEach(other => {
                    if (other !== this) other.open = false;
                });
            }

            // Adjust scroll behavior
            const memberSection = document.querySelector('.select-member-section');
            if (this.open) {
                memberSection.style.overflowY = 'auto';
            } else {
                // Only disable overflow if no dropdowns are open
                const anyOpen = [...document.querySelectorAll('details')].some(d => d.open);
                if (!anyOpen) {
                    memberSection.style.overflowY = 'hidden';
                }
            }
        });
    });


