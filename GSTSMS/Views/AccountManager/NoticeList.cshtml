@section Scripts {
    <!-- ✅ JS Dependencies -->

    <script src="~/Content/modules/moment.min.js"></script>
    <script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/modules/datatables/datatables.min.js"></script>
    <script src="~/Content/modules/izitoast/js/iziToast.js"></script>
    <script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
    <script src="~/Content/modules/moment.min.js"></script>

    <script>




            $(document).ready(function () {
                // 🗓 Initialize Date Range Picker
                function initializeDateRangePicker() {
                    const format = 'DD-MM-YYYY';
                    $('.daterange-btn').daterangepicker({
                        locale: { format: format },
                        startDate: moment().startOf('month'),
                        endDate: moment(),
                        ranges: {
                            'Today': [moment(), moment()],
                            'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                            'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                            'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                            'This Month': [moment().startOf('month'), moment().endOf('month')],
                            'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                        }
                    }, function (start, end) {
                        $('#fromDate1').val(start.format(format));
                        $('#toDate1').val(end.format(format));
                        $('.daterange-btn span').html(start.format(format) + ' - ' + end.format(format));
                        allNoticesTable.draw();
                        accountantNoticesTable.draw();
                        expiredNoticesTable.draw();
                    });

                    $('#fromDate1').val(moment().startOf('month').format(format));
                    $('#toDate1').val(moment().format(format));
                    $('.daterange-btn span').html(moment().startOf('month').format(format) + ' - ' + moment().format(format));
                }
            initializeDateRangePicker();

                // 🔍 Custom Date Filter (for all 3 tabs)
                $.fn.dataTable.ext.search.push(function (settings, data) {
                    const format = 'DD-MM-YYYY';

                    const minVal = $('#fromDate1').val();
                    const maxVal = $('#toDate1').val();

                    if (!minVal && !maxVal) return true;

                    const tableId = settings.nTable.getAttribute('id');

                    let dateStr = '';

                    // ✅ All Notices + Expired Notices → Created Date / Publish Date column = index 5
                    if (tableId === "allNoticesTable" || tableId === "expiredNoticesTable") {
                        dateStr = data[5] || "";
                    }
                    // ✅ Accountant Created → Created Date column = index 4
                    else if (tableId === "accountantNoticesTable") {
                        dateStr = data[4] || "";
                    }
                    else {
                        return true; // बाकी table वर filter लागू करू नका
                    }

                    const rowDate = moment(dateStr, format, true);
                    if (!rowDate.isValid()) return true;

                    let min = null, max = null;
                    if (minVal) min = moment(minVal, format, true);
                    if (maxVal) max = moment(maxVal, format, true);

                    if (min && rowDate.isBefore(min, 'day')) return false;
                    if (max && rowDate.isAfter(max, 'day')) return false;

                    return true;
                });


            // 📦 Helper Functions
            function hasSelectedRows(table) {
                const selected = table.rows().nodes().to$().find('input.row-checkbox:checked').length;
            if (selected === 0) {
                iziToast.warning({
                    title: 'Warning',
                    message: 'Please select at least one notice to export',
                    position: 'topCenter'
                });
            return false;
                }
            return true;
            }

                function getSelectedRows(dt) {
                    var selected = [];

                    dt.rows({ search: 'applied' }).every(function () {
                        var $row = $(this.node());
                        if ($row.find('input.row-checkbox').prop('checked')) {
                            selected.push(this.data());
                        }
                    });

                    return selected;
                }

                function getExportButtons(table, title) {
                    return [
                        {
                            extend: 'csvHtml5',
                            text: '<img src="/Content/img/icons8-csv-64.png" alt="CSV" style="height:32px;" title="Export CSV" />',
                            className: 'export-buttons icon-only-btn',

                            // ---------- File Name ----------
                            filename: () => {
                                const activeTab = $('.nav-tabs .nav-link.active');
                                let label = 'Notice_List';

                                if (activeTab.length) {
                                    const href = activeTab.attr('href');
                                    if (href === '#all') label = 'All_Notices_List';
                                    else if (href === '#accountant') label = 'Accountant_Created_Notices_List';
                                    else if (href === '#expired') label = 'Expired_Notices_List';
                                }

                                return `${label}_${moment().format('YYYYMMDD_HHmmss')}`;
                            },

                            // ---------- काय-काय column जायचे ते ----------
                            exportOptions: {
                                // फक्त selected rows
                                rows: (idx, data, node) => $(node).find('input.row-checkbox').is(':checked'),

                                // कोणते columns export करायचे
                                columns: function (idx, data, node) {
                                    const table = $(node).closest('table');
                                    const isExpiredTable = table.attr('id') === 'expiredNoticesTable';
                                    const colCount = table.find('thead th').length;

                                    if (isExpiredTable) {
                                        // Expired टेबलसाठी – फक्त checkbox (0) exclude, बाकी सर्व (Notice Created By नाही)
                                        return idx !== 0;
                                    }

                                    // All / Accountant टेबलसाठी:
                                    //  - Checkbox (index 0) exclude
