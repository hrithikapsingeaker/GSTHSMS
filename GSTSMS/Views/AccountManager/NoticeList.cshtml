                            customize: function (xlsx) {
                                const sheet = xlsx.xl.worksheets['sheet1.xml'];
                                const styles = xlsx.xl['styles.xml'];

                                const cellXfs = styles.getElementsByTagName('cellXfs')[0];
                                const parser = new DOMParser();

                                // Description column साठी wrapText style
                                const wrapTextStyle = `
<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1">
    <alignment wrapText="1" vertical="top" horizontal="left"/>
</xf>
`;
                                const wrapStyleNode = parser.parseFromString(wrapTextStyle, 'application/xml').documentElement;
                                const wrapStyleId = cellXfs.childNodes.length;
                                cellXfs.appendChild(wrapStyleNode);

                                // बाकी सर्व cells साठी center alignment style
                                const centerAlignment = `
<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1">
    <alignment horizontal="center" vertical="center"/>
</xf>
`;
                                const centerStyleNode = parser.parseFromString(centerAlignment, 'application/xml').documentElement;
                                const centerStyleId = cellXfs.childNodes.length;
                                cellXfs.appendChild(centerStyleNode);

                                // सर्व rows
                                const rows = sheet.getElementsByTagName('row');

                                for (let i = 0; i < rows.length; i++) {
                                    const cells = rows[i].getElementsByTagName('c');

                                    for (let j = 0; j < cells.length; j++) {
                                        if (i === 2) {
                                            // Excel row 3 (0-based index 2) = header row -> center align
                                            cells[j].setAttribute('s', centerStyleId);
                                        } else {
                                            if (j === 2) {
                                                // 3rd column (Description) -> wrap text
                                                cells[j].setAttribute('s', wrapStyleId);
                                            } else {
                                                // बाकी data cells -> center align
