                let table;
                if (activeTabId === 'all') table = allNoticesTable;
                else if (activeTabId === 'accountant') table = accountantNoticesTable;
                else if (activeTabId === 'expired') table = expiredNoticesTable;

                if (table) {
                    table.rows().every(function () {
                        $(this.node()).find('.row-checkbox').prop('checked', isChecked);
                    });
                }
            });

            // 🟢 Initial Draw
            setTimeout(() => {
                    allNoticesTable.draw();
                accountantNoticesTable.draw();
                expiredNoticesTable.draw();
            }, 400);
            });

