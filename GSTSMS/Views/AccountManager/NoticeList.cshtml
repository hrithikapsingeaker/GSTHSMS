@model IEnumerable<GSTSMSLibrary.AccountManager.AccountManager>

@{
    ViewBag.Title = "Notice List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ✔ Safe conversions so View never breaks

    var allNotices = ViewBag.AllNotices as List<GSTSMSLibrary.AccountManager.AccountManager>
                     ?? new List<GSTSMSLibrary.AccountManager.AccountManager>();

    var accountantNotices = ViewBag.AccountantNotices as List<GSTSMSLibrary.AccountManager.AccountManager>
                            ?? new List<GSTSMSLibrary.AccountManager.AccountManager>();

    var expiredNotices = ViewBag.ExpiredNotices as List<GSTSMSLibrary.AccountManager.AccountManager>
                         ?? new List<GSTSMSLibrary.AccountManager.AccountManager>();
}



