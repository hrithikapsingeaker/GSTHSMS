@model GSTSMSLibrary.AccountManager.AccountManager

<div class="modal fade" id="addGSTModal" tabindex="-1" role="dialog" aria-labelledby="addGSTModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">



            <div class="modal-header bg-info text-white" style="justify-content: space-between; ">
                <h5 class="modal-title" id="addGSTModalLabel" style="margin-left: 115px;">Register New GST Type</h5>
                <button type="button" class="btn btn-dangerbn btn-sm" onclick="closeModal()">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <style>

                .ifsc-close-btn {
                    position: absolute;
                    top: 10px;
                    right: 15px;
                    background: transparent;
                    border: none;
                    color: white;
                    font-weight: bold;
                    font-size: 14px;
                    padding: 4px 10px;
                    cursor: pointer;
                }



                .text-danger {
                    font-size: 10px;
                    font-weight: normal !important;
                }




                .modal-body .text-right {
                    text-align: center !important;
                }


                .btn-success {
                    /*                     background-color: red !important;
                */ border: none;
                    color: white !important;
                }

                    .btn-success:hover {
                        color: black;
                    }
            </style>

            <div class="modal-body">
                @using (Html.BeginForm("AddGSTType", "AccountManager", FormMethod.Post, new { id = "gstForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="GSTTypeName">GST Type Name</label>
                        @Html.TextBox("GSTTypeName", null, new { @class = "form-control", maxlength = "06", placeholder = "e.g. CGST 18%" })
                        <span class="text-danger" id="GSTTypeNameError" style="display:none;">Please enter GST Type Name.</span>
                    </div>

                    <div class="form-group">
                        <label for="GSTPercentage">GST Percentage</label>
                        @Html.TextBox("GSTPercentage", null, new { @class = "form-control", maxlength = "03", placeholder = "e.g. 18.00", type = "text", step = "0.01" })
                        <span class="text-danger" id="GSTPercentageError" style="display:none;">Please enter a valid GST percentage.</span>
                    </div>

                    <div class="text-right">
                        <button type="submit" class="btn btn-success">Save GST</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>







<script>
    $('#saveGSTBtn').click(function (e) {
        e.preventDefault();

        let gstName = $('#GSTTypeName').val();
        let gstPercentage = $('#GSTPercentage').val();

        $.ajax({
            url: '/YourController/AddGSTType',
            type: 'POST',
            data: {
                GSTTypeName: gstName,
                GSTPercentage: gstPercentage
            },
            success: function (response) {
                if (response.success) {

                    $('#addGSTModal').modal('hide');




                    loadGSTDropdown();
                }
            }
        });
    });


    // 👉 Prevent digits in GST Type Name field
    $("#GSTTypeName").on("input", function () {
        this.value = this.value.replace(/[^a-zA-Z\s]/g, '');
    });



    $("#GSTPercentage").on("input", function () {
        this.value = this.value.replace(/[^0-9.%]/g, '').replace(/(%)+/g, '%');
    });




    function closeModal() {
        $('#addGSTModal').modal('hide');
    }

    $(document).ready(function () {
        // Real-time validation
        function validateInput(selector, errorSelector, validatorFn, errorMessage) {
            $(selector).on('input blur', function () {
                const value = $(this).val().trim();
                if (!validatorFn(value)) {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                    $(errorSelector).text(errorMessage).show();
                    setTimeout(() => $(errorSelector).fadeOut(), 3000);
                } else {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                    $(errorSelector).hide();
                }
            });
        }

        // Real-time field checks
        validateInput("#GSTTypeName", "#GSTTypeNameError", val => val !== "", "Please enter GST type name.");
        validateInput("#GSTPercentage", "#GSTPercentageError", val => val !== "" && !isNaN(val) && parseFloat(val) > 0, "Please enter valid GST .");


        // On Submit
        $('#gstForm').submit(function (e) {
            e.preventDefault();
            let isValid = true;

            const gstType = $('#GSTTypeName').val().trim();
            const gstPercent = $('#GSTPercentage').val().trim();

            if (gstType === "") {
                $('#GSTTypeName').addClass('is-invalid').removeClass('is-valid');
                $('#GSTTypeNameError').text("Please enter GST type name.").show();
                setTimeout(() => $('#GSTTypeNameError').fadeOut(), 3000);
                isValid = false;
            } else {
                $('#GSTTypeName').removeClass('is-invalid').addClass('is-valid');
                $('#GSTTypeNameError').hide();
            }

            if (gstPercent === "" || isNaN(gstPercent) || parseFloat(gstPercent) <= 0) {
                $('#GSTPercentage').addClass('is-invalid').removeClass('is-valid');
                $('#GSTPercentageError').text("Please enter valid GST %.").show();
                setTimeout(() => $('#GSTPercentageError').fadeOut(), 3000);
                isValid = false;
            } else {
                $('#GSTPercentage').removeClass('is-invalid').addClass('is-valid');
                $('#GSTPercentageError').hide();
            }

            if (!isValid) return;

            // Submit via AJAX
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        $('#addGSTModal').modal('hide');
                        swal({
                            icon: 'success',
                            title: 'Success',
                            text: 'GST Type added successfully!',

                            buttons: false,
                            timer: 2000
                        });
                    } else {
                        $('#addGSTModal .modal-content').html(res); // Error view
                    }
                },
                error: function () {
                    swal({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong while saving.'
                    });
                }
            });
        });
    });</script>
