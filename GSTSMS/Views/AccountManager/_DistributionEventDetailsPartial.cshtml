@model List<GSTSMSLibrary.AccountManager.AccountManager>
@{
    Layout = null;
    bool showDatePicker = ViewBag.ShowDatePicker ?? true;
}

<div class="modal-body p-2">
    @if (Model != null && Model.Count > 0)
    {
        if (showDatePicker)
        {
            <div class="seldate">
                <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon">
                    <i class="fas fa-calendar"></i> <span>Choose Date</span>
                </a>
                <input type="hidden" id="fromDate" />
                <input type="hidden" id="toDate" />
            </div>
        }

        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover table-striped dataTableExport mb-0" id="distributionEventTable" style="width:100%; table-layout: fixed;">
                <thead class="text-center">
                    <tr>
                        <th style="width: 30px; text-align: center; vertical-align: middle; padding: 0;">
                            <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                                <input type="checkbox" id="select-distribution-all" class="form-check-input m-0" style="position: static; transform: none;" />
                            </div>
                        </th>
                        <th style="width: 40px;">Sr.no</th>
                        <th style="width: 150px;">Event Name</th>
                        <th style="width: 150px;">Date</th>
                        <th style="width: 150px;">Distribution Category</th>
                        <th style="width: 130px;">Allocated Budget(₹) </th>
                        <th style="width: 130px;">Actual Cost(₹) </th>
                        <th style="width: 130px;">Difference(₹) </th>
                        <th style="width: 100px;">Document</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @{
                        var groupedEvents = Model.OrderBy(x => x.EventName).ThenBy(x => x.FromDate)
                                               .GroupBy(x => new { x.EventName, x.FromDate });

                        foreach (var eventGroup in groupedEvents)
                        {
                            bool isFirstRow = true;

                            foreach (var item in eventGroup)
                            {
                                var diff = item.AllocatedBudget - item.ActualCost;
                                var diffClass = diff >= 0 ? "text-success" : "text-danger";

                                <tr class="text-center"
                                    data-row-id="@($"{item.EventName}_{item.FromDate.Ticks}_{item.DistributionCategory}".Replace(" ", "_"))"
                                    data-event-name="@item.EventName"
                                    data-event-date="@item.FromDate.ToString("yyyy-MM-dd")">
                                    <td style="padding: 0; position: relative;">
                                        <input type="checkbox" class="form-check-input row-checkbox m-0" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);" />
                                    </td>
                                    <td></td> <!-- EMPTY TD FOR SERIAL NUMBER -->
                                    <td>
                                        @if (isFirstRow)
                                        {
                                            @item.EventName
                                        }
                                    </td>
                                    <td data-full-date="@item.FromDate.ToString("yyyy-MM-dd")">
                                        @if (isFirstRow)
                                        {
                                            @item.FromDate.ToString("dd-MM-yyyy")
                                        }
                                    </td>
                                    <td>@item.DistributionCategory</td>
                                    <td>₹@item.AllocatedBudget</td>
                                    <td>₹@item.ActualCost</td>
                                    <td class="text-center font-weight-bold @diffClass">₹@diff</td>
                                    @*<td>
                                            @if (!string.IsNullOrEmpty(item.Document))
                                            {
                                                <a href="@item.Document" target="_blank" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span>No Document</span>
                                            }
                                        </td>*@

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Document))
                                    {
                                        <a href="@Url.Content(item.Document)" target="_blank" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span>No Document</span>
                                    }
                                </td>


                                </tr>

                                isFirstRow = false;
                            }
                        }
                    }
                </tbody>
                <tfoot class="text-center font-weight-bold">
                    <tr>
                        <td colspan="5" class="text-right">Total</td>
                        <td id="totalAllocated">₹0</td>
                        <td id="totalActual">₹0</td>
                        <td id="totalDifference">₹0</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No distribution event data found.</div>
    }
</div>

