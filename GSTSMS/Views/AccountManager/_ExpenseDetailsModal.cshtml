            ]
        }
    ]
});



        // ✅ Table Styling
        const tableContent = doc.content.find(obj => obj.table);
        if (tableContent) {
            // Add Sr. No
            tableContent.table.body.forEach((row, i) => {
                if (i > 0) row[0].text = i;
            });

            // ✅ Fix all column widths = 120px
            tableContent.table.widths = [50, 90, 90, 120, 120, 120, 120];

            tableContent.layout = {
                hLineWidth: () => 0.5,
                vLineWidth: () => 0.5,
                hLineColor: () => '#000',
                vLineColor: () => '#000',
                paddingLeft: () => 4,
                paddingRight: () => 4,
                paddingTop: () => 3,
                paddingBottom: () => 3
            };

            // ✅ Center Align + Currency Symbol
            tableContent.table.body.forEach((row, rIndex) => {
                row.forEach((cell, cIndex) => {
                    if (typeof cell === 'object') {
                        cell.alignment = 'center';
                        if (cIndex === 1 && rIndex > 0) {
                            cell.text = '₹' + cell.text;
                        }
                    }
                });
            });
        }

        // ✅ Table Header Style
        doc.styles.tableHeader = {
            fontSize: 11,
            bold: true,
            alignment: 'center',
            fillColor: '#615677',
            color: '#ffffff'
        };

        // ✅ Default Font Style
        doc.defaultStyle.fontSize = 10;
    },
    action: function (e, dt, button, config) {
        var selected = dt.rows().nodes().to$().find('.row-checkbox:checked');
        if (selected.length === 0) {
            iziToast.warning({
                title: 'Warning',
                message: 'Please select at least one row to export PDF.',
                position: 'topCenter'
            });
            return;
        }
        $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);

        swal({
            icon: 'success',
            title: 'PDF Exported',
            text: 'Your PDF file has been downloaded successfully!',
            timer: 2000,
            buttons: false
        });

        // ✅ clear checkboxes after export
        setTimeout(function () {
            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
            $('#select-all-txn').prop('checked', false);
        }, 100);
    }
},



