            // Account No Masking Function
            function maskAccountNo(accNo) {
                if (!accNo || accNo === "N/A" || accNo.trim() === "") return "N/A";

                // Remove all spaces and special characters
                let clean = accNo.replace(/[\s\-]/g, '');

                // Check if it's a valid number
                if (clean.length <= 4) return clean;

                // Return last 4 digits with stars
                return '*'.repeat(clean.length - 4) + clean.slice(-4);
            }

            // Helper function for formatting (keeps original for backend use)
            function formatAccountNoForDisplay(accNo) {
                return maskAccountNo(accNo);
            }


        function getFormattedDateTime() {
            const now = new Date();
            const datePart = now.getDate().toString().padStart(2, '0') + '-' +
                (now.getMonth() + 1).toString().padStart(2, '0') + '-' +
                now.getFullYear();
            let hours = now.getHours();
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12;
            return {
                date: datePart,
                time: hours.toString().padStart(2, '0') + ':' + minutes + ' ' + ampm
            };
        }

        function getExportHeader() {
    let dt = getFormattedDateTime();
    let totalAmount = '@Model.AllTransactions.Sum(x => x.TransactionAmount).ToString("N2")';
    return (
        'Green Valley Society - Expense Transaction\n' +
        'Generated on: ' + dt.date + ' ' + dt.time + '\n\n' +
        'Business Name:,@Model.BusinessName\n' +
        'Vendor Name:,@Model.VendorName\n' +
        'Expense Name:,@Model.ExpenseName\n' +
        'Total Amount:,"₹' + totalAmount + '"\n\n'
    );
}


        var table = $('#transactionTable').DataTable({
            dom: 'Bfrtip',
            ordering: false,
            searching: false,
            paging: false,
            info: false,
            buttons: [

{
    extend: 'excelHtml5',
    text: '<img src="/Content/img/icons8-xls-64.png" style="height:25px;" title="Export Excel" />',
    className:'transparent-btn',
    title: null,
    messageTop: function () {
        let dt = getFormattedDateTime();
        return [
            'Green Valley Society - Expense Transaction',
            'Generated on: ' + dt.date + ' ' + dt.time,
            'Business Name: ' + '@Html.Raw(Model.BusinessName)',
            'Vendor Name: mukesh shendre',
            'Expense Type: Direct',
            'Name: Water Bill',
            'Total Amount: ₹' + '@Model.AllTransactions.Sum(x => x.TransactionAmount).ToString("N2")'
        ].join('\n');
    },
    exportOptions: {
        rows: function (idx, data, node) {
            return $('.row-checkbox:checked').length === 0 || $(node).find('.row-checkbox').is(':checked');
        },
        columns: ':visible:not(:first-child)',
        format: {
            body: function (data, row, col) {
                if (col === 0) return row + 1; // Sr. No.
                if (col === 1 && row >= 0) return '₹' + data.replace(/[₹,]/g, '');

                return data.replace(/(\r\n|\n|\r)/gm, ' ');
            }
        }
    },
    customize: function (xlsx) {
        var sheet = xlsx.xl.worksheets['sheet1.xml'];
        var styles = xlsx.xl['styles.xml'];

        // Extract metadata lines and remove original
        var messageLines = $('row[r="1"] c t', sheet).text().split('\n');
        $('row[r="1"]', sheet).remove();

        // Shift existing rows down by number of metadata lines
        $('row', sheet).each(function () {
            var r = parseInt($(this).attr('r'));
            $(this).attr('r', r + messageLines.length);
            $(this).find('c').each(function () {
                var col = $(this).attr('r').replace(/[0-9]/g, '');
                $(this).attr('r', col + (r + messageLines.length));
            });
        });

        // Convert Amount column to inline string (if in column E)
        $('row c[r^="E"]', sheet).each(function () {
            var cell = $(this);
            var value = cell.text().trim();
            cell.attr('t', 'inlineStr');
            cell.empty().append('<is><t>' + value + '</t></is>');
        });

        // -------------------- Styles --------------------
        // White font
        var fontId = $(styles).find('fonts font').length;
        $(styles).find('fonts').append('<font><sz val="12"/><color rgb="FFFFFFFF"/><name val="Calibri"/></font>');

        // Purple fill
        var fillId = $(styles).find('fills fill').length;
        $(styles).find('fills').append('<fill><patternFill patternType="solid"><fgColor rgb="FF615677"/><bgColor indexed="64"/></patternFill></fill>');

        // Header style: white font + purple bg + center
        var headerStyleId = $(styles).find('cellXfs xf').length;
        $(styles).find('cellXfs').append(
            '<xf numFmtId="0" fontId="' + fontId + '" fillId="' + fillId + '" borderId="0" xfId="0" applyFont="1" applyFill="1" applyAlignment="1">' +
            '<alignment horizontal="center" vertical="center"/></xf>'
        );

        // Center alignment for table data
        var centerNoBgId = $(styles).find('cellXfs xf').length;
        $(styles).find('cellXfs').append(
            '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1">' +
            '<alignment horizontal="center" vertical="center"/></xf>'
        );

        // Left alignment for metadata
        var leftAlignId = $(styles).find('cellXfs xf').length;
        $(styles).find('cellXfs').append(
            '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1">' +
            '<alignment horizontal="left" vertical="center"/></xf>'
        );

        // -------------------- Add Metadata Rows --------------------
        var newRows = '';
        for (let i = 0; i < messageLines.length; i++) {
            let styleId = (i <= 1) ? centerNoBgId : leftAlignId;
            newRows +=
                '<row r="' + (i + 1) + '">' +
                '<c t="inlineStr" s="' + styleId + '" r="A' + (i + 1) + '">' +
                '<is><t>' + messageLines[i] + '</t></is></c>' +
                '</row>';
        }
        $('sheetData', sheet).prepend(newRows);

        // Merge metadata cells
        $('mergeCells', sheet).remove();
        $(sheet).find('worksheet').append(
            '<mergeCells count="' + messageLines.length + '">' +
            Array.from({ length: messageLines.length }, (_, i) =>
                '<mergeCell ref="A' + (i + 1) + ':G' + (i + 1) + '"/>'
            ).join('') +
            '</mergeCells>'
        );

        // -------------------- Header Row --------------------
        var headerRowIndex = messageLines.length + 1;
        $('row[r="' + headerRowIndex + '"] c', sheet).attr('s', headerStyleId);

        // -------------------- Table Data --------------------
        $('row', sheet).each(function () {
            var r = parseInt($(this).attr('r'));
            if (r > headerRowIndex) {
                $(this).find('c').attr('s', centerNoBgId);
            }
        });

        // -------------------- Narrow Columns --------------------
        $('col', sheet).each(function () {
            $(this).attr('width', 12);
        });
    },
    action: function (e, dt, button, config) {
        var selected = dt.rows().nodes().to$().find('.row-checkbox:checked');
        if (selected.length === 0) {
            iziToast.warning({ title: 'Warning', message: 'Please select at least one row to export Excel.', position: 'topCenter' });
            return;
        }
        $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);
        swal({ icon: 'success', title: 'Excel Exported', text: 'Your Excel file has been downloaded successfully!', timer: 2000, buttons: false });

        // ✅ clear checkboxes
        setTimeout(function () {
            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
            $('#select-all-txn').prop('checked', false);
        }, 100);
    }
},


            // CSV
     {
    extend: 'csvHtml5',
         text: '<img src="/Content/img/icons8-csv-64.png" style="height:25px;" title="Export CSV" />',
         className: 'transparent-btn',
    title: null,
    customize: function (csv) {
        // Add BOM for UTF-8 and prepend custom header
        return '\uFEFF' + getExportHeader() + csv;
    },
    exportOptions: {
        rows: function (idx, data, node) {
            return $(node).find('.row-checkbox').is(':checked');
        },
        columns: ':visible:not(:first-child)',
        format: {
            body: function (data, row, col) {
                // Sr. No. column (just return index+1)
                if (col === 0) return row + 1;

                // Amount column (col === 1) - prepend ₹
                if (col === 1 && row >= 0) {
                    return '₹' + data.replace(/[₹,]/g, '').trim();
                }

                // Paid Date column (last column, e.g., col === 6) - format to 12hr
                if (col === 6 && data) {
                    let dateObj = new Date(data);
                    if (!isNaN(dateObj.getTime())) {
                        let day = dateObj.getDate().toString().padStart(2, '0');
                        let month = (dateObj.getMonth() + 1).toString().padStart(2, '0');
                        let year = dateObj.getFullYear();
                        let hours = dateObj.getHours();
                        let minutes = dateObj.getMinutes().toString().padStart(2, '0');
                        let ampm = hours >= 12 ? 'PM' : 'AM';
                        hours = hours % 12 || 12;
                        return `${day}-${month}-${year} ${hours}:${minutes} ${ampm}`;
                    }
                }

                // Default: clean line breaks & center align
                return `"${data.replace(/(\r\n|\n|\r)/gm, ' ').trim()}"`;
            }
        }
    },
    action: function (e, dt, button, config) {
        var selected = dt.rows().nodes().to$().find('.row-checkbox:checked');
        if (selected.length === 0) {
            iziToast.warning({
                title: 'Warning',
                message: 'Please select at least one row to export CSV.',
                position: 'topCenter'
            });
            return;
        }
        $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);
        swal({
            icon: 'success',
            title: 'CSV Exported',
            text: 'Your CSV file has been downloaded successfully!',
            timer: 2000,
            buttons: false
        });
        // ✅ clear checkboxes
        setTimeout(function () {
            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
            $('#select-all-txn').prop('checked', false);
        }, 100);
    }
                },



