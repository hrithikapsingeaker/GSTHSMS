            //    if (!accNo || accNo === "N/A") return accNo;
            //    let clean = accNo.replace(/\s+/g, ''); // spaces काढून टाका
            //    if (clean.length <= 4) return clean;
            //    return '*'.repeat(clean.length - 4) + clean.slice(-4);
