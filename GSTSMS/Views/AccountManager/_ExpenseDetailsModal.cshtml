@model GSTSMSLibrary.AccountManager.AccountManager
<!-- Modal Start -->
<div class="modal custom-fade-center" id="expenseDetailsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered custom-modal-xl">
        <div class="modal-content">
            <div class="modal-header custom-modal-header">
                <h5 class="modal-title w-100 text-center" style="margin-top: -15px !important; margin-left: -5px!important;">Expense Details</h5>
                <button type="button" class="btn-close-modal" onclick="closeModal()">
                    <i class="fa fa-times"></i>
                </button>

            </div>
            <div class="modal-body scroll-modal" id="expenseModalBody">
                <div class="container-fluid">

                    <!-- Vendor Info -->
                    <h6 class="section-heading-all" style="font-size: 18px">Vendor Information</h6>
                    <hr />
                    <div class="row mb-3">
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Business Name</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.BusinessName</span>
                        </div>
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Vendor Name</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.VendorName</span>
                        </div>
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Email</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.Email</span>
                        </div>
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Contact No</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.PhoneNumber</span>
                        </div>
                        <div class="col-md-12 d-flex mb-2">
                            <label class="expense-label">Address</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.Address</span>
                        </div>
                    </div>

                    <!-- Expense Info -->
                    <h6 class="section-heading-all" style="font-size: 18px">Expense Information</h6>
                    <hr />
                    <div class="row mb-3">
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Expense Type</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.ExpenseType</span>
                        </div>
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Name</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.ExpenseName</span>
                        </div>
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Description</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.Description</span>
                        </div>
                        <div class="col-md-6 d-flex mb-2">
                            <label class="expense-label">Added Date</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.AddedDate.ToString("dd-MM-yyyy")</span>
                        </div>
                    </div>

                    <!-- Transactions -->
                    <h6 class="section-heading-all" style="font-size: 18px">Transaction Information</h6>
                    <hr />
                    <div class="row align-items-center mb-2">
                        <div class="col-md-6 d-flex">
                            <label class="expense-label">Total Transactions</label>
                            <span class="colon">:</span>
                            <span class="expense-data">@Model.AllTransactions.Count</span>
                        </div>
                        <div class="col-md-6 d-flex">
                            <label class="expense-label">Total Amount</label>
                            <span class="colon">:</span>
                            <span class="expense-data">₹@Model.AllTransactions.Sum(x => x.TransactionAmount).ToString("N2")</span>
                        </div>
                    </div>

                    @if (Model.AllTransactions != null && Model.AllTransactions.Any())
                    {
                        <div class="mb-2 d-flex align-items-center">
                            <button class="btn btn-outline-primary btn-sm mr-3" type="button" id="toggleTxnBtn">
                                <i class="fa fa-eye me-1"></i> View Transactions
                            </button>
                        </div>

                        <div class="collapse" id="transactionSection">
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm custom-table" id="transactionTable" style="width:100%">
                                    <thead class="bg-light text-dark">
                                        <tr>
                                            <th style="width: 30px; text-align: center; vertical-align: middle;">
                                                <input type="checkbox" style="margin-left:10px ; accent-color: #007bff;
                        width: 16px; height: 13px;
                        cursor: pointer;" id="select-all-txn" />
                                            </th>
                                            <th style="width: 40px; text-align:center;">Sr.No</th>
                                            <th>Amount</th>
                                            <th>Payment Mode</th>
                                            <th>Transaction Ref</th>
                                            <th class="ifsc-hide">IFSC</th>
                                            <th class="ifsc-hide">Bank Code</th>
                                            <th>Account No</th>
                                            <th>Bank Name</th>
                                            <th>Paid Date & Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sr = 1;
                                            foreach (var trx in Model.AllTransactions)
                                            {
                                                <tr>
                                                    <td style="text-align: center; vertical-align: middle; accent-color: #007bff; width: 16px; height: 16px; cursor: pointer; "><input type="checkbox" class="row-checkbox" /></td>
                                                    <td style="text-align:center;">@sr</td>
                                                    <td>₹@trx.TransactionAmount.ToString("N2")</td>
                                                    <td>@trx.PaymentMode</td>
                                                    <td>@(string.IsNullOrEmpty(trx.TransactionRef) ? "N/A" : trx.TransactionRef)</td>
                                                    <td class="ifsc-hide">@(string.IsNullOrEmpty(trx.IFSCCode) ? "-" : trx.IFSCCode)</td>
                                                    <td class="ifsc-hide">@(string.IsNullOrEmpty(trx.BankCode) ? "N/A" : trx.BankCode)</td>
                                                    <td>@(string.IsNullOrEmpty(trx.AccountNo) ? "N/A" : "*****" + trx.AccountNo.Substring(Math.Max(0, trx.AccountNo.Length - 4)))</td>
                                                    <td>@(string.IsNullOrEmpty(trx.BankName) ? "N/A" : trx.BankName)</td>
                                                    <td>@(trx.PaidDate.HasValue ? trx.PaidDate.Value.ToString("dd-MM-yyyy hh:mm tt") : "Not Paid")</td>
                                                </tr>
                                                sr++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No Transactions Found</div>
                    }

                    <!-- Attachments -->
                    <h6 class="section-heading-all mt-4">Attachments</h6>
                    <hr />
                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var doc in Model.Attachments)
                            {
                                <a href="@Url.Content(doc.Document)" target="_blank" class="text-primary me-3 mb-2">
                                    <i class="fa fa-file-alt mr-1"></i> @System.IO.Path.GetFileName(doc.Document)
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No Attachments</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .expense-label {
        min-width: 100px;
        font-weight: 500;
    }

    .colon {
        display: inline-block;
        width: 30px;
        text-align: center;
    }

    .expense-data {
        flex: 1;
    }

    .btn-close-modal {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        background: none;
        border: none !important;
        background-color: orangered;
        color: white;
        font-size: 16px;
        cursor: pointer;
        padding: 5px 10px;
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s;
        z-index: 1000;
        border-radius: 3px;
    }
        /* Remove outline and box-shadow on focus */
        .btn-close-modal:focus,
        .btn-close-modal:active {
            outline: none !important;
            box-shadow: none !important;
            border: none !important;
        }
    /* Remove default background + border on normal and hover */
    button.transparent-btn,
    button.transparent-btn:hover,
    button.transparent-btn:focus {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }
</style>


