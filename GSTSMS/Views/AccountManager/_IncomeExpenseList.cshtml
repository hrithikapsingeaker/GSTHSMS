@model List<GSTSMSLibrary.AccountManager.AccountManager>
@{
    Layout = null;
}


<div class="modal-body p-3">
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    else if (Model != null && Model.Count > 0)
    {






        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon">
                    <i class="fas fa-calendar"></i> <span>Choose Date</span>
                </a>
                <input type="hidden" id="fromDate" />
                <input type="hidden" id="toDate" />
            </div>

            <div class="d-flex align-items-center">
                <label class="mr-2 font-weight-bold mb-0">Filter by Type:</label>
                <select id="typeFilter" class="form-control form-control-sm mr-3" style="width: 150px;">
                    <option value="Income">Income</option>
                    <option value="Expense">Expense</option>
                </select>

                <div class="total-display ml-3">
                    <span class="font-weight-bold">Total: </span>
                    <span id="totalAmountDisplay">₹0.00</span>
                </div>
            </div>
        </div>



        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover table-striped dataTableExport mb-0" id="incomeExpenseTable" style="width:100%; table-layout: fixed;">
                <thead class="text-center">
                    <tr>
                        <th style="width: 30px; text-align: center; vertical-align: middle;">
                            <div class="d-flex justify-content-center align-items-center">
                                <input type="checkbox" id="select-all-income" class="form-check-input" />
                            </div>
                        </th>
                        <th style="width:40px;">Sr.no</th>
                        <th style="width:120px;">Paid Date</th>

                        <th style="width:100px;">Type</th>
                        <th style="width:250px;">Payment Purpose</th>
                        <th style="width:180px;">Payment By</th>
                        <th style="width:180px;">Paid To</th>
                        <th style="width:120px;">Amount (₹)</th>

                    </tr>
                </thead>
                <tbody class="small">
                    @{
                        int count = 1;
                        foreach (var item in Model)
                        {
                            <tr class="text-center">
                                <td>
                                    <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                                        <input type="checkbox" class="form-check-input row-checkbox" />
                                    </div>
                                </td>
                                <td>@count</td>
                                <td>@Html.Raw(item.PaidDate?.ToString("dd-MM-yyyy"))</td>
                                <td>@item.TypeLabel</td>
                                <td>@item.PaymentPurpose</td>
                                <td>@item.PaymentByName</td>
                                <td>@item.PaidToName</td>
                                <td class="text-center">₹@item.Amount.ToString("N2")</td>


                            </tr>
                            count++;
                        }
                    }
                </tbody>


            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No income or expense records found.</div>
    }
</div>




<style>

    /* Add this checkbox styling */
    input[type=checkbox], input[type=radio] {
        box-sizing: border-box;
        margin-left: 0px;
    }
    /* Rotation animation */
    @@keyframes rotate {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .rotate-refresh {
        animation: rotate 0.8s linear;
    }

    .modal-body {
        overflow-x: auto; /* Only show horizontal scroll if needed */
        overflow-y: hidden; /* Remove vertical scroll */
        max-height: none; /* Remove max-height restriction */
        padding: 0.75rem;
    }

    .table-responsive {
        overflow-x: auto;
        overflow-y: visible; /* Allow content to expand vertically */
    }

    #incomeExpenseTable {
        margin-bottom: 0 !important; /* Remove extra margin that might cause scrolling */
    }


    /* Custom Date Range Picker Styles */
    .daterangepicker {
        display: flex;
        flex-direction: row;
        padding: 10px;
        width: auto !important;
    }

        .daterangepicker .ranges {
            width: 180px;
            margin-right: 10px;
        }

        .daterangepicker .calendar {
            display: flex;
            flex-direction: row;
        }

        .daterangepicker .drp-calendar {
            padding: 10px;
        }

            .daterangepicker .drp-calendar.left {
                margin-right: 10px;
            }

        .daterangepicker .drp-buttons {
            clear: none;
            text-align: right;
            padding: 10px;
            border-top: 1px solid #ddd;
            display: flex;
            justify-content: flex-end;
        }

        .daterangepicker.show-ranges .drp-calendar.left {
            border-left: 1px solid #ddd;
        }

    .daterangepicker {
        display: none;
    }


    button.export-buttons.icon-only-btn {
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 5px;
    }

        /* 🔽 Optional: Remove hover background */
        button.export-buttons.icon-only-btn:hover {
            background-color: transparent !important;
            box-shadow: none !important;
        }
</style>

