<script>
    $(document).ready(function () {
        // Initialize Date Range Picker
        $('.daterange-btn').daterangepicker({
            opens: 'right',
            showDropdowns: false,
            autoUpdateInput: false,
            linkedCalendars: false,
            showCustomRangeLabel: true,
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            },
            locale: {
                format: 'DD-MM-YYYY',
                cancelLabel: 'Clear',
                applyLabel: 'Apply',
                customRangeLabel: 'Custom Range'
            }
        });

        // Declare table variable at higher scope
        var table;

        // Handle date picker apply event
        $('.daterange-btn').on('apply.daterangepicker', function (ev, picker) {
            $(this).html('<i class="fas fa-calendar"></i> ' +
                picker.startDate.format('DD-MM-YYYY') + ' - ' +
                picker.endDate.format('DD-MM-YYYY'));
            $('#fromDate').val(picker.startDate.format('YYYY-MM-DD'));
            $('#toDate').val(picker.endDate.format('YYYY-MM-DD'));
            if (table) {
                table.draw();
            }
        });

        // Handle date picker cancel event
        $('.daterange-btn').on('cancel.daterangepicker', function (ev, picker) {
            $(this).html('<i class="fas fa-calendar"></i> <span>Choose Date</span>');
            $('#fromDate').val('');
            $('#toDate').val('');
            if (table) {
                table.draw();
            }
        });

        // Add custom date filtering function
        $.fn.dataTable.ext.search.push(
            function (settings, data, dataIndex) {
                var fromDate = $('#fromDate').val();
                var toDate = $('#toDate').val();

                if (!fromDate && !toDate) {
                    return true;
                }

                var dateStr = data[2]; // Paid Date column
                if (!dateStr) return true;

                var rowDate;

                if (dateStr.includes('-')) {
                    var parts = dateStr.split('-');

                    if (parts[0].length === 4) {
                        // yyyy-MM-dd
                        rowDate = new Date(parts[0], parts[1] - 1, parts[2]);
                    } else {
                        // dd-MM-yyyy
                        rowDate = new Date(parts[2], parts[1] - 1, parts[0]);
                    }
                } else if (dateStr.includes('/')) {
                    // dd/MM/yyyy or MM/dd/yyyy → try safe parse
                    rowDate = new Date(dateStr);
                } else {
                    return true;
                }

                var fromDateObj = fromDate ? new Date(fromDate) : null;
                var toDateObj = toDate ? new Date(toDate) : null;

                if (fromDateObj && rowDate < fromDateObj) return false;
                if (toDateObj) {
                    var toDatePlusOne = new Date(toDateObj);
                    toDatePlusOne.setDate(toDatePlusOne.getDate() + 1);
                    if (rowDate >= toDatePlusOne) return false;
                }
                return true;
            }
        );


        // Initialize DataTable
        table = $('#incomeExpenseTable').DataTable({
            dom: "<'row'<'col-md-6'B><'col-md-6'f>>" +
                "<'row'<'col-12'tr>>" +
                "<'row'<'col-md-5'i><'col-md-7'p>>",
            ordering: false,
            language: {
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of 0 entries",
                infoFiltered: "" // This removes the filtered count text
            },
            buttons: [
                {
                    extend: 'csvHtml5',
                    text: '<img src="/Content/img/icons8-csv-64.png" alt="CSV" style="height:32px;" title="Export CSV" />',
                    className: 'export-buttons icon-only-btn',
                    filename: 'Green Valley Society-Income-Expense Report ' + moment().format("DD-MM-YYYY"),
                    exportOptions: {
                        columns: ':visible:not(:first-child)' // Skip checkbox column
                    },
                    customize: function (csv) {
                        const headerTitle = 'Green Valley Society-Income-Expense Report';
                        const downloadedOn = 'Generated on: ' + moment().format('DD-MM-YYYY hh:mm A');

                        const csvRows = csv.split('\n');

                        // 🔹 Step 1: Replace first column name with "Sr No"
                        const originalHeader = csvRows[0].split(',');
                        originalHeader[0] = '"Sr No"';
                        csvRows[0] = originalHeader.join(',');

                        // 🔹 Step 2: Loop through each row and format columns
                        for (let i = 1; i < csvRows.length; i++) {
                            if (csvRows[i].trim() !== '') {
                                const rowCols = csvRows[i].split(',');
                                rowCols[0] = `"${i}"`; // Sr No

                                // Add ₹ symbol to column 6 if exists
                                if (rowCols[6]) {
                                    let cleanData = rowCols[6].replace(/"/g, '').replace(/[₹,]/g, '').trim();
                                    rowCols[6] = `"₹${cleanData}"`;
                                }
                                // Existing cleaning for amount column 7
                                if (rowCols[7]) {
                                    let cleanAmount = rowCols[7].replace(/"/g, '').replace(/[^0-9.,]/g, '');
                                    rowCols[7] = `"${cleanAmount}"`;
                                }
                                csvRows[i] = rowCols.join(',');
                            }
                        }

                        // 🔹 Step 3: Add title and timestamp (centered using empty columns)
                        const emptyCols = originalHeader.length - 1;
                        const centerPad = Math.floor(emptyCols / 2);
                        const padString = Array(centerPad).fill('').join(',');

                        const centeredTitle = padString + `"${headerTitle}"`;
                        const centeredTimestamp = padString + `"${downloadedOn}"`;

                        csvRows.unshift(centeredTimestamp);
                        csvRows.unshift(centeredTitle);

                        return csvRows.join('\n');
                    },
                    action: function (e, dt, button, config) {
                        const selectedRows = dt.rows({ filter: 'applied' }).nodes().to$().filter(function () {
                            return $(this).find('input.row-checkbox:checked').length > 0;
                        });

                        const isHeaderOnlyChecked = $('thead input.row-checkbox:checked').length > 0 && selectedRows.length === 0;
                        if (isHeaderOnlyChecked || selectedRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export CSV.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        const validRows = selectedRows.filter(function () {
                            const purpose = $(this).find('td:nth-child(5)').text().trim();
                            return purpose !== '';
                        });

                        if (validRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one valid row to export CSV.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        config.exportOptions.rows = function (idx, data, node) {
                            return $(node).find('input.row-checkbox').is(':checked');
                        };

                        $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);

                        // Clear checkboxes after export
                        setTimeout(() => {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-all-income').prop('checked', false);
                        }, 100);

                        setTimeout(function () {
                            swal({
                                icon: 'success',
                                title: 'CSV Exported',
                                text: 'Your CSV file has been downloaded successfully!',
                                timer: 2000,
                                buttons: false
                            });
                        }, 500);
                    }
                },

                {
                    extend: 'excelHtml5',
                    text: '<img src="/Content/img/icons8-xls-64.png" style="height:32px;" title="Export Excel" />',
                    className: 'export-buttons icon-only-btn',
                    title: null,
                    filename: 'Green Valley Society-Income-Expense Report' + moment().format("DD-MM-YYYY"),
                    exportOptions: {
                        rows: function (idx, data, node) {
                            if ($('#select-all-income').is(':checked')) {
                                return true;
                            }
                            return $(node).find('.row-checkbox').is(':checked');
                        },
                        columns: [1, 2, 3, 4, 5, 6, 7] // Added column 7 (amount)
                    },
                    customize: function (xlsx) {
                        const sheet = xlsx.xl.worksheets['sheet1.xml'];
                        const styles = xlsx.xl['styles.xml'];
                        const $ = window.jQuery;

                        const title = 'Green Valley Society- Income-Expense Report';
                        const timestamp = 'Generated on: ' + moment().format('DD-MM-YYYY hh:mm A');

                        const sheetData = $('sheetData', sheet);
                        const rows = sheetData.find('row');

                        // Shift existing rows down by 2
                        rows.each(function () {
                            const r = parseInt($(this).attr('r')) + 2;
                            $(this).attr('r', r);
                            $(this).find('c').each(function () {
                                const cellRef = $(this).attr('r');
                                const col = cellRef.replace(/[0-9]/g, '');
                                $(this).attr('r', col + r);
                            });
                        });

                        // Insert custom header rows
                        const titleRow = `
<row r="1">
    <c t="inlineStr" r="D1" s="2">
        <is><t>${title}</t></is>
    </c>
</row>`;
                        const dateRow = `
<row r="2">
    <c t="inlineStr" r="D2" s="2">
        <is><t>${timestamp}</t></is>
    </c>
</row>`;

                        sheetData.prepend(dateRow);
                        sheetData.prepend(titleRow);

                        // Add center style in styles.xml
                        const cellXfs = $('cellXfs', styles);
                        const centerStyleIndex = cellXfs.children().length;
                        cellXfs.append(`
<xf xfId="0" applyAlignment="1">
    <alignment horizontal="center" vertical="center"/>
</xf>`);

                        // Apply center style to all cells
                        $('sheetData row c', sheet).attr('s', centerStyleIndex);

                        // Fix Sr.No column (A) - Add sequential numbering
                        let srNo = 1;
                        $('row', sheet).each(function () {
                            const rowIndex = parseInt($(this).attr('r'));
                            if (rowIndex >= 4) {
                                const firstCell = $('c[r^="A"]', this);
                                if (firstCell.length) {
                                    firstCell.attr('t', 'n');
                                    // Check if there's already a value element
                                    if (firstCell.find('v').length) {
                                        firstCell.find('v').text(srNo++);
                                    } else {
                                        firstCell.append('<v>' + srNo++ + '</v>');
                                    }
                                }

                                // Handle amount column (column H/8) - convert to numeric format
                                const amountCell = $('c[r^="H"]', this);
                                if (amountCell.length) {
                                    const amountText = amountCell.find('t').text();
                                    const cleanAmount = amountText.replace(/[₹,]/g, '');
                                    amountCell.attr('t', 'n');

                                    if (amountCell.find('v').length) {
                                        amountCell.find('v').text(cleanAmount);
                                    } else {
                                        amountCell.append('<v>' + cleanAmount + '</v>');
                                    }
                                }
                            }
                        });
                    },
                    action: function (e, dt, button, config) {
                        const selected = dt.rows().nodes().to$().find('.row-checkbox:checked');

                        // ✅ Condition 1: No checkbox selected
                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export Excel.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // ✅ Condition 2: Header selected but no data rows
                        const dataRows = dt.rows({ search: 'applied' }).nodes().to$().filter(function () {
                            return $(this).find('.row-checkbox').length > 0;
                        });

                        if (dataRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export Excel.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // ✅ All good – allow export
                        $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);

                        // Clear checkboxes after export
                        setTimeout(() => {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-all-income').prop('checked', false);
                        }, 100);

                        swal({
                            icon: 'success',
                            title: 'Excel Exported',
                            text: 'Your Excel file has been downloaded successfully!',
                            timer: 2000,
                            buttons: false
                        });
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<img src="/Content/img/icons8-pdf-64.png" alt="PDF" style="height:32px;" title="Export PDF" />',
                    className: 'export-buttons icon-only-btn',
                    orientation: 'landscape',
                    filename: 'Green Valley Society-Income-Expense Report ' + moment().format("DD-MM-YYYY"),
                    pageSize: 'A4',
                    title: '',
                    messageTop: '',
                    exportOptions: {
                        rows: function (idx, data, node) {
                            return $('input.row-checkbox', node).is(':checked');
                        },
                        columns: ':visible:not(:first-child)',
                        format: {
                            body: function (data, row, col, node) {
                                if (col === 7) { // Amount column
                                    return data.replace(/[₹,]/g, '');
                                }
                                return data;
                            }
                        }
                    },
                    customize: function (doc) {
                        const now = moment().format("DD-MM-YYYY hh:mm A");

                        // Header text
                        doc.content.unshift({
                            alignment: 'center',
                            margin: [0, 0, 0, 12],
                            text: [
                                { text: 'Green Valley Society - Income-Expense Report\n', fontSize: 18, bold: true },
                                { text: 'Generated on: ' + now + '\n\n', fontSize: 12, italics: true }
                            ]
                        });

                        const tableContent = doc.content.find(obj => obj.table);

                        if (tableContent) {
                            const colCount = tableContent.table.body[0].length;

                            // Renumber the first column (Sr.no) sequentially starting from 1
                            for (let i = 1; i < tableContent.table.body.length; i++) {
                                if (tableContent.table.body[i].length > 0) {
                                    tableContent.table.body[i][0] = {
                                        text: i.toString(),
                                        alignment: 'center'
                                    };
                                }
                            }

                            // 🔄 Flexible column widths
                            tableContent.table.widths = Array(colCount).fill('*');

                            // 🔄 Center all cell content
                            tableContent.table.body.forEach((row, rowIndex) => {
                                row.forEach((cell, colIndex) => {
                                    if (typeof cell === 'object') {
                                        cell.alignment = 'center';
                                    } else {
                                        row[colIndex] = { text: cell, alignment: 'center' };
                                    }
                                });
                            });

                            // 🎯 Table layout
                            tableContent.layout = {
                                hLineWidth: () => 0.5,
                                vLineWidth: () => 0.5,
                                hLineColor: () => '#aaa',
                                vLineColor: () => '#aaa',
                                paddingLeft: () => 5,
                                paddingRight: () => 5,
                                paddingTop: (rowIndex) => rowIndex === 0 ? 8 : 4,
                                paddingBottom: (rowIndex) => rowIndex === 0 ? 8 : 4
                            };

                            // ✅ Wrap in centered container to center the table on the page
                            const wrapper = {
                                alignment: 'center',
                                table: tableContent.table,
                                layout: tableContent.layout
                            };

                            const index = doc.content.indexOf(tableContent);
                            if (index !== -1) {
                                doc.content[index] = wrapper;
                            }
                        }

                        // 🖋 Default styles
                        doc.defaultStyle.fontSize = 8;
                        doc.styles.tableHeader.fontSize = 9;
                        doc.styles.tableHeader.bold = true;
                        doc.styles.tableHeader.alignment = 'center';
                        doc.styles.tableHeader.fillColor = '#615677';
                        doc.styles.tableHeader.color = '#ffffff';
                    },
                    action: function (e, dt, button, config) {
                        const selected = dt.rows().nodes().to$().find('.row-checkbox:checked');

                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export PDF.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        const dataRows = dt.rows({ search: 'applied' }).nodes().to$().filter(function () {
                            return $(this).find('.row-checkbox').length > 0;
                        });

                        if (dataRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export PDF.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);

                        // Clear checkboxes after export
                        setTimeout(() => {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-all-income').prop('checked', false);
                        }, 100);

                        swal({
                            icon: 'success',
                            title: 'PDF Exported',
                            text: 'Your PDF file has been downloaded successfully!',
                            timer: 2000,
                            buttons: false
                        });
                    }
                },

                {
                    extend: 'print',
                    text: '<img src="/Content/img/icons8-print-100.png" alt="Print" style="height:32px;" title="Print" />',
                    className: 'export-buttons icon-only-btn',
                    title: '', // Remove title here as we'll add it manually
                    messageTop: null, // Remove messageTop as we'll add it manually
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7], // Include all columns including amount
                        modifier: {
                            search: 'applied',
                            order: 'applied',
                            page: 'all'
                        },
                        rows: function (idx, data, node) {
                            // Check if "Select All" is checked
                            if ($('#select-all-income').is(':checked')) {
                                return true;
                            }
                            // Otherwise check individual row checkboxes
                            return $(node).find('.row-checkbox').is(':checked');
                        },
                        format: {
                            body: function (data, row, col, node) {
                                // Clean up data for printing - handle amount column (index 7)
                                if (col === 7) { // Amount column
                                    return data.replace(/[₹,]/g, '');
                                }
                                return data;
                            }
                        }
                    },
                    customize: function (win) {
                        // Remove DataTable's automatically added header
                        $(win.document.body).find('h1').remove();

                        // Store the original table HTML
                        var $table = $(win.document.body).find('table');

                        // Create custom header
                        var header = `
            <div style="text-align: center; margin-bottom: 20px;">
                <h2>Green Valley Society - Income-Expense Report</h2>
                <p>Generated on: ${moment().format('DD-MM-YYYY hh:mm A')}</p>
            </div>
        `;

                        // Add custom header before the table
                        $table.before(header);

                        // Renumber the rows sequentially starting from 1
                        $table.find('tbody tr').each(function (index) {
                            $(this).find('td:first').text(index + 1);
                        });

                        // Apply styling
                        $table.addClass('compact')
                            .css('font-size', '10pt')
                            .css('width', '100%');

                        // Add print-specific styles
                        const style = document.createElement('style');
                        style.innerHTML = `
           @@page { margin: 0.5in; }
            body { font-family: Arial, sans-serif; }
            table { width: 100% !important; border-collapse: collapse; margin-top: 20px; }
            th, td { padding: 6px !important; border: 1px solid #ddd; text-align: center; }
            th { background-color: #f8f9fa; font-weight: bold; }
            .text-success { color: #28a745 !important; }
            .text-danger { color: #dc3545 !important; }
            .font-weight-bold { font-weight: bold !important; }
        `;
                        win.document.head.appendChild(style);
                    },
                    action: function (e, dt, button, config) {
                        // Check if "Select All" is checked
                        if ($('#select-all-income').is(':checked')) {
                            // Proceed with print
                            $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);

                            // Clear checkboxes after print
                            setTimeout(() => {
                                dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                                $('#select-all-income').prop('checked', false);
                            }, 100);
                            return;
                        }

                        // Check if any individual rows are selected
                        var selectedRows = dt.rows().nodes().to$().filter(function () {
                            return $(this).find('.row-checkbox').is(':checked');
                        });

                        if (selectedRows.length === 0) {
                            iziToast.warning({
                                title: 'No Rows Selected',
                                message: 'Please select at least one row to print.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // Proceed with print
                        $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);

                        // Clear checkboxes after print
                        setTimeout(() => {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-all-income').prop('checked', false);
                        }, 100);
                    }
                },
                {
                    text: '<img id="refreshIcon" src="/Content/img/icons8-refresh-50.png" alt="Refresh" style="height:28px;" title="Refresh Table" />',
                    className: 'export-buttons icon-only-btn',
                    action: function (e, dt, node, config) {
                        // Remove the class first to reset the animation
                        $('#refreshIcon').removeClass('rotate-refresh');

                        // Use a small timeout to ensure the class removal is rendered
                        setTimeout(function () {
                            // Add the class to start the animation
                            $('#refreshIcon').addClass('rotate-refresh');

                            // Clear checkboxes
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-all-income').prop('checked', false);

                            // Perform the refresh operations
                            $('.daterange-btn').data('daterangepicker').setStartDate(moment());
                            $('.daterange-btn').data('daterangepicker').setEndDate(moment());
                            $('.daterange-btn').html('<i class="fas fa-calendar"></i> <span>Choose Date</span>');
                            $('#fromDate').val('');
                            $('#toDate').val('');
                            $('#typeFilter').val('').trigger('change');
                            dt.search('').columns().search('');
                            dt.draw(false);
                            calculateTotals();

                            // Keep the animation running for a bit longer
                            setTimeout(function () {
                                $('#refreshIcon').removeClass('rotate-refresh');
                            }, 800); // Match this with the animation duration

                        }, 10);
                    }
                }
            ],


            order: [[1, 'asc']],
            pageLength: 10,
            responsive: false,
            scrollX: false,
            createdRow: function (row, data, dataIndex) {
                $('td:eq(1)', row).html(dataIndex + 1);
            },
            drawCallback: function (settings) {
                var api = this.api();

                api.column(1, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                    cell.innerHTML = i + 1;
                });

                var total = 0;
                api.column(7, { search: 'applied' }).data().each(function (value, index) {
                    var cleanValue = parseFloat(value.toString().replace(/[₹,]/g, '')) || 0;
                    total += cleanValue;
                });

                // Update the total display in the filter div instead of table footer
                $('#totalAmountDisplay').text('₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            }
        });
        // Enhanced checkbox handling
        // Enhanced checkbox handling
        $('#select-all-income').on('click', function () {
            var isChecked = this.checked;
            table.$('.row-checkbox').prop('checked', isChecked);
            table.rows().nodes().to$().toggleClass('selected', isChecked);

            // Also update all rows (not just visible ones) if needed
            if (isChecked) {
                table.rows({ search: 'applied' }).nodes().to$().find('.row-checkbox').prop('checked', true);
            }
        });

        $('#incomeExpenseTable tbody').on('change', '.row-checkbox', function () {
            var tr = $(this).closest('tr');
            var isChecked = this.checked;
            tr.toggleClass('selected', isChecked);

            var allChecked = table.$('.row-checkbox').length === table.$('.row-checkbox:checked').length;
            $('#select-all-income').prop('checked', allChecked);
        });

        table.on('draw', function () {
            table.$('tr').each(function () {
                var $row = $(this);
                $row.find('.row-checkbox').prop('checked', $row.hasClass('selected'));
            });

            var allChecked = table.$('.row-checkbox').length === table.$('.row-checkbox:checked').length;
            $('#select-all-income').prop('checked', allChecked);
        });

        // Initialize checkboxes
        table.$('tr').each(function () {
            var $row = $(this);
            if ($row.hasClass('selected')) {
                $row.find('.row-checkbox').prop('checked', true);
            }
        });

        // Type filter logic
        $('#typeFilter').on('change', function () {
            const filterValue = $(this).val();
            table.column(3).search(filterValue).draw();
        });
    });
</script>