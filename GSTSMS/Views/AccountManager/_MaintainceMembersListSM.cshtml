@model System.Data.DataTable

<div class="table-responsive" style="color:black;">

    <div class="d-flex justify-content-between align-items-center mb-2">

        <!-- ✅ Date Range Button -->
        <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon">
            <i class="fas fa-calendar"></i> <span>Choose Date</span>
        </a>

        <!-- ✅ Payment Mode Filter Dropdown (ONLY FOR PAID LIST) -->
        <div id="paymentModeWrapper" style="display:none;">
            <select id="paymentModeFilter" class="form-control form-control-sm ms-2" style="width:180px;">
                <option value="">All Payment Modes</option>
                <option value="UPI">UPI</option>
                <option value="Cash">Cash</option>
                <option value="Cheque">Cheque</option>
            </select>
        </div>


        <!-- ✅ Hidden Fields -->
        <input type="hidden" id="fromDate" />
        <input type="hidden" id="toDate" />
        <input type="hidden" id="memberStatus" />


    </div>



    <table id="dueDataTable"
           class="table table-sm table-bordered table-striped text-center dataTableExport mb-0"
           style="width:100%; table-layout:auto;">

        <thead class="bg-light">
            <tr style="background-color: #615677; color: #fff;">
                <th>
                    <div class="d-flex justify-content-center align-items-center" style="height:100%;">
                        <input type="checkbox" id="selectAllMaintenance" />
                    </div>
                </th>
                <th>Sr.No</th>

                @foreach (System.Data.DataColumn col in Model.Columns)
                {
                    <th>@col.ColumnName</th>
                }
            </tr>
        </thead>

        <tbody>
            @{
                int rowIndex = 1;
            }

            @foreach (System.Data.DataRow row in Model.Rows)
            {
                <tr data-id="@rowIndex">
                    <td><input type="checkbox" class="row-checkbox" /></td>
                    <td></td>

                    @foreach (System.Data.DataColumn col in Model.Columns)
                    {
                        <td>
                            @if (row[col.ColumnName] != DBNull.Value)
                            {
                                if (
                                    col.ColumnName.ToLower().Contains("amount") ||
                                    col.ColumnName.ToLower().Contains("penalty") ||
                                    col.ColumnName.ToLower().Contains("pending")
                                )
                                {
                                    @("₹ " + Convert.ToDecimal(row[col.ColumnName]).ToString("N2"))
                                }
                                else
                                {
                                    @row[col.ColumnName].ToString()
                                }
                            }
                            else
                            {
                                @Html.Raw("-")
                            }
                        </td>
                    }
                </tr>

                rowIndex++;
            }
        </tbody>

        <tfoot>
            <tr>
                <th></th>   <!-- checkbox -->
                <th></th>   <!-- Sr.No -->

                @foreach (System.Data.DataColumn col in Model.Columns)
                {
                    <th></th>
                }
            </tr>
        </tfoot>

    </table>
</div>


