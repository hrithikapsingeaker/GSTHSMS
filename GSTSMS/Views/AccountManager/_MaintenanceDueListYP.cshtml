@model System.Data.DataTable

<div class="section-body">
    <div class="card">
        @*<div class="card-header bg-light">
                <h4 class="text-dark">Maintenance Due List</h4>
            </div>*@
        <div class="d-flex justify-content-between mb-2">
            <a href="javascript:;" class="btn btn-primary daterange-btn-due">
                <i class="fas fa-calendar"></i> <span>Choose Date</span>
            </a>

            <input type="hidden" id="startDue" />
            <input type="hidden" id="endDue" />
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="dueDataTable" class="table table-hover table-striped table-bordered text-dark" style="width:100%; table-layout:auto;">
                    <thead class="bg-light text-dark text-center">
                        <tr style="color: white !important; background-color: #615677 !important; ">
                            <th>
                                <input type="checkbox" id="select-all" class="row-checkbox" />
                            </th>
                            <th style="color:white;">Sr.No</th>
                            <th style="color:white;">Flat</th>
                            <th style="color:white;">Member Name</th>
                            @*<th style="color:white;"> Email</th>*@
                            <th style="color:white;">Maintenance Type</th>
                            <th style="color:white;">Amount(₹)</th>
                            <th style="color:white;">Due Date</th>
                            @*<th style="color:white;">Pending Amount(₹)</th>*@
                            @*<th style="color:white;"> Penalty Percent(%)</th>*@
                            <th style="color:white;"> Penalty Amount(₹)</th>
                            <th style="color:white;"> Final Payable(₹)</th>
                            @*<th style="color:white;">Last Paid Date</th>*@
                        </tr>
                    </thead>
                    <tbody class="small">
                        @{
                            int i = 1;
                            foreach (System.Data.DataRow row in Model.Rows)
                            {
                                string memberCode = row["MemberCode"].ToString(); // ✅ Ensure unique ID for each row

                                <tr data-membercode="@memberCode">
                                    <td>
                                        <!-- ✅ Use MemberCode as unique ID for checkbox -->
                                        <input type="checkbox"
                                               class="row-checkbox"
                                               data-membercode="@memberCode"
                                               id="chk_@memberCode" />
                                    </td>
                                    <td>@i</td>
                                    <td style="text-align:center;">@row["FlatCode"]</td>
                                    <td style="text-align:center;">@row["FullName"]</td>
                                    <td style="text-align:center;">@row["MaintenanceType"]</td>
                                    <td style="text-align:center;">₹@row["MaintenanceAmount"]</td>
                                    <td style="text-align:center;">@row["DueDateFormatted"]</td>
                                    @*<td style="text-align:center;">₹@row["PendingAmount"]</td>*@
                                    @*<td style="text-align:center;">@row["PenaltyPercent"]%</td>*@
                                    <td style="text-align:center;">₹@row["PenaltyAmount"]</td>
                                    <td style="text-align:center;">₹@row["FinalPayable"]</td>
                                </tr>

                                i++;
                            }
                        }
                    </tbody>

                    @*<tfoot class="bg-light text-dark">
                            <tr>
                                <th colspan="8" class="text-right">Total Pending Amount:</th>
                                <th id="totalPending" class="text-right"></th>
                                <th></th>
                            </tr>
                        </tfoot>*@
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Match Complaints Modal UI */
    element.style {
        color: black;
    }


    #dueDataTable th, #dueDataTable td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        padding: 8px 12px;
    }

    #dueDataTable tbody tr:hover {
        background-color: #f1f3f5; /* Same hover as complaints modal */
    }
</style>

<script src="~/Content/modules/jquery.min.js"></script>
<!-- ✅ DataTables + Export + Select -->
<link href="~/Content/modules/datatables/datatables.min.css" rel="stylesheet" />
<link href="~/Content/modules/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
<link href="~/Content/css/AuditReport.css" rel="stylesheet" />
<link href="~/Content/modules/izitoast/css/iziToast.css" rel="stylesheet" />
<link href="~/Content/modules/izitoast/css/iziToast.min.css" rel="stylesheet" />
<link href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" rel="stylesheet" />

<!-- Page Specific JS File -->
<script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
<script src="~/Content/modules/datatables/datatables.min.js"></script>
<script src="~/Content/modules/izitoast/js/iziToast.js"></script>
<script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
<script src="~/Content/modules/moment.min.js"></script>
<script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>
<script>
    $(document).ready(function () {

        // Destroy existing table if initialized
        if ($.fn.DataTable.isDataTable('#dueDataTable')) {
            $('#dueDataTable').DataTable().destroy();
            $('#dueDataTable').closest('.dataTables_wrapper').remove();
        }
        // -------------------------
        // DATE RANGE FILTER (DUE DATE)
        // -------------------------
        const dateFormat = "DD-MM-YYYY";
        let enableDueFilter = false;

        // Custom filter for Due Date (Column index 6)
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

            if (!(settings.nTable && settings.nTable.id === 'dueDataTable'))
                return true;

            if (!enableDueFilter)
                return true;

            var dueDateStr = data[6];   // Due Date Column
            if (!dueDateStr) return false;

            var min = $('#startDue').val();
            var max = $('#endDue').val();

            var dueDate = moment(dueDateStr, dateFormat);
            if (!dueDate.isValid()) return false;

            if (min && dueDate.isBefore(moment(min, dateFormat), 'day')) return false;
            if (max && dueDate.isAfter(moment(max, dateFormat), 'day')) return false;

            return true;
        });

        // Initialize DateRangePicker for Due Table
        $('.daterange-btn-due').daterangepicker({
            locale: { format: dateFormat },
            autoUpdateInput: false,
            opens: "right",
            drops: "down",
            linkedCalendars: false,
            ranges: {
                'Today': [moment(), moment()],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [
                    moment().subtract(1, 'month').startOf('month'),
                    moment().subtract(1, 'month').endOf('month')
                ]
            }
        }, function (start, end) {

            enableDueFilter = true;

            $('#startDue').val(start.format(dateFormat));
            $('#endDue').val(end.format(dateFormat));

            $('.daterange-btn-due span')
                .html(start.format(dateFormat) + " - " + end.format(dateFormat));

            $('#dueDataTable').DataTable().draw();
        });

        // Default button text
        $('.daterange-btn-due span').html("Choose Date");

        var selectedRows = {}; // Track selected row IDs

        var table = $('#dueDataTable').DataTable({
            dom: "<'row'<'col-md-6'B><'col-md-6'f>>" +
                "<'row'<'col-12'tr>>" +
                "<'row'<'col-md-5'i><'col-md-7'p>>",
            processing: true,              // loader feel
            paging: true,                  // 🔹 turn on pagination
            pageLength: 10,                // 🔹 10 rows per page
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]], // 🔹 dropdown
            pagingType: "simple_numbers",  // 🔹 1 2 3 … style
            ordering: false,
            columnDefs: [
                { orderable: false, targets: 0 },
                { className: "dt-center", targets: "_all" }
            ],
            language: {
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoFiltered: "",
                infoEmpty: "No entries to show",
                lengthMenu: "Show _MENU_ entries",   // 🔹 text for dropdown
                paginate: {                          // 🔹 pagination button text
                    previous: "Prev",
                    next: "Next"
                }
            },
            footerCallback: function (row, data, start, end, display) {
                var api = this.api();
                var total = api.column(8, { search: 'applied' }).data().reduce((a, b) => {
                    var x = parseFloat(String(a).replace(/[₹,]/g, '')) || 0;
                    var y = parseFloat(String(b).replace(/[₹,]/g, '')) || 0;
                    return x + y;
                }, 0);
                if (api.column(8).footer()) {
                    $(api.column(8).footer()).html('₹' + total.toLocaleString());
                }
            },
            drawCallback: function () {
                var api = this.api();
                var startIndex = api.page.info().start;

                api.column(1, { page: 'current' }).nodes().each(function (cell, i) {
                    cell.innerHTML = startIndex + i + 1;
                });

                api.rows({ page: 'current' }).nodes().each(function (row) {
                    var $row = $(row);
                    var memberCode = $row.data('membercode');
                    $row.find('.row-checkbox').prop('checked', !!selectedRows[memberCode]);
                });

                var totalVisible = api.rows({ page: 'current' }).nodes().to$().find('.row-checkbox').length;
                var checkedVisible = api.rows({ page: 'current' }).nodes().to$().find('.row-checkbox:checked').length;
                $('#select-all').prop('checked', totalVisible > 0 && totalVisible === checkedVisible);
            },




            buttons: [
                {
                    extend: 'csvHtml5',
                    text: '<img src="/Content/img/icons8-csv-64.png" style="height:32px;" title="Export CSV" />',
                    className: 'export-buttons icon-only-btn',
                    filename: 'MaintenanceDue_' + moment().format("DD-MM-YYYY"),
                    bom: true,
                    exportOptions: {
                        columns: ':visible:not(:first-child)', // Exclude checkbox column
                        rows: function (idx, data, node) {
                            return $(node).find('input.row-checkbox').is(':checked'); // Only selected rows
                        }
                    },
                    customize: function (csv) {
                        // 🔹 Sr.No reset logic
                        let csvRows = csv.split('\n');

                        // Step 1: Replace first column header with "Sr No"
                        if (csvRows.length > 0) {
                            const originalHeader = csvRows[0].split(',');
                            originalHeader[0] = '"Sr No"';
                            csvRows[0] = originalHeader.join(',');
                        }

                        // Step 2: Reset Sr.No starting from 1
                        let srNo = 1;
                        for (let i = 1; i < csvRows.length; i++) {
                            if (csvRows[i].trim() !== '') {
                                const rowCols = csvRows[i].split(',');
                                rowCols[0] = `"${srNo++}"`;
                                csvRows[i] = rowCols.join(',');
                            }
                        }

                        const societyName = 'Green Valley Society - Maintenance Due List';
                        const generatedOn = 'Generated on: ' + moment().format("DD-MM-YYYY hh:mm A");

                        // Top lines मध्ये Society Name + Date add करून final CSV return
                        return `"${societyName}"\n"${generatedOn}"\n\n` + csvRows.join('\n');
                    },
                    action: function (e, dt, button, config) {
                        // 🔹 Check at least one row selected
                        var selected = dt.rows().nodes().to$().find('input.row-checkbox:checked');
                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export CSV.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // Default CSV Export call
                        $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);

                        // Success popup
                        setTimeout(() => {
                            swal({
                                icon: 'success',
                                title: 'CSV Exported',
                                text: 'Your Maintenance Due List CSV file has been downloaded successfully!',
                                timer: 2000,
                                buttons: false
                            });
                        }, 500);
                        clearAllSelectionsAfterExport(dt);
                    }
                },



                // Excel Export
                {
                    extend: 'excelHtml5',
                    text: '<img src="/Content/img/icons8-xls-64.png" style="height:32px;" title="Export Excel" />',
                    className: 'export-buttons icon-only-btn',
                    title: null,
                    filename: 'MaintenanceDue_' + moment().format("DD-MM-YYYY"),
                    exportOptions: {
                        rows: function (idx, data, node) {
                            return $('input.row-checkbox', node).is(':checked');
                        },
                        columns: [1, 2, 3, 4, 5, 6, 7] // ✅ exclude checkbox
                    },
                    customize: function (xlsx) {
                        const sheet = xlsx.xl.worksheets['sheet1.xml'];
                        const styles = xlsx.xl['styles.xml'];
                        const $ = window.jQuery;

                        const title = 'Green Valley Society - Maintenance Due List';
                        const timestamp = 'Generated on: ' + moment().format('DD-MM-YYYY hh:mm A');

                        const sheetData = $('sheetData', sheet);
                        const rows = sheetData.find('row');

                        // 🔹 Shift existing rows down by 2
                        rows.each(function () {
                            const r = parseInt($(this).attr('r')) + 2;
                            $(this).attr('r', r);
                            $(this).find('c').each(function () {
                                const cellRef = $(this).attr('r');
                                const col = cellRef.replace(/[0-9]/g, '');
                                $(this).attr('r', col + r);
                            });
                        });

                        // 🔹 Insert custom header rows
                        const titleRow = `
<row r="1">
    <c t="inlineStr" r="C1" s="2">
        <is><t>${title}</t></is>
    </c>
</row>`;
                        const dateRow = `
<row r="2">
    <c t="inlineStr" r="C2" s="2">
        <is><t>${timestamp}</t></is>
    </c>
</row>`;

                        sheetData.prepend(dateRow);
                        sheetData.prepend(titleRow);

                        // 🔹 Add center style in styles.xml
                        const cellXfs = $('cellXfs', styles);
                        const centerStyleIndex = cellXfs.children().length;
                        cellXfs.append(`
<xf xfId="0" applyAlignment="1">
    <alignment horizontal="center" vertical="center"/>
</xf>`);

                        // Apply center style
                        $('sheetData row c', sheet).attr('s', centerStyleIndex);

                        // 🔹 Fix Sr.No column (A)
                        let srNo = 1;
                        $('row', sheet).each(function () {
                            const rowIndex = parseInt($(this).attr('r'));
                            if (rowIndex >= 4) { // data starts from row 4
                                const firstCell = $('c[r^="A"]', this);
                                if (firstCell.length) {
                                    firstCell.attr('t', 'n');
                                    firstCell.find('v').text(srNo++);
                                } else {
                                    $(this).prepend(`<c t="n" r="A${rowIndex}"><v>${srNo++}</v></c>`);
                                }
                            }
                        });
                    },
                    action: function (e, dt, button, config) {
                        const selected = dt.rows().nodes().to$().find('.row-checkbox:checked');

                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export Excel.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);

                        swal({
                            icon: 'success',
                            title: 'Excel Exported',
                            text: 'Your Excel file has been downloaded successfully!',
                            timer: 2000,
                            buttons: false
                        });
                        clearAllSelectionsAfterExport(dt);
                    }
                },


                {
                    extend: 'pdfHtml5',
                    text: '<img src="/Content/img/icons8-pdf-64.png" alt="PDF" style="height:32px;" title="Export PDF" />',
                    className: 'export-buttons icon-only-btn',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    filename: 'Maintenance List ' + moment().format("DD-MM-YYYY"),
                    exportOptions: {
                        rows: function (idx, data, node) {
                            return $('input.row-checkbox', node).is(':checked');
                        },
                        columns: ':visible:not(:first-child)',
                        format: {
                            body: function (data, row, col, node) {
                                if (col === 0) return (row + 1).toString(); // Sr.No

                                let text = $(node).attr('data-export') || $(node).text().trim();

                                // 🔴 Optional: Limit description length
                                if (col === 5 && text.length > 50) {
                                    text = text.substring(0, 50) + '...';
                                }

                                return text;
                            }
                        }
                    },
                    customize: function (doc) {
                        const now = moment().format("DD-MM-YYYY hh:mm A");

                        // 🔴 Remove any "Dashboard" text object from doc.content
                        doc.content = doc.content.filter(item => {
                            if (typeof item.text === 'string' && item.text.includes('Dashboard')) {
                                return false; // remove this object
                            }
                            if (Array.isArray(item.text) && item.text.some(t => t.text && t.text.includes('Dashboard'))) {
                                return false; // remove if array contains "Dashboard"
                            }
                            return true;
                        });

                        // ✅ Continue with table formatting
                        const tableIndex = doc.content.findIndex(obj => obj.table);
                        if (tableIndex !== -1) {
                            const tableBody = doc.content[tableIndex].table.body;
                            const colCount = tableBody[0].length;
                            const widths = Array(colCount).fill('auto');

                            doc.content[tableIndex] = {
                                margin: [20, 0, 20, 0],
                                table: {
                                    widths: widths,
                                    body: tableBody
                                },
                                layout: {
                                    hLineWidth: () => 0.5,
                                    vLineWidth: () => 0.5,
                                    hLineColor: () => '#aaa',
                                    vLineColor: () => '#aaa',
                                    paddingLeft: () => 4,
                                    paddingRight: () => 4,
                                    paddingTop: () => 2,
                                    paddingBottom: () => 2
                                },
                                alignment: 'center'
                            };

                            doc.defaultStyle = { alignment: 'center', fontSize: 10 };
                            doc.pageMargins = [20, 40, 20, 40];
                            doc.styles.tableHeader = { fontSize: 11, bold: true, alignment: 'center', fillColor: '#615677', color: '#ffffff' };
                        }

                        // ✅ Title + Generated Date at top
                        doc.content.unshift({
                            alignment: 'center',
                            margin: [0, 0, 0, 12],
                            text: [
                                { text: 'Green Valley Society - Maintenance List\n', fontSize: 18, bold: true },
                                { text: 'Generated on: ' + now + '\n\n', fontSize: 11, italics: true }
                            ]
                        });
                    },
                    action: function (e, dt, button, config) {
                        var selected = dt.rows().nodes().to$().find('input.row-checkbox:checked');
                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export PDF.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);

                        setTimeout(() => {
                            swal({
                                icon: 'success',
                                title: 'PDF Exported',
                                text: 'Your PDF file has been downloaded successfully!',
                                timer: 2000,
                                buttons: false
                            });
                        }, 500);
                        clearAllSelectionsAfterExport(dt);
                    }
                },



                // Print
                // ✅ Print with dynamic Sr.No for selected rows
                {
                    extend: 'print',
                    title: '',
                    text: '<img src="/Content/img/icons8-print-100.png" style="height:32px;" title="Print Maintenance Due List" />',
                    className: 'export-buttons icon-only-btn',
                    exportOptions: {
                        columns: ':visible:not(:first-child)', // exclude checkbox
                        rows: function (idx, data, node) {
                            return $(node).find('input.row-checkbox').is(':checked');
                        },
                        format: {
                            body: function (data, row, column, node) {
                                if (!this.exportCounter) this.exportCounter = 0;

                                if (column === 0) { // Sr.No column after checkbox
                                    this.exportCounter++;
                                    return this.exportCounter;
                                }

                                if ([4, 7, 8, 9].includes(column)) { // currency columns
                                    var number = (data || "").toString().replace(/[^\d.\-]/g, '').trim();
                                    return number ? ('₹ ' + number) : '';
                                }

                                return (data && data.toString().trim() !== "") ? data.toString().trim() : $(node).text().trim();
                            }
                        }
                    },
                    customize: function (win) {
                        const societyName = 'Green Valley Society - Maintenance Due List';
                        const generatedOn = 'Generated on: ' + moment().format("DD-MM-YYYY hh:mm A");

                        $(win.document.body).prepend(`
            <h3 style="text-align:center;">${societyName}</h3>
            <p style="text-align:center;">${generatedOn}</p><br>
        `);

                        $(win.document.body).find('table').css({
                            'width': '100%',
                            'border-collapse': 'collapse'
                        }).find('th, td').css({
                            'border': '1px solid #aaa',
                            'padding': '4px',
                            'text-align': 'center'
                        });
                    },
                    action: function (e, dt, button, config) {
                        const selected = dt.rows().nodes().to$().find('input.row-checkbox:checked');
                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to print Maintenance Due List.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        $.fn.dataTable.ext.buttons.print.exportCounter = 0;
                        $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);
                    }
                },




                // Refresh
                {
                    text: '<img src="/Content/img/icons8-refresh-50.png" style="height:28px;" title="Refresh Table" />',
                    className: 'export-buttons icon-only-btn btn-spin',
                    action: function (e, dt, node, config) {

                        // 🔄 icon rotate
                        $(node).find('img').addClass('spin');
                        setTimeout(function () { $(node).find('img').removeClass('spin'); }, 500);

                        // 🔄 clear global + column search
                        dt.search('').columns().search('');

                        // 🔄 clear date filter values
                        enableDueFilter = false;                   // REMOVE FILTER FLAG
                        $('#startDue').val('');
                        $('#endDue').val('');

                        // 🔄 reset button text
                        $('.daterange-btn-due span').html('Choose Date');

                        // 🔄 hide datepicker if open
                        if ($('.daterangepicker').is(':visible')) {
                            $('.daterangepicker').hide();
                        }

                        // 🔄 uncheck all rows
                        dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                        $('#select-all').prop('checked', false);
                        selectedRows = {};

                        // 🔄 redraw & go to page 1
                        dt.page('first').draw(false);


                    }
                }

            ]
        });

        function clearAllSelectionsAfterExport(dt) {
            // ✅ 1. Clear all row checkboxes (on current page)
            dt.rows().every(function () {
                $(this.node()).find('.row-checkbox').prop('checked', false);
            });

            // ✅ 2. Uncheck "Select All"
            $('#select-all').prop('checked', false);
            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
            $('#select-all').prop('checked', false);
            selectedRows = {}; // Reset all selections
        }

        // ✅ Row checkbox change (track only current page selections)
        $('#dueDataTable').on('change', '.row-checkbox', function () {
            var $row = $(this).closest('tr');
            var memberCode = $row.data('membercode'); // Consistent attribute key

            if (this.checked) {
                selectedRows[memberCode] = true;
            } else {
                delete selectedRows[memberCode];
            }

            // ✅ Update Select All checkbox for only current page
            var pageRows = table.rows({ page: 'current' }).nodes();
            var allChecked = $(pageRows).find('.row-checkbox').length ===
                $(pageRows).find('.row-checkbox:checked').length;
            $('#select-all').prop('checked', allChecked);
        });

        // ✅ Select All checkbox (affects ALL pages)
        $('#select-all').on('change', function () {
            var isChecked = $(this).prop('checked');

            // Get all rows (not just current page)
            var allRows = table.rows().nodes();

            $(allRows).each(function () {
                var $row = $(this);
                var memberCode = $row.data('membercode');
                var checkbox = $row.find('.row-checkbox');
                checkbox.prop('checked', isChecked);

                if (isChecked) {
                    selectedRows[memberCode] = true;
                } else {
                    delete selectedRows[memberCode];
                }
            });
        });




    });
</script>

