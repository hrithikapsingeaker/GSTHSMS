        top: 5%;
        transform: translateY(-50%);
        border: none;
        background-color: orangered;
        color: white;
        font-size: 16px;
        cursor: pointer;
        padding: 5px 10px;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.3s ease;
        width: 25px;
    }*/

    .expense-label {
        min-width: 130px; /* सर्व labels एकाच रुंदीत */
        font-weight: 500;
    }

    .colon {
        display: inline-block;
        width: 30px; /* `:` साठी fix जागा */
        text-align: center;
    }
</style>
