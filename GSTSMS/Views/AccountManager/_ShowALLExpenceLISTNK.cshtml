@model IEnumerable<GSTSMSLibrary.AccountManager.AccountManager>


@*<link href="~/Content/css/AuditReport.css" rel="stylesheet" />*@
<!-- Modal Header -->
<div class="modal-header bg-light py-2">
    <h5 class="modal-title text-center w-100 text-dark">Expense Details List</h5>
    <button type="button" class="btn btn-danger btn-sm ifsc-close-btn" style="height:25px; width:25px;" onclick="closeModal()">
        <i class="fa fa-times"></i>
    </button>
</div>

<!-- Modal Body -->
<div class="modal-body  p-1 ps-2">


    <!-- Date Range Picker -->
    <div class="card-body py-2 px-0">
        <div class="d-flex align-items-center justify-content-between">


            <div>
                <a href="javascript:;" class="btn btn-primary daterange-btn icon-left btn-icon me-3">
                    <i class="fas fa-calendar"></i> <span>Choose Date</span>
                </a>
                <input type="hidden" id="fromDate1" />
                <input type="hidden" id="toDate1" />
            </div>


            <div class="d-flex align-items-center">
                <label for="statusFilter" class="fw-bold me-2 mb-0 text-dark font-weight-bold">
                    Payment Status :
                </label>
                <select id="statusFilter" class="form-control form-control-sm"
                        style="width: 160px; height: 35px; padding: 2px 8px; font-size: 14px;">
                    <option value="">All</option>
                    <option value="Paid">Paid</option>
                    <option value="Unpaid">Unpaid</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>

        </div>
    </div>



    <!-- Table Container -->
    <div id="expense-table-container">

        <table class="table table-sm table-bordered table-hover table-striped "
               id="expenceAllLIST" style="width:100%; table-layout:auto;">
            <thead>
                <tr class="text-center">
                    <th style="width: 30px; padding: 0;" class="p-0">
                        <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                            <input type="checkbox" id="select-expence-all" />
                        </div>
                    </th>
                    <th>Sr.No</th>
                    <th> Expense Type</th>
                    <th>Expense Name</th>
                    <th>Wing</th>
                    <th>Paid To</th>
                    <th>Ex.Added Date</th>
                    <th>Total Amount(₹)</th>
                    <th>Paid Amount(₹)</th>
                    <th>Remaining Amount(₹)</th>
                    <th>Status</th>
                    <th>Paid Date</th>
                    <th>CGST</th>
                    <th>SGST</th>
                    <th>GST Total(₹)</th>
                </tr>
            </thead>

            <tbody class="small">
                @{
                    int i = 1;
                    foreach (var item in Model)
                    {
                                <tr class="text-center">
                                    <td> <input type="checkbox" class="row-checkbox" /> </td>
                                    <td>@i</td>
                                    <td>@item.ExpenseTypeName</td>
                                    <td style="width:100px !important;" title="@item.ExpenseName">@item.ExpenseName</td>
                                    <td>@item.WingName</td>
                                    <td title="@item.PaidTo">@item.PaidTo</td>

                                    <td>@(item.ExpenseDate.HasValue ? item.ExpenseDate.Value.ToString("dd-MM-yyyy") : "")</td>

                                    <td>₹@item.TotalAmount.ToString("N2")</td>
                                    <td>₹@item.PaidAmount.ToString("N2")</td>
                                    <td>₹@item.RemainingAmount.ToString("N2")</td>
                                    <td>
                                        @if (item.PaymentStatus == "Paid")
                                        {
                                            <span class="text-success">Paid</span>
                                        }
                                        else if (item.PaymentStatus == "Pending")
                                        {
                                            <span class="text-primary">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Unpaid</span>
                                        }
                                    </td>

                                    <td>
                                        @(
        item.PaymentStatus == "Unpaid"
        ? "N/A"
        : (item.PaidDate.HasValue
            ? item.PaidDate.Value.ToString("dd-MM-yyyy")
            : "-")
    )
                                    </td>


                                    <td>@item.CGST</td>
                                    <td>@item.SGST</td>
                                    <td>₹@item.TotalGSTAmount.ToString("N2")</td>
                                </tr>
                        i++;
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td colspan="6" class="text-right font-weight-bold">Total:</td>
                    <td class="text-right font-weight-bold text-dark" id="total-amount">₹0.00</td>
                    <td class="text-right font-weight-bold text-dark" id="paid-total">₹0.00</td>
                    <td class="text-right font-weight-bold text-dark" id="remaining-total">₹0.00</td>
                    <td colspan="4"></td>
                    <td class="text-right font-weight-bold text-dark" id="gst-total">₹0.00</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>


<style>





    /*for rotet refresh icon*/
    .rotate-refresh {
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<!-- DataTables CSS -->
<link href="~/Content/modules/izitoast/css/iziToast.min.css" rel="stylesheet" />
<link href="~/Content/modules/datatables/datatables.min.css" rel="stylesheet" />
@*<link href="~/Content/modules/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css" rel="stylesheet" />*@
<link href="~/Content/modules/bootstrap-daterangepicker/daterangepicker.css" rel="stylesheet" />
@*<link href="~/Content/css/AuditReport.css" rel="stylesheet" />*@

<!-- DataTables JS -->
<script src="~/Content/modules/datatables/datatables.min.js"></script>

<script src="~/Content/modules/izitoast/js/iziToast.min.js"></script>
<script src="~/Content/modules/sweetalert/sweetalert.min.js"></script>
<script src="~/Content/modules/moment.min.js"></script>
<script src="~/Content/modules/bootstrap-daterangepicker/daterangepicker.js"></script>


<script>
    function closeModal() {
        $('#expenceAllListModal').modal('hide');
    }

    $(document).ready(function () {
        let selectedRows = new Set();
        const format = 'DD-MM-YYYY';
        let enableDateFilter = false;

        function formatAmountIndian(amount) {
            if (isNaN(amount)) return '₹0.00';
            let [int, dec] = amount.toFixed(2).split(".");
            let last3 = int.slice(-3), other = int.slice(0, -3);
            if (other) last3 = ',' + last3;
            return '₹' + other.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + last3 + '.' + dec;
        }


        // 📊 Initialize DataTable
        const expenseTable = $('#expenceAllLIST').DataTable({
            dom: "<'row mb-2'<'col-md-6'B><'col-md-6 text-end'f>>" +
                "<'row'<'col-12'tr>>" +
                "<'row mt-2'<'col-md-5'i><'col-md-7 text-end'p>>",
            ordering: false,

            buttons: [
                {
                    extend: 'csvHtml5',
                    text: '<img src="/Content/img/icons8-csv-64.png" alt="CSV" style="height:32px;" title="Export CSV" />',
                    className: 'export-buttons icon-only-btn',
                    filename: 'Green Valley Society-Expence Report' + moment().format("DD-MM-YYYY"),
                    exportOptions: {
                        columns: ':visible:not(:first-child)' // skip checkbox column
                    },
                    customize: function (csv) {
                        const headerTitle = 'Green Valley Society-Expence Report';
                        const downloadedOn = 'Generated on: ' + moment().format('DD-MM-YYYY hh:mm A');

                        const csvRows = csv.split('\n');

                        // 🧠 Step 1: Extract headers
                        const originalHeader = csvRows[0].split(',');
                        originalHeader[0] = '"Sr No"'; // Forcefully set first column as Sr No
                        csvRows[0] = originalHeader.join(',');

                        // 🧠 Step 2: Update Sr No for each data row
                        for (let i = 1; i < csvRows.length; i++) {
                            if (csvRows[i].trim() !== '') {
                                const rowCols = csvRows[i].split(',');
                                rowCols[0] = `"${i}"`; // Sr No starts from 1
                                csvRows[i] = rowCols.join(',');
                            }
                        }

                        // 🧠 Step 3: Add custom header info
                        csvRows.unshift(downloadedOn);   // Line 1
                        csvRows.unshift(headerTitle);    // Line 0

                        return csvRows.join('\n');
                    },
                    action: function (e, dt, button, config) {
                        const selectedRows = dt.rows({ filter: 'applied' }).nodes().to$().filter(function () {
                            return $(this).find('input.row-checkbox:checked').length > 0;
                        });

                        const isHeaderOnlyChecked = $('thead input.row-checkbox:checked').length > 0 && selectedRows.length === 0;
                        if (isHeaderOnlyChecked || selectedRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export CSV.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        const validRows = selectedRows.filter(function () {
                            const name = $(this).find('td:nth-child(3)').text().trim();
                            return name !== '';
                        });

                        if (validRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one valid row to export CSV.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        config.exportOptions.rows = function (idx, data, node) {
                            return $(node).find('input.row-checkbox').is(':checked');
                        };

                        $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);

                        setTimeout(function () {
                            swal({
                                icon: 'success',
                                title: 'CSV Exported',
                                text: 'Your CSV file has been downloaded successfully!',
                                timer: 2000,
                                buttons: false
                            });
                        }, 500);
                        setTimeout(function () {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-expence-all').prop('checked', false);
                        }, 100);
                    }
                },
                {
                    extend: 'excelHtml5',
                    text: '<img src="/Content/img/icons8-xls-64.png" style="height:32px;" title="Export Excel" />',
                    className: 'export-buttons icon-only-btn',
                    title: null,
                    filename: 'Green Valley Society-Expence Report' + moment().format("DD-MM-YYYY"),
                    exportOptions: {
                        rows: function (idx, data, node) {
                            return $('input.row-checkbox', node).is(':checked');
                        },
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    },
                    customize: function (xlsx) {
                        const sheet = xlsx.xl.worksheets['sheet1.xml'];
                        const styles = xlsx.xl['styles.xml'];
                        const $ = window.jQuery;

                        const title = 'Green Valley Society Expence Report';
                        const timestamp = 'Generated on: ' + moment().format('DD-MM-YYYY hh:mm A');

                        const sheetData = $('sheetData', sheet);
                        const rows = sheetData.find('row');

                        // Shift existing rows down by 2
                        rows.each(function () {
                            const r = parseInt($(this).attr('r')) + 2;
                            $(this).attr('r', r);
                            $(this).find('c').each(function () {
                                const cellRef = $(this).attr('r');
                                const col = cellRef.replace(/[0-9]/g, '');
                                $(this).attr('r', col + r);
                            });
                        });

                        // Insert custom header rows
                        const titleRow = `
<row r="1">
    <c t="inlineStr" r="D1" s="2">
        <is><t>${title}</t></is>
    </c>
</row>`;
                        const dateRow = `
<row r="2">
    <c t="inlineStr" r="D2" s="2">
        <is><t>${timestamp}</t></is>
    </c>
</row>`;

                        sheetData.prepend(dateRow);
                        sheetData.prepend(titleRow);

                        // Add center style in styles.xml
                        const cellXfs = $('cellXfs', styles);
                        const centerStyleIndex = cellXfs.children().length;
                        cellXfs.append(`
<xf xfId="0" applyAlignment="1">
    <alignment horizontal="center" vertical="center"/>
</xf>`);

                        // Apply center style to all cells
                        $('sheetData row c', sheet).attr('s', centerStyleIndex);

                        // Fix Sr.No column (A)
                        let srNo = 1;
                        $('row', sheet).each(function () {
                            const rowIndex = parseInt($(this).attr('r'));
                            if (rowIndex >= 4) {
                                const firstCell = $('c[r^="A"]', this);
                                if (firstCell.length) {
                                    firstCell.attr('t', 'n');
                                    firstCell.find('v').text(srNo++);
                                }
                            }
                        });
                    },
                    action: function (e, dt, button, config) {
                        const selected = dt.rows().nodes().to$().find('.row-checkbox:checked');

                        // ✅ Condition 1: No checkbox selected
                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export Excel.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // ✅ Condition 2: Header selected but no data rows
                        const dataRows = dt.rows({ search: 'applied' }).nodes().to$().filter(function () {
                            return $(this).find('.row-checkbox').length > 0;
                        });

                        if (dataRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export Excel.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // ✅ All good – allow export
                        $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);

                        swal({
                            icon: 'success',
                            title: 'Excel Exported',
                            text: 'Your Excel file has been downloaded successfully!',
                            timer: 2000,
                            buttons: false

                        });
                        setTimeout(function () {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-expence-all').prop('checked', false);
                        }, 100);
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<img src="/Content/img/icons8-pdf-64.png" alt="PDF" style="height:32px;" title="Export PDF" />',
                    className: 'export-buttons icon-only-btn',
                    orientation: 'landscape',
                    filename: 'Green Valley Society-Expence Report ' + moment().format("DD-MM-YYYY"),
                    pageSize: 'A4',
                    title: '',
                    messageTop: '',
                    exportOptions: {
                        rows: function (idx, data, node) {
                            return $('input.row-checkbox', node).is(':checked');
                        },
                        columns: ':visible:not(:first-child)',
                        format: {
                            body: function (data, row, col, node) {
                                if (col === 0) return (row + 1).toString(); // Sr.No

                                let text = $(node).attr('data-export') || $(node).text().trim();

                                // 🔴 Optional: Limit description length
                                if (col === 5 && text.length > 50) {
                                    text = text.substring(0, 50) + '...';
                                }

                                return text;
                            }
                        }


                    },
                    customize: function (doc) {
                        const now = moment().format("DD-MM-YYYY hh:mm A");
                        doc.content.unshift({
                            alignment: 'center',
                            margin: [0, 0, 0, 12],
                            text: [
                                { text: 'Green Valley Society - Expence Report\n', fontSize: 18, bold: true },
                                { text: 'Generated on: ' + now + '\n\n', fontSize: 12, italics: true }
                            ]
                        });

                        const tableContent = doc.content.find(obj => obj.table);
                        if (tableContent) {
                            const colCount = tableContent.table.body[0].length;
                            tableContent.table.widths = (colCount === 7)
                                ? [20, 80, 100, 170, 100, 150, 70]
                                : Array(colCount).fill('auto');

                            tableContent.alignment = 'center';
                            tableContent.table.body.forEach((row, rowIndex) => {
                                row.forEach((cell, colIndex) => {
                                    if (typeof cell === 'object') {
                                        cell.alignment = 'center';
                                    } else {
                                        row[colIndex] = { text: cell, alignment: 'center' };
                                    }
                                });
                            });

                            tableContent.layout = {
                                hLineWidth: () => 0.5,
                                vLineWidth: () => 0.5,
                                hLineColor: () => '#aaa',
                                vLineColor: () => '#aaa',
                                paddingLeft: () => 4,
                                paddingRight: () => 4,
                                paddingTop: () => 2,       // less padding → less height
                                paddingBottom: () => 2     // less padding → less height
                            };
                        }

                        doc.defaultStyle.fontSize = 10;
                        doc.styles.tableHeader.fontSize = 11;
                        doc.styles.tableHeader.bold = true;
                        doc.styles.tableHeader.alignment = 'center';
                        doc.styles.tableHeader.fillColor = '#615677 ';
                        doc.styles.tableHeader.color = '#ffffff';
                    },
                    action: function (e, dt, button, config) {
                        const selected = dt.rows().nodes().to$().find('.row-checkbox:checked');

                        // ✅ Condition 1: No checkbox selected
                        if (selected.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export PDF.',
                                position: 'topCenter'
                            });
                            return;
                        }

                        // ✅ Condition 2: Only header selected, no data rows
                        const dataRows = dt.rows({ search: 'applied' }).nodes().to$().filter(function () {
                            return $(this).find('.row-checkbox').length > 0;
                        });

                        if (dataRows.length === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export PDF.',
                                position: 'topCenter'

                            });
                            return;
                        }

                        // ✅ All good – allow export
                        $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);

                        swal({
                            icon: 'success',
                            title: 'PDF Exported',
                            text: 'Your PDF file has been downloaded successfully!',
                            timer: 2000,
                            buttons: false

                        });
                        setTimeout(function () {
                            dt.rows().nodes().to$().find('.row-checkbox').prop('checked', false);
                            $('#select-expence-all').prop('checked', false);
                        }, 100);
                    }
                },
                {
                    extend: 'print',
                    className: 'export-buttons icon-only-btn',
                    title: '',
                    text: '<img src="/Content/img/icons8-print-100.png" alt="Print" style="height:32px;" title="Print" />',
                    titleAttr: 'Print',
                    exportOptions: {
                        columns: ':visible:not(:first-child)',
                        modifier: { search: 'applied', order: 'applied', page: 'all' },
                        rows: function (idx, data, node) {
                            return $(node).find('input.row-checkbox').prop('checked');
                        },
                        format: {
                            body: function (data, row, column, node) {
                                if (column === 0) return (row + 1).toString();
                                return data;
                            }
                        }
                    },
                    customize: function (win) {
                        var now = new Date().toLocaleString('en-GB', {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: true
                        });
                        $(win.document.body)
                            .css('font-size', '10pt')
                            .prepend(
                                '<div style="text-align:center; margin:0 0 10px 0;">' +
                                '<h2>Green Valley Society : Expense List</h2>' +
                                '<p>Generated on: ' + now + '</p>' +
                                '</div>'
                            );

                        // table formatting
                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css({
                                fontSize: 'inherit',
                                textAlign: 'center',
                                margin: '0 auto',
                                borderCollapse: 'collapse',
                                width: 'auto' // ✅ content नुसार width
                            });

                        // cells formatting
                        $(win.document.body).find('th, td')
                            .css({
                                border: '1px solid black',
                                padding: '5px',
                                whiteSpace: 'nowrap' // ✅ content एका ओळीत
                            });

                        $(win.document.body).find('th').css('text-align', 'center');

                        // style add करतो
                        const style = document.createElement('style');
                        style.type = 'text/css';
                        style.innerHTML = `
  @@page { margin: 20px; }
  @@media print {
    html, body { margin: 0 !important; padding: 20px !important; }
    .dt-print-view { overflow: visible !important; position: static !important; }
    table { border-collapse: collapse; width: auto !important; }
    th, td { white-space: nowrap; }

    /* 👉 specific column fix करायचा असल्यास */
    /* Paid Date हा 7th column असेल तर */
    table.dataTable.print-table th:nth-child(7),
    table.dataTable.print-table td:nth-child(7) {
      width: 120px !important;
      max-width: 120px !important;
    }
  }
`;
                        $(win.document.head).append(style);

                        $(win.document.body).find('table').addClass('print-table');
                    },
                    action: function (e, dt, button, config) {
                        var selected = dt.rows(function (idx, data, node) {
                            return $(node).find('input.row-checkbox').prop('checked');
                        }, { search: 'applied', page: 'all' }).count();

                        if (selected === 0) {
                            iziToast.warning({
                                title: 'Warning',
                                message: 'Please select at least one row to export.',
                                position: 'topCenter'
                            });
                            return;
                        }
                        $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);
                    }
                },
                {
                    text: '<img id="refreshIcon" src="/Content/img/icons8-refresh-50.png" alt="Refresh" style="height:28px;" title="Refresh Table" />',
                    className: 'export-buttons icon-only-btn',
                    action: function (e, dt, node, config) {
                        $('#refreshIcon').addClass('rotate-refresh');

                        setTimeout(function () {
                            // Clear all filters and search
                            dt.search('').columns().search('');
                            $('#statusFilter').val('');

                            // Clear all checkboxes on ALL pages
                            dt.$('.row-checkbox').prop('checked', false);
                            $('#select-expence-all').prop('checked', false);

                            // ✅ Clear Set of selected rows also
                            selectedRows.clear();

                            $('#statusFilter').val('');
                            applyStatusColumnVisibility('');

                            enableDateFilter = false;
                            $('#fromDate1').val('');
                            $('#toDate1').val('');
                            $('.daterange-btn').find('span').html('Choose Date');

                            // ✅ Redraw table
                            dt.page('first').draw(false);

                            $('#refreshIcon').removeClass('rotate-refresh');
                        }, 500);
                    }
                }

            ],

            columnDefs: [
                { targets: 0, orderable: false }
            ],
            order: [[1, 'asc']],
            pageLength: 10,
            autoWidth: false,
            responsive: false,
            scrollX: false,

            language: {
                search: "Search : _INPUT_",
                searchPlaceholder: "",
                infoFiltered: ""
            },
            // 🔽 ADD THIS NEW CALLBACK
            footerCallback: function (row, data, start, end, display) {
                var api = this.api();

                // Helper to parse currency values (₹1,234.56 → 1234.56)
                var parseCurrency = function (value) {
                    return typeof value === 'string'
                        ? parseFloat(value.replace(/[^\d.-]/g, ''))
                        : typeof value === 'number'
                            ? value
                            : 0;
                };
                // Calculate Total Amount (col 7)
                var totalAmount = api
                    .column(7, { filter: 'applied' })
                    .data()
                    .reduce(function (sum, val) {
                        return sum + parseCurrency(val);
                    }, 0);

                // Calculate Paid Amount (col 8)
                var paidAmount = api
                    .column(8, { filter: 'applied' })
                    .data()
                    .reduce(function (sum, val) {
                        return sum + parseCurrency(val);
                    }, 0);

                // Calculate Remaining Amount (col 9)
                var remainingAmount = api
                    .column(9, { filter: 'applied' })
                    .data()
                    .reduce(function (sum, val) {
                        return sum + parseCurrency(val);
                    }, 0);

                // Calculate GST Total (col 10)
                var gstTotal = api
                    .column(14, { filter: 'applied' })
                    .data()
                    .reduce(function (sum, val) {
                        return sum + parseCurrency(val);
                    }, 0);
                // Update footer cells (correct indexes)
                $(api.column(7).footer()).html(
                    '₹' + totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                );

                $(api.column(8).footer()).html(
                    '₹' + paidAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                );

                $(api.column(9).footer()).html(
                    '₹' + remainingAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                );

                $(api.column(14).footer()).html(
                    '₹' + gstTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                );

            },
            drawCallback: function (settings) {
                var api = this.api();
                var pageInfo = api.page.info(); // Get current page info
                var startIndex = pageInfo.start; // Starting index of current page

                // ✅ Update Sr.No based on pagination
                api.column(1, { page: 'current' }).nodes().each(function (cell, i) {
                    cell.innerHTML = startIndex + i + 1; // Global index
                });

                // ✅ Uncheck checkboxes on current page
                api.rows({ page: 'current' }).nodes().each(function (row) {
                    $(row).find('.row-checkbox').prop('checked', false);
                });

                // ✅ Uncheck "select all"
                $('#select-expence-all').prop('checked', false);
            },
            initComplete: function () {
                $('#expense-loading').hide();
                $('#expense-table-container').show();
            },
        });






        // Column Index Map (easier to manage later)
        const COL = { PAID: 8, REM: 9, STATUS: 10, PAID_DATE: 11 };

        function applyStatusColumnVisibility(status) {
            if (status === 'Paid') {
                // Paid ⇒ Remaining लपव
                expenseTable.column(COL.REM).visible(false, false);
                expenseTable.column(COL.PAID).visible(true, false);
                expenseTable.column(COL.PAID_DATE).visible(true, false);
            } else if (status === 'Unpaid') {
                // Unpaid ⇒ Paid Amount + Paid Date लपव
                expenseTable.column(COL.PAID).visible(false, false);
                expenseTable.column(COL.PAID_DATE).visible(false, false);
                expenseTable.column(COL.REM).visible(true, false);
            } else {
                // All ⇒ सगळे दिसू दे
                expenseTable.columns([COL.PAID, COL.REM, COL.PAID_DATE]).visible(true, false);
            }
            expenseTable.columns.adjust().draw(false);
        }

        applyStatusColumnVisibility($('#statusFilter').val() || '');

        // 🔍 Date filter logic
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            let dateStr = data[6]; // Expense Date
            let selectedStatus = $('#statusFilter').val(); // Payment Status

            // Date Filter
            if (enableDateFilter && dateStr) {
                let min = $('#fromDate1').val();
                let max = $('#toDate1').val();
                let colDate = moment(dateStr, format);
                if (!colDate.isValid()) return false;
                if (min && colDate.isBefore(moment(min, format))) return false;
                if (max && colDate.isAfter(moment(max, format))) return false;
            }

            // Status Filter
            if (selectedStatus) {
                let statusCell = expenseTable.cell(dataIndex, 10).node(); // column 10 = Status
                let statusText = $(statusCell).text().trim();
                if (statusText !== selectedStatus) return false;
            }

            return true;
        });

        // Trigger redraw on status change
        $('#statusFilter').on('change', function () {
            const val = this.value || '';
            applyStatusColumnVisibility(val);
            expenseTable.draw();
        });




        initializeDateRangePicker();
        function initializeDateRangePicker() {
            $('.daterange-btn').daterangepicker({
                locale: { format: format },
                autoUpdateInput: false,
                opens: "right",
                drops: "down",
                showDropdowns: false,
                linkedCalendars: false,
                ranges: {
                    'Today': [moment(), moment()],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'),
                    moment().subtract(1, 'month').endOf('month')]
                }
            }, function (start, end) {
                enableDateFilter = true;

                // ✅ manually set input values
                $('#fromDate1').val(start.format(format));
                $('#toDate1').val(end.format(format));

                $('.daterange-btn span').html(
                    start.format(format) + ' - ' + end.format(format)
                );

                expenseTable.draw();
            });

            $('.daterange-btn span').html('Choose Date');
        }
        // Select All Checkbox


        // Handle row checkbox
        $('#expenceAllLIST').on('change', '.row-checkbox', function () {
            const rowId = expenseTable.row($(this).closest('tr')).index();
            if (this.checked) {
                selectedRows.add(rowId);
            } else {
                selectedRows.delete(rowId);
            }
        });

        // Handle header select-all
        $('#select-expence-all').on('change', function () {
            const rows = expenseTable.rows({ search: 'applied' }).nodes();
            $('input.row-checkbox', rows).prop('checked', this.checked);
            rows.each(function (row) {
                const rowId = expenseTable.row(row).index();
                if ($('#select-expence-all').prop('checked')) {
                    selectedRows.add(rowId);
                } else {
                    selectedRows.delete(rowId);
                }
            });
        });

        // On draw → restore checkbox states
        expenseTable.on('draw', function () {
            expenseTable.rows({ page: 'current' }).every(function (rowIdx) {
                $(this.node()).find('.row-checkbox').prop('checked', selectedRows.has(rowIdx));
            });

            // Update header checkbox state
            const allOnPageChecked =
                expenseTable.rows({ page: 'current' }).nodes()
                    .to$().find('.row-checkbox:checked').length === expenseTable.rows({ page: 'current' }).count();
            $('#select-expence-all').prop('checked', allOnPageChecked);
        });

    });
</script>