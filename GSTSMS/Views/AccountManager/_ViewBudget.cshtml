@model GSTSMSLibrary.AccountManager.AccountManager

<style>
    /* Modal scrollbar styling - Applied only to modal body */
    .modal-body {
        max-height: calc(85vh - 45px); /* Subtract header height */
        overflow-y: auto;
        padding: 15px 22px;
        font-size: 16px;
    }

    /* Budget breakup specific styles */
    .sec-divider {
        border: none;
        border-top: 2px dotted #615677;
        margin: 10px 0 15px 0;
    }

    .title {
        font-size: 18px;
        color: black !important;
        font-weight: bold;
        margin-bottom: 12px;
    }

    /* Budget table styling */
    .budget-table {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
        table-layout: fixed;
    }

        .budget-table th {
            background-color: #F8F9FA !important;
            color: white !important;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 8px;
            text-align: center;
            vertical-align: middle;
            border: 1px solid #dee2e6;
        }

        .budget-table td {
            padding: 10px 8px;
            border: 1px solid #dee2e6;
            text-align: center;
            vertical-align: middle;
            font-size: 14px;
            word-wrap: break-word;
            color: black;
        }

        .budget-table tbody tr:nth-of-type(odd) {
            background-color: #f8f9fa;
        }

        .budget-table tbody tr:hover {
            background-color: #e9ecef;
        }

    /* Fixed column widths for better alignment */
    .col-srno {
        width: 8%;
        text-align: center;
    }

    .col-category {
        width: 27%;
        text-align: left;
        padding-left: 15px !important;
    }

    .col-allocated {
        width: 20%;
        text-align: right;
        padding-right: 15px !important;
    }

    .col-actual {
        width: 20%;
        text-align: right;
        padding-right: 15px !important;
    }

    .col-documents {
        width: 25%;
        text-align: center;
    }

    /* Expandable Section Styling */
    .expandable-section {
        cursor: pointer;
        transition: all 0.3s ease;
        background-color: #e7f2ff;
        border-radius: 6px;
        margin: 15px 0;
        padding: 12px 15px;
        border: 1px solid #b8d4ff;
        text-align: center;
    }

        .expandable-section:hover {
            background-color: #d6e7ff;
            border-color: #9cc2ff;
        }

        .expandable-section i {
            transition: all 0.3s ease;
            margin-right: 8px;
            font-size: 14px;
            color: #1976d2;
        }

        .expandable-section.expanded i {
            color: #0d5cb6;
            transform: rotate(45deg);
        }

        .expandable-section .fw-semibold {
            font-weight: 600;
            color: #1565c0 !important;
        }

        .expandable-section .text-muted {
            color: #5d9cec !important;
            font-size: 13px;
        }

    .hidden-details {
        display: none;
        margin-top: 10px;
    }

    .expanded + .hidden-details {
        display: block;
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .no-document {
        color: #6c757d;
        font-style: italic;
        font-size: 13px;
    }

    .text-success-custom {
        color: #000 !important;
        font-weight: bold;
        text-align: right;
    }

    .budget-summary {
        background-color: #f8f9fa;
        border-radius: 6px;
        padding: 12px 15px;
        margin-top: 15px;
        border: 1px solid #dee2e6;
        text-align: center;
        font-weight: 600;
    }

    /* Scrollbar styling for modal body */
    .modal-body::-webkit-scrollbar {
        width: 8px;
    }

    .modal-body::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .modal-body::-webkit-scrollbar-thumb {
        background: #8B8B8B;
        border-radius: 4px;
    }

        .modal-body::-webkit-scrollbar-thumb:hover {
            background: #636363;
        }

    /* Scrollbar styling for budget section */
    .scrollable-budget::-webkit-scrollbar {
        width: 8px;
    }

    .scrollable-budget::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .scrollable-budget::-webkit-scrollbar-thumb {
        background: #615677;
        border-radius: 4px;
    }

        .scrollable-budget::-webkit-scrollbar-thumb:hover {
            background: #4a4063;
        }

    @@media (max-width: 768px) {
        .col-srno {
            width: 10%;
        }

        .col-category {
            width: 25%;
            padding-left: 8px !important;
        }

        .col-allocated,
        .col-actual {
            width: 18%;
            padding-right: 8px !important;
        }

        .col-documents {
            width: 20%;
        }

        .budget-table th,
        .budget-table td {
            padding: 8px 4px;
            font-size: 12px;
        }

        .modal-body {
            max-height: calc(80vh - 45px);
        }
    }

    .modal-dialog {
        max-width: 900px;
        width: 100%;
        border-radius: 4px;
        overflow: hidden;
    }

    .modal-content {
        /* Remove overflow from modal-content */
        overflow: hidden;
    }

    .modal-header {
        background-color: #615677;
        color: #fff;
        padding: 0 20px;
        height: 45px !important;
        position: relative;
        border-radius: 4px 4px 0 0 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0; /* Prevent header from shrinking */
    }

    .modal-title {
        font-size: 18px;
        font-weight: bold;
        margin: 0;
    }

    .modal-close-top-btn {
        position: absolute;
        right: 10px;
        background-color: #dc3545;
        border: none;
        color: white;
        font-size: 12px;
        padding: 4px 10px;
        cursor: pointer;
        border-radius: 4px;
    }

    .section-title {
        font-size: 18px;
        font-weight: bold;
        color: #000000;
        margin: 10px 0 12px 0;
        border-bottom: 1px dashed #bbb;
    }

    .info-pair-row {
        display: flex;
        flex-wrap: wrap;
        margin-bottom: 5px;
    }

    .info-group {
        flex: 1 1 50%;
        display: flex;
        min-width: 300px;
        margin-bottom: 6px;
        align-items: center;
    }

    .info-label {
        width: 140px;
        font-weight: bold;
        color: #333;
        flex-shrink: 0;
        padding-right: 5px;
    }

    .info-value {
        flex: 1;
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        font-weight: normal;
        word-break: break-word;
    }

    .colon {
        color: #333;
    }

    .document-actions {
        margin-top: 15px;
        text-align: center;
    }

        .document-actions .btn {
            margin: 0 8px;
            font-size: 14px;
            padding: 6px 12px;
            border-radius: 4px;
        }

    .no-document {
        color: #999;
        font-style: italic;
    }

    .attachment-row {
        margin-top: 10px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        table-layout: fixed;
    }

        .table th, .table td {
            border: 1px solid #dee2e6;
            padding: 8px;
            word-wrap: break-word;
        }

        .table th {
            background-color: #615677;
            color: white;
            text-align: left;
            font-weight: bold;
        }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(0, 0, 0, 0.05);
    }

    .table-bordered {
        border: 1px solid #dee2e6;
    }

    /* Expandable section styles */
    .expandable-section {
        cursor: pointer;
        transition: all 0.3s;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 10px;
        margin-top: 10px;
        border-radius: 4px;
    }

        .expandable-section:hover {
            background-color: #e9ecef;
        }

    .expand-icon {
        transition: transform 0.3s;
        margin-right: 8px;
    }

    .expanded .expand-icon {
        transform: rotate(45deg);
    }

    .hidden-details {
        display: none;
        margin-top: 10px;
        padding: 0;
        border: none;
        background-color: transparent;
    }

    .expanded + .hidden-details {
        display: block;
        animation: slideDown 0.3s ease-out;
    }

    /* Ensure both tables have same column widths */
    .scrollable-budget .budget-table,
    .hidden-details .budget-table {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
        table-layout: fixed;
    }

        .scrollable-budget .budget-table th,
        .hidden-details .budget-table th,
        .scrollable-budget .budget-table td,
        .hidden-details .budget-table td {
            padding: 4px 8px;
            border: 1px solid #dee2e6;
            text-align: center;
            vertical-align: middle;
            font-size: 14px;
            word-wrap: break-word;
        }

        .scrollable-budget .budget-table th,
        .hidden-details .budget-table th {
            background-color: #F8F9FA !important;
            color: black !important;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 8px;
        }

        .scrollable-budget .budget-table tbody tr:nth-of-type(odd),
        .hidden-details .budget-table tbody tr:nth-of-type(odd) {
            background-color: #f8f9fa;
        }

        .scrollable-budget .budget-table tbody tr:hover,
        .hidden-details .budget-table tbody tr:hover {
            background-color: #e9ecef;
        }

    /* Fixed column widths for perfect alignment */
    .scrollable-budget .col-srno,
    .hidden-details .col-srno {
        width: 8%;
        text-align: center;
    }

    .scrollable-budget .col-category,
    .hidden-details .col-category {
        width: 27%;
        text-align: left;
        padding-left: 15px !important;
    }

    .scrollable-budget .col-allocated,
    .hidden-details .col-allocated {
        width: 20%;
        text-align: right;
        padding-right: 15px !important;
    }

    .scrollable-budget .col-actual,
    .hidden-details .col-actual {
        width: 20%;
        text-align: right;
        padding-right: 15px !important;
    }

    .scrollable-budget .col-documents,
    .hidden-details .col-documents {
        width: 25%;
        text-align: center;
    }

    /* Updated expandable section with better styling */
    .expandable-section {
        cursor: pointer;
        transition: all 0.3s ease;
        background-color: #e7f2ff;
        border-radius: 6px;
        margin: 15px 0;
        padding: 12px 15px;
        border: 1px solid #b8d4ff;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .expandable-section:hover {
            background-color: #d6e7ff;
            border-color: #9cc2ff;
        }

        .expandable-section i {
            transition: all 0.3s ease;
            font-size: 14px;
            color: #1976d2;
            min-width: 16px;
        }

        .expandable-section.expanded i {
            color: #0d5cb6;
        }

        .expandable-section .expand-text {
            font-weight: 600;
            color: #1565c0 !important;
        }

        .expandable-section .text-muted {
            color: #5d9cec !important;
            font-size: 13px;
        }

        .expandable-section.expanded .expand-text::before {
            content: "View Less ";
        }

        .expandable-section:not(.expanded) .expand-text::before {
            content: "View More ";
        }

        .expandable-section.expanded i::before {
            content: "−"; /* Minus symbol */
        }

        .expandable-section:not(.expanded) i::before {
            content: "+";
        }

    .budget-item {
        padding: 8px 12px;
        border-bottom: 1px solid #eee;
    }

    @@media (max-width: 992px) {
        .modal-dialog {
            max-width: 95%;
            margin: 10px auto;
        }

        .info-group {
            min-width: 100%;
        }

        .col-srno, .col-category, .col-allocated, .col-actual, .col-documents {
            width: auto;
        }

        .table {
            font-size: 14px;
        }
    }

    .budget-transition {
        transition: all 0.3s ease-out;
        overflow: hidden;
    }
</style>

<div class="modal-header">
    <h4 class="modal-title">Event Details</h4>
    <button type="button" class="modal-close-top-btn" onclick="closeViewModal()" style="border:none;outline:none;box-shadow:none;">
        <i class="fa fa-times"></i>
    </button>
</div>

<div class="modal-body">
    <div class="section-title">Event Information</div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Event Name</div>
            <div class="info-value"><span class="colon">:</span> @Model.EventName</div>
        </div>
        <div class="info-group">
            <div class="info-label">Bank Account</div>
            <div class="info-value"><span class="colon">:</span> @Model.BankAccount</div>
        </div>
    </div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Event Handler</div>
            <div class="info-value"><span class="colon">:</span> @Model.EventHandlerName</div>
        </div>
        <div class="info-group">
            <div class="info-label">IFSC Code</div>
            <div class="info-value"><span class="colon">:</span> @Model.IFSCCode</div>
        </div>
    </div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Handler Bank Name</div>
            <div class="info-value" id="eventHandlerBankName"><span class="colon">:</span> </div>
        </div>


        <div class="info-group">
            <div class="info-label">Phone No.</div>
            <div class="info-value"><span class="colon">:</span> @Model.PhoneNumber</div>
        </div>
    </div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Email</div>
            <div class="info-value"><span class="colon">:</span> @Model.Email</div>
        </div>
        <div class="info-group">
            <div class="info-label">Allocated Budget</div>
            <div class="info-value"><span class="colon">:</span> ₹ @Model.AllocatedBudget.ToString("N2")</div>
        </div>
    </div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Added Date</div>
            <div class="info-value"><span class="colon">:</span> @Model.BudgetAddedDate.ToString("dd-MM-yyyy")</div>
        </div>
        <div class="info-group"><!-- spacing --></div>
    </div>

    <div class="section-title">Transaction Information</div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Actual Cost</div>
            <div class="info-value"><span class="colon">:</span> ₹ @Model.ActualCost.ToString("N2")</div>
        </div>
        <div class="info-group">
            <div class="info-label">Paid Date & Time</div>
            <div class="info-value"><span class="colon">:</span> @(Model.PaidDate?.ToString("dd-MM-yyyy hh:mm tt") ?? "-")</div>
        </div>
    </div>

    <div class="info-pair-row">
        <div class="info-group">
            <div class="info-label">Payment Mode</div>
            <div class="info-value"><span class="colon">:</span> @Model.PaymentMode</div>
        </div>
        @if (Model.PaymentMode != "Cash")
        {
            <div class="info-group">
                <div class="info-label">Transaction ID</div>
                <div class="info-value"><span class="colon">:</span> @Model.TransactionId_ChequeId</div>
            </div>
        }
    </div>

    @if (Model.PaymentMode != "Cash")
    {
        <div class="info-pair-row">
            <div class="info-group">
                <div class="info-label">Debited Account No</div>
                <div class="info-value">
                    <span class="colon">:</span>
                    @if (!string.IsNullOrEmpty(Model.DebitedAccountNo))
                    {
                        var accountNo = Model.DebitedAccountNo;
                        var visibleDigits = Math.Min(4, accountNo.Length);
                        var maskedAccount = new string('*', accountNo.Length - visibleDigits) + accountNo.Substring(accountNo.Length - visibleDigits);
                        @maskedAccount
                    }
                    else
                    {
                        @:-
                    }
                </div>
            </div>
            <div class="info-group">
                <div class="info-label">Debited IFSC</div>
                <div class="info-value"><span class="colon">:</span> @Model.BankName</div>
            </div>
        </div>

        <div class="info-pair-row">
            <div class="info-group">
                <div class="info-label">Debited Bank</div>
                <div class="info-value" id="debitedBankName"><span class="colon">:</span> </div>
            </div>
            <div class="info-group"><!-- spacing --></div>
        </div>
    }

    <div class="section-title">Budget Distribution</div>

    @if (Model.BudgetBreakups != null && Model.BudgetBreakups.Count > 0)
    {
        <div class="mb-2 d-flex align-items-center">
            <button class="btn btn-outline-primary btn-sm mr-3" type="button" id="toggleBudgetBtn">
                <i class="fa fa-eye me-1"></i> View Budget Details
            </button>
        </div>

        <div class="budget-transition" id="budgetTableContainer" style="display: none;">
            <div class="scrollable-budget">
                <table class="budget-table">
                    <thead>
                        <tr>
                            <th class="col-srno">Sr.No</th>
                            <th class="col-category">Category</th>
                            <th class="col-allocated">Allocated Budget (₹)</th>
                            <th class="col-actual">Actual Cost (₹)</th>
                            <th class="col-documents">Documents</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 1;
                            foreach (var budget in Model.BudgetBreakups)
                            {
                                                <tr>
                                                    <td class="col-srno">@counter</td>
                                                    <td class="col-category" title="@budget.DistributionCategory">@budget.DistributionCategory</td>
                                                    <td class="col-allocated">₹@budget.AllocatedBudget.ToString("N2")</td>                                                    <td class="col-actual">₹@budget.ActualBudget.ToString("N2")</td>
                                                    <td class="col-documents">
                                                        @if (!string.IsNullOrEmpty(budget.DocumentName))
                                                        {
                                                            var cleanPath = budget.DocumentName.Replace("~/", "/");
                                                            var fileName = System.IO.Path.GetFileName(budget.DocumentName);
                                                            <a href="@cleanPath" target="_blank" title="View @fileName" class="document-link">
                                                                <i class="fa fa-file-alt"></i>
                                                                <span class="document-name">@fileName</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="no-document">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                counter++;
                            }
                        }
                    </tbody>
                    <tfoot style="background-color: #f8f9fa; font-weight: bold;">
                        <tr>
                            <td class="col-srno"></td>
                            <td class="col-category"></td>
                            <td class="col-allocated">Total ₹@(GetTotalAllocatedBudget().ToString("N2"))</td>
                            <td class="col-actual">Total ₹@(GetTotalActualBudget().ToString("N2"))</td>
                            <td class="col-documents">-</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="info-pair-row">
            <div class="info-group">
                <div class="info-label">Budget Breakup</div>
                <div class="info-value">
                    <span class="colon">:</span>
                    <span class="no-document">No budget breakup details available</span>
                </div>
            </div>
        </div>
    }

    <script>
        // Toggle budget table visibility
        document.getElementById('toggleBudgetBtn').addEventListener('click', function() {
            const budgetContainer = document.getElementById('budgetTableContainer');
            const isVisible = budgetContainer.style.display === 'block';

            if (isVisible) {
                budgetContainer.style.display = 'none';
                this.innerHTML = '<i class="fa fa-eye me-1"></i> View Budget Details';
            } else {
                budgetContainer.style.display = 'block';
                this.innerHTML = '<i class="fa fa-eye-slash me-1"></i> Hide Budget Details';
            }
        });

        function closeViewModal() {
            $('#viewModal').modal('hide');
        }

        function getBankName(ifscCode, elementId) {
            if (ifscCode) {
                $.ajax({
                    url: `https://ifsc.razorpay.com/${ifscCode}`,
                    type: 'GET',
                    success: function (data) {
                        if (data && data.BANK) {
                            $(elementId).text(data.BANK);
                        } else {
                            $(elementId).text('Bank details not available');
                        }
                    },
                    error: function () {
                        $(elementId).text('Error fetching bank details');
                    }
                });
            }
        }

        $(document).ready(function () {
            const handlerIfscCode = '@Model.IFSCCode';
            const debitedIfscCode = '@Model.BankName';

            getBankName(handlerIfscCode, '#eventHandlerBankName');

            // Only fetch debited bank details if payment mode is not Cash
            @if (Model.PaymentMode != "Cash")
            {
                <text>getBankName(debitedIfscCode, '#debitedBankName');</text>
            }
            else
            {
                <text>$('#debitedBankName').text('Not applicable for cash payment');</text>
            }
        });
    </script>
</div>

@functions {
    // Helper methods to calculate totals with decimal values
    private decimal GetTotalAllocatedBudget()
    {
        if (Model.BudgetBreakups == null || !Model.BudgetBreakups.Any())
            return 0;

        return Model.BudgetBreakups.Sum(b => b.AllocatedBudget);
    }

    private decimal GetTotalActualBudget()
    {
        if (Model.BudgetBreakups == null || !Model.BudgetBreakups.Any())
            return 0;

        return Model.BudgetBreakups
     .Sum(b => b.ActualBudget);

    }
}