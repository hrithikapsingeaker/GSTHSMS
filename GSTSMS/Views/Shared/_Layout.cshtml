<body>
    @{
        var profilePic = Session["ProfilePhoto"] != null
    && !string.IsNullOrEmpty(Session["ProfilePhoto"].ToString())
    ? Url.Content(Session["ProfilePhoto"].ToString())
    : Url.Content("~/Content/img/avatar/avatar-3.png");

